{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run shots)",
      "Bash(npm run shots:update)",
      "Bash(npm run play:*)",
      "Bash(npm run release)",
      "Bash(npm run assets)",
      "Bash(npm run assets:pack)",
      "Bash(npm run build)",
      "Bash(npm run build:single)",
      "Bash(npm run balance:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npx prettier --write:*)"
    ],
    "deny": ["Bash(npx vite preview:*)", "Bash(npm run preview:*)", "Read(./**/.token)", "Read(./**/*.env)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.mjs\"", "timeout": 60 }]
      }
    ]
  }
}
