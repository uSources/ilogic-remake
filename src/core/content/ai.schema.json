{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pesos de la IA de Ilogic",
  "description": "Cambiarlos cambia como juega la IA: medir con npm run balance y actualizar tests/aiGolden.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maxMergedLife",
    "maxCaptureDistance",
    "retreatBelowLife",
    "costPerPoint",
    "killBonus",
    "hqDefenderBonus",
    "stopHqCaptureBonus",
    "stopCaptureBonus",
    "fullBonusDamage",
    "enemyHqPreference",
    "ownedBuildingPreference",
    "minCapturers",
    "controlPointHeadStart",
    "guardRadius",
    "focusFireBonus",
    "squadSpread",
    "hqCaptureHeadStart",
    "bigUnitCost",
    "minEvictionWeight",
    "dangerAversion",
    "supportedDangerShare",
    "lonelinessCost",
    "companyRadius",
    "exposureShare",
    "coverDangerShare",
    "pushAdvantage",
    "attackNeedRatio",
    "crowdSteps",
    "memoryDays",
    "nerves",
    "reserveShare",
    "personalities",
    "difficulties"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "maxMergedLife": {
      "type": "number",
      "minimum": 0,
      "description": "Vida maxima que suman dos unidades al unirse (la IA no une si pasa de aqui)."
    },
    "maxCaptureDistance": {
      "type": "number",
      "minimum": 0,
      "description": "Distancia maxima a la que una unidad de captura va a por un edificio."
    },
    "retreatBelowLife": {
      "type": "number",
      "minimum": 0,
      "description": "Con menos vida que esto, vuelve a curarse."
    },
    "costPerPoint": {
      "type": "number",
      "minimum": 0,
      "description": "Precio que vale 1 punto al valorar un ataque (daño x precio / costPerPoint)."
    },
    "killBonus": {
      "type": "number",
      "minimum": 0,
      "description": "Extra por matar al objetivo (por cada punto de precio / costPerPoint)."
    },
    "hqDefenderBonus": {
      "type": "number",
      "minimum": 0,
      "description": "Extra por atacar a quien defiende su Base encima de ella."
    },
    "stopHqCaptureBonus": {
      "type": "number",
      "minimum": 0,
      "description": "Extra por echar a quien captura la Base propia."
    },
    "stopCaptureBonus": {
      "type": "number",
      "minimum": 0,
      "description": "Extra por echar a quien captura otro edificio propio."
    },
    "fullBonusDamage": {
      "type": "number",
      "minimum": 0,
      "description": "Daño que da el extra completo (por debajo se reduce, nunca a menos de la mitad)."
    },
    "enemyHqPreference": {
      "type": "number",
      "minimum": 0,
      "description": "Preferencia por capturar la Base enemiga."
    },
    "ownedBuildingPreference": {
      "type": "number",
      "minimum": 0,
      "description": "Preferencia por capturar edificios con dueño."
    },
    "minCapturers": {
      "type": "number",
      "minimum": 0,
      "description": "Unidades que capturan que intenta tener siempre."
    },
    "controlPointHeadStart": {
      "type": "number",
      "minimum": 0,
      "description": "Puntos de control ajenos: cuantas casillas mas cerca cuentan al elegir adonde avanzar."
    },
    "focusFireBonus": {
      "type": "number",
      "minimum": 0,
      "description": "Solo la IA enemiga (fuego concentrado): extra, por cada 1000 de precio del objetivo, por atacar al enemigo que el plan del turno reparte entre varias unidades para destruirlo."
    },
    "guardRadius": {
      "type": "number",
      "minimum": 0,
      "description": "Unidades con la orden defender: atacan a los enemigos a esta distancia (o menos) de la casilla que guardan."
    },
    "squadSpread": {
      "type": "number",
      "minimum": 0,
      "description": "Escuadras con la misma orden: casillas que una unidad puede adelantarse a la mas retrasada (medido por tierra hasta el destino) antes de esperarla."
    },
    "hqCaptureHeadStart": {
      "type": "number",
      "minimum": 0,
      "description": "Al buscar que capturar: la Base enemiga cuenta como si estuviera estas casillas mas cerca que otro edificio."
    },
    "bigUnitCost": {
      "type": "number",
      "minimum": 0,
      "description": "Con puntos de mando: un edificio que fabrica algo de este precio o mas fabrica lo grande y compra antes (en orden al azar entre ellos)."
    },
    "minEvictionWeight": {
      "type": "number",
      "minimum": 0,
      "description": "Echar a quien defiende su Base o captura un edificio propio: lo minimo que pesa el ataque aunque el golpe sea flojo (por cada fullBonusDamage de dano, 1)."
    },
    "dangerAversion": {
      "type": "number",
      "minimum": 0,
      "description": "Pasos que cuesta acabar el turno donde los enemigos que conoce le pueden quitar toda la vida (en proporcion si menos; IA con mapas de influencia, docs/PLAN-IA.md)."
    },
    "supportedDangerShare": {
      "type": "number",
      "minimum": 0,
      "description": "Parte del peligro que cuenta en zona propia (donde los suyos responderian), de 0 a 1."
    },
    "lonelinessCost": {
      "type": "number",
      "minimum": 0,
      "description": "Pasos que cuesta acabar el turno sin ninguna unidad suya cerca (a companyRadius o menos)."
    },
    "companyRadius": {
      "type": "number",
      "minimum": 0,
      "description": "Distancia (en linea) a la que una unidad suya cuenta como compañia."
    },
    "exposureShare": {
      "type": "number",
      "minimum": 0,
      "description": "Parte del daño que le pueden hacer donde dispara que se resta al valor del ataque (quedarse expuesta)."
    },
    "coverDangerShare": {
      "type": "number",
      "minimum": 0,
      "description": "Con mapas de influencia: en zona del enemigo, una unidad se pone a cubierto si donde esta le pueden quitar esta parte de su vida o mas."
    },
    "pushAdvantage": {
      "type": "number",
      "minimum": 0,
      "description": "Planes (docs/PLAN-IA.md, fase 2): con un ejercito que vale esto veces lo que conoce del enemigo, todas a la Base enemiga."
    },
    "attackNeedRatio": {
      "type": "number",
      "minimum": 0,
      "description": "Planes: fuerza propia que manda a un grupo enemigo, en veces lo que vale el grupo; con eso cubierto, las demas van a otro sitio."
    },
    "crowdSteps": {
      "type": "number",
      "minimum": 0,
      "description": "Planes: pasos de mas que cuesta un objetivo que ya tiene bastante (para no amontonarse)."
    },
    "memoryDays": {
      "type": "integer",
      "minimum": 0,
      "description": "Memoria (docs/PLAN-IA.md, fase 3): dias que la IA tiene en cuenta a un enemigo que ya no ve, donde lo vio por ultima vez (pesa menos cuanto mas viejo); 0, solo los que ve."
    },
    "nerves": {
      "type": "number",
      "minimum": 0,
      "description": "Nervios (docs/PLAN-IA.md, fase 4): al elegir a quien disparar o que objetivo seguir, se queda con una opcion al azar entre las que se quedan a menos de esta parte de la mejor (0: siempre la mejor). Lo cambia la dificultad."
    },
    "personalities": {
      "type": "array",
      "minItems": 1,
      "description": "Personalidades de la IA (docs/PLAN-IA.md, fase 4): cada una cambia algunos pesos. Una escaramuza da una al azar a cada IA.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "weights"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\w+$",
            "description": "Nombre interno (lo guardan las partidas)."
          },
          "name": {
            "type": "object",
            "required": ["es", "en"],
            "properties": {
              "es": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "default": {
            "type": "boolean",
            "description": "La de quien no dice otra (exactamente una)."
          },
          "weights": {
            "type": "object",
            "description": "Pesos que cambia (los mismos nombres que arriba; los que no estan, los de este fichero).",
            "additionalProperties": false,
            "properties": {
              "maxMergedLife": {
                "type": "number",
                "minimum": 0
              },
              "maxCaptureDistance": {
                "type": "number",
                "minimum": 0
              },
              "retreatBelowLife": {
                "type": "number",
                "minimum": 0
              },
              "costPerPoint": {
                "type": "number",
                "minimum": 0
              },
              "killBonus": {
                "type": "number",
                "minimum": 0
              },
              "hqDefenderBonus": {
                "type": "number",
                "minimum": 0
              },
              "stopHqCaptureBonus": {
                "type": "number",
                "minimum": 0
              },
              "stopCaptureBonus": {
                "type": "number",
                "minimum": 0
              },
              "fullBonusDamage": {
                "type": "number",
                "minimum": 0
              },
              "enemyHqPreference": {
                "type": "number",
                "minimum": 0
              },
              "ownedBuildingPreference": {
                "type": "number",
                "minimum": 0
              },
              "minCapturers": {
                "type": "number",
                "minimum": 0
              },
              "controlPointHeadStart": {
                "type": "number",
                "minimum": 0
              },
              "guardRadius": {
                "type": "number",
                "minimum": 0
              },
              "focusFireBonus": {
                "type": "number",
                "minimum": 0
              },
              "squadSpread": {
                "type": "number",
                "minimum": 0
              },
              "hqCaptureHeadStart": {
                "type": "number",
                "minimum": 0
              },
              "bigUnitCost": {
                "type": "number",
                "minimum": 0
              },
              "minEvictionWeight": {
                "type": "number",
                "minimum": 0
              },
              "dangerAversion": {
                "type": "number",
                "minimum": 0
              },
              "supportedDangerShare": {
                "type": "number",
                "minimum": 0
              },
              "lonelinessCost": {
                "type": "number",
                "minimum": 0
              },
              "companyRadius": {
                "type": "number",
                "minimum": 0
              },
              "exposureShare": {
                "type": "number",
                "minimum": 0
              },
              "coverDangerShare": {
                "type": "number",
                "minimum": 0
              },
              "pushAdvantage": {
                "type": "number",
                "minimum": 0
              },
              "attackNeedRatio": {
                "type": "number",
                "minimum": 0
              },
              "crowdSteps": {
                "type": "number",
                "minimum": 0
              },
              "memoryDays": {
                "type": "number",
                "minimum": 0
              },
              "nerves": {
                "type": "number",
                "minimum": 0
              },
              "reserveShare": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "difficulties": {
      "type": "array",
      "minItems": 1,
      "description": "Dificultades de la IA (Nueva partida): cada una cambia algunos pesos (los nervios) y el dinero de salida.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "weights", "startFunds"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\w+$",
            "description": "Nombre interno (lo guardan las partidas)."
          },
          "name": {
            "type": "object",
            "required": ["es", "en"],
            "properties": {
              "es": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "default": {
            "type": "boolean",
            "description": "La de quien no dice otra (exactamente una)."
          },
          "weights": {
            "type": "object",
            "description": "Pesos que cambia (los mismos nombres que arriba; los que no estan, los de este fichero).",
            "additionalProperties": false,
            "properties": {
              "maxMergedLife": {
                "type": "number",
                "minimum": 0
              },
              "maxCaptureDistance": {
                "type": "number",
                "minimum": 0
              },
              "retreatBelowLife": {
                "type": "number",
                "minimum": 0
              },
              "costPerPoint": {
                "type": "number",
                "minimum": 0
              },
              "killBonus": {
                "type": "number",
                "minimum": 0
              },
              "hqDefenderBonus": {
                "type": "number",
                "minimum": 0
              },
              "stopHqCaptureBonus": {
                "type": "number",
                "minimum": 0
              },
              "stopCaptureBonus": {
                "type": "number",
                "minimum": 0
              },
              "fullBonusDamage": {
                "type": "number",
                "minimum": 0
              },
              "enemyHqPreference": {
                "type": "number",
                "minimum": 0
              },
              "ownedBuildingPreference": {
                "type": "number",
                "minimum": 0
              },
              "minCapturers": {
                "type": "number",
                "minimum": 0
              },
              "controlPointHeadStart": {
                "type": "number",
                "minimum": 0
              },
              "guardRadius": {
                "type": "number",
                "minimum": 0
              },
              "focusFireBonus": {
                "type": "number",
                "minimum": 0
              },
              "squadSpread": {
                "type": "number",
                "minimum": 0
              },
              "hqCaptureHeadStart": {
                "type": "number",
                "minimum": 0
              },
              "bigUnitCost": {
                "type": "number",
                "minimum": 0
              },
              "minEvictionWeight": {
                "type": "number",
                "minimum": 0
              },
              "dangerAversion": {
                "type": "number",
                "minimum": 0
              },
              "supportedDangerShare": {
                "type": "number",
                "minimum": 0
              },
              "lonelinessCost": {
                "type": "number",
                "minimum": 0
              },
              "companyRadius": {
                "type": "number",
                "minimum": 0
              },
              "exposureShare": {
                "type": "number",
                "minimum": 0
              },
              "coverDangerShare": {
                "type": "number",
                "minimum": 0
              },
              "pushAdvantage": {
                "type": "number",
                "minimum": 0
              },
              "attackNeedRatio": {
                "type": "number",
                "minimum": 0
              },
              "crowdSteps": {
                "type": "number",
