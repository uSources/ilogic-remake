              },
              "memoryDays": {
                "type": "number",
                "minimum": 0
              },
              "nerves": {
                "type": "number",
                "minimum": 0
              },
              "reserveShare": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "startFunds": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 3,
            "description": "Dinero con el que empieza la IA, en veces el de la partida."
          }
        }
      }
    },
    "reserveShare": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Parte de su dinero al empezar el turno que la IA no gasta (0: lo gasta todo). Lo cambia la dificultad (Facil ahorra sin motivo, como quien empieza)."
    }
  }
}
