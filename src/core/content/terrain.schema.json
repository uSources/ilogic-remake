{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terrenos de Ilogic",
  "description": "Los terrenos. Los id los usan el arte, los temas (themes.json) y las partidas guardadas: no se cambian. Ver docs/CONTENIDO.md.",
  "type": "object",
  "required": ["terrain"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "terrain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "protection", "hides", "buildable", "water", "movement"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Nombre interno (fijo: lo guardan las partidas)."
          },
          "plain": {
            "type": "boolean",
            "description": "El suelo llano: el de los mapas vacios (laboratorio, duelos, pruebas). Exactamente uno."
          },
          "mapLetter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1,
            "description": "Letra del terreno en los mapas en texto de las misiones, si no depende del tema (las que dependen, en themes.json, mapLetters)."
          },
          "name": {
            "type": "object",
            "required": ["es", "en"],
            "additionalProperties": false,
            "properties": {
              "es": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Nombre que ve el jugador."
          },
          "protection": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 1,
            "description": "Multiplica la probabilidad de acierto contra quien esta encima: 0.85 = un 15 % menos de daño."
          },
          "hides": {
            "type": "boolean",
            "description": "Con niebla y la regla forestHides, quien esta dentro solo se ve desde una casilla vecina."
          },
          "buildable": {
            "type": "boolean",
            "description": "El generador de mapas puede poner edificios encima."
          },
          "water": {
            "type": "boolean",
            "description": "Cuenta como agua (orillas, generador de mapas)."
          },
          "movement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["foot", "vehicle", "air", "amphibious"],
            "description": "Coste de movimiento por tipo (casillas de movimiento que gasta entrar; con la regla terrainCost apagada todo cuesta 1). null = no se puede pasar.",
            "properties": {
              "foot": {
                "type": ["integer", "null"],
                "minimum": 1,
                "maximum": 9,
                "description": "A pie"
              },
              "vehicle": {
                "type": ["integer", "null"],
                "minimum": 1,
                "maximum": 9,
                "description": "Vehiculos"
              },
              "air": {
                "type": ["integer", "null"],
                "minimum": 1,
                "maximum": 9,
                "description": "Aereos"
              },
              "amphibious": {
                "type": ["integer", "null"],
                "minimum": 1,
                "maximum": 9,
                "description": "Anfibios"
              }
            }
          }
        }
      }
    }
  }
}
