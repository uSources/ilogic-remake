{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Misiones de Ilogic",
  "description": "La campaña: mapas hechos a mano, equipos, objetivos y textos. Ver docs/CONTENIDO.md, \"Misiones\", y la skill nueva-mision.",
  "type": "object",
  "required": ["missions"],
  "additionalProperties": false,
  "definitions": {
    "texts": {
      "type": "object",
      "required": ["es", "en"],
      "additionalProperties": false,
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tile": {
      "type": "integer",
      "minimum": 0
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "description": "Ultimo dia para cumplirlo."
    },
    "objective": {
      "description": "Lo que tiene que hacer el equipo que lo lleva (objectives.ts).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "hq",
              "description": "Tomar la Base enemiga (o dejar al enemigo sin nada)."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "days"],
          "properties": {
            "kind": {
              "const": "survive",
              "description": "Aguantar hasta pasado el dia."
            },
            "days": {
              "$ref": "#/definitions/days"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "count", "type", "days"],
          "properties": {
            "kind": {
              "const": "capture",
              "description": "Tener `count` edificios de ese tipo (null: de cualquiera) antes de que acabe el dia."
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "type": ["string", "null"]
            },
            "days": {
              "$ref": "#/definitions/days"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "days"],
          "properties": {
            "kind": {
              "const": "destroy",
              "description": "Destruir a todos los enemigos a tiempo."
            },
            "days": {
              "$ref": "#/definitions/days"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to", "days"],
          "properties": {
            "kind": {
              "const": "escort",
              "description": "Llevar la unidad de su equipo marcada con \"vip\" en \"units\" a la casilla `to` a tiempo."
            },
            "to": {
              "type": "object",
              "required": ["x", "y"],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "$ref": "#/definitions/tile"
                },
                "y": {
                  "$ref": "#/definitions/tile"
                }
              }
            },
            "days": {
              "$ref": "#/definitions/days"
            }
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "missions": {
      "type": "array",
      "description": "En el orden de la campaña: cada una se abre al acabar la anterior.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "brief", "theme", "map", "buildings", "units", "teams"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\w+$",
            "description": "Nombre interno; lo guardan las partidas y el progreso de la campaña."
          },
          "tutorial": {
            "type": "boolean",
            "description": "Consejos paso a paso (solo el tutorial)."
          },
          "title": {
            "$ref": "#/definitions/texts"
          },
          "brief": {
            "$ref": "#/definitions/texts"
          },
          "theme": {
            "type": "string",
            "description": "Id de themes.json: graficos y el terreno de las letras que dependen del tema."
          },
          "map": {
            "type": "array",
            "description": "Una fila por linea (y), una letra por casilla (x); cuadrado. Letras: las del tema (themes.json, \"mapLetters\") y las de terrain.json (\"mapLetter\").",
            "items": {
              "type": "string"
            }
          },
          "buildings": {
            "type": "array",
            "description": "Los edificios: su tipo (buildings.json), su dueño (numero de equipo o null, neutral) y su casilla.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "owner", "at"],
              "properties": {
                "type": {
                  "type": "string"
                },
                "owner": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "at": {
                  "type": "object",
                  "required": ["x", "y"],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "$ref": "#/definitions/tile"
                    },
                    "y": {
                      "$ref": "#/definitions/tile"
                    }
                  }
                }
              }
            }
          },
          "units": {
            "type": "array",
            "description": "Las unidades: su tipo (units.json), su equipo, su casilla, su vida (si no, entera) y si es la que hay que escoltar (`vip`, la del objetivo \"escort\" de su equipo).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "team", "at"],
              "properties": {
                "type": {
                  "type": "string"
                },
                "team": {
                  "type": "integer",
                  "minimum": 0
                },
                "at": {
                  "type": "object",
                  "required": ["x", "y"],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "$ref": "#/definitions/tile"
                    },
                    "y": {
                      "$ref": "#/definitions/tile"
                    }
                  }
                },
                "life": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "vip": {
                  "const": true
                }
              }
            }
          },
          "teams": {
            "type": "array",
            "minItems": 2,
            "description": "En orden: su puesto es el numero de equipo de edificios y unidades. Cada uno con su objetivo o sin el.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["controller", "funds"],
              "properties": {
                "controller": {
                  "enum": ["human", "ai"],
                  "description": "Quien lo juega."
                },
                "funds": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Dinero al empezar."
                },
                "objective": {
                  "$ref": "#/definitions/objective",
                  "description": "Lo que tiene que hacer este equipo (si no tiene, gana o pierde por las reglas de siempre: quedarse sin Base o sin nada)."
                }
              }
            }
          },
          "settings": {
            "type": "object",
            "description": "Cambios a las reglas (settings.json, \"defaults\"): por defecto, sin puntos de mando, mantenimiento ni clima."
          }
        }
      }
    }
  }
}
