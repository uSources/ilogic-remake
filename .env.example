# Copiar a .env (no se sube al repo) para que el juego hable con un servidor de partidas por la red.
# La URL del Worker publicado desde server/ (ver server/README.md). Sin ella, el juego no ofrece
# partidas por la red. En GitHub Pages la pone la variable del repositorio VITE_SERVER_URL.
VITE_SERVER_URL=https://ilogic-servidor.<cuenta>.workers.dev
