{
  "name": "ilogic",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && eslint . && vite build",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "build:ci": "vite build && node scripts/build-single.mjs",
    "build:selfhost": "vite build --mode selfhost",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/assets.mjs",
    "balance": "tsx tools/balance/cli.ts",
    "assets:pack": "node scripts/assets.mjs --pack",
    "prebuild": "node scripts/assets.mjs",
    "release": "node scripts/release.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit && eslint . && prettier --check . && vitest run && npm run check:server",
    "play": "tsx tools/play/cli.ts",
    "fuzz": "tsx tools/improve/fuzz.ts",
    "huella": "tsx tools/huella.ts",
    "unit": "tsx tools/content/cli.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "commitlint": "commitlint",
    "notes": "tsx tools/notes/cli.ts",
    "server:dev": "npm run dev -w server",
    "server:node": "npm run start -w server",
    "selfhost": "npm run build:selfhost && npm run server:node",
    "server:test": "npm run test -w server",
    "check:server": "npm run check -w server",
    "shots": "node tests/visual/shots.mjs",
    "shots:update": "node tests/visual/shots.mjs --update",
    "online": "node tests/visual/online.mjs",
    "perf": "node tools/perf/measure.mjs",
    "retratos": "node tools/art/retratos3d.mjs",
    "sonidos": "tsx tools/audio/cli.ts"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "preact": "^10.29.8",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/three": "^0.181.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Ilogic: remake en 3D (TypeScript + three.js) del juego de estrategia por turnos de 2013",
  "repository": {
    "type": "git",
    "url": "https://github.com/uSources/ilogic-remake.git"
  },
  "workspaces": [
    "server"
  ]
}
