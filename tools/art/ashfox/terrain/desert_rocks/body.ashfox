ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube base { origin = (1u, -2u, 0u); size = (6u, 3u, 5u); surface = skin.base; }
        cube top { origin = (2u, 1u, 1u); size = (4u, 1u, 3u); surface = skin.top; }
        cube stone { origin = (3u, -1u, -3u); size = (2u, 2u, 2u); surface = skin.stone; }
        cube pebble { origin = (-1u, -1u, 6u); size = (1u, 2u, 1u); surface = skin.pebble; }
      }
    }
  }
}
