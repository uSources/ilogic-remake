ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 64px; height = 8px; }
    chart base box { width = 22px; height = 8px; coverage = opaque; }
    chart top box { width = 14px; height = 4px; coverage = opaque; }
    chart stone box { width = 8px; height = 4px; coverage = opaque; }
    chart pebble box { width = 4px; height = 3px; coverage = opaque; }
    material = opaque;
  }
}
