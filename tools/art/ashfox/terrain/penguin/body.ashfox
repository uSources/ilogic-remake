ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube foot_left { origin = (-1.5u, 0u, -2u); size = (1u, 1u, 2u); surface = skin.foot_left; }
        cube foot_right { origin = (0.5u, 0u, -2u); size = (1u, 1u, 2u); surface = skin.foot_right; }
        cube body { origin = (-2u, 1u, -1.5u); size = (4u, 6u, 3u); surface = skin.body; }
        cube belly { origin = (-1.5u, 1u, -2u); size = (3u, 5u, 1u); surface = skin.belly; }
        cube head { origin = (-1.5u, 7u, -1.5u); size = (3u, 3u, 3u); surface = skin.head; }
        cube beak { origin = (-0.5u, 8u, -2.5u); size = (1u, 1u, 1u); surface = skin.beak; }
        cube flipper_left { origin = (-3u, 3u, -1u); size = (1u, 4u, 2u); surface = skin.flipper_left; }
        cube flipper_right { origin = (2u, 3u, -1u); size = (1u, 4u, 2u); surface = skin.flipper_right; }
      }
    }
  }
}
