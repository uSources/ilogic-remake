ashfox-model 1
asset tile_water {
  import "./tile_water/rig.ashfox" as rig;
  import "./tile_water/paint.ashfox" as paint;
  import "./tile_water/body.ashfox" as body;
  export asset tile_water {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
