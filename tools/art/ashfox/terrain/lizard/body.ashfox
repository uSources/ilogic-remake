ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube body { origin = (-1u, 0u, -3u); size = (2u, 1u, 5u); surface = skin.body; }
        cube head { origin = (-1u, 0u, -5u); size = (2u, 1u, 2u); surface = skin.head; }
        cube snout { origin = (-0.5u, 0u, -6u); size = (1u, 1u, 1u); surface = skin.snout; }
        cube tail { origin = (-0.5u, 0u, 2u); size = (1u, 1u, 4u); surface = skin.tail; }
        cube tail_tip { origin = (0.5u, 0u, 5u); size = (1u, 1u, 3u); surface = skin.tail_tip; }
        cube leg_front_left { origin = (-2u, 0u, -3u); size = (1u, 1u, 1u); surface = skin.leg_front_left; }
        cube leg_front_right { origin = (1u, 0u, -3u); size = (1u, 1u, 1u); surface = skin.leg_front_right; }
        cube leg_back_left { origin = (-2u, 0u, 1u); size = (1u, 1u, 1u); surface = skin.leg_back_left; }
        cube leg_back_right { origin = (1u, 0u, 1u); size = (1u, 1u, 1u); surface = skin.leg_back_right; }
      }
    }
  }
}
