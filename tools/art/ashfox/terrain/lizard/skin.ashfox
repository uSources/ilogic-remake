ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 64px; height = 16px; }
    chart body box { width = 14px; height = 6px; coverage = opaque; }
    chart head box { width = 8px; height = 3px; coverage = opaque; }
    chart snout box { width = 4px; height = 2px; coverage = opaque; }
    chart tail box { width = 10px; height = 5px; coverage = opaque; }
    chart tail_tip box { width = 8px; height = 4px; coverage = opaque; }
    chart leg_front_left box { width = 4px; height = 2px; coverage = opaque; }
    chart leg_front_right box { width = 4px; height = 2px; coverage = opaque; }
    chart leg_back_left box { width = 4px; height = 2px; coverage = opaque; }
    chart leg_back_right box { width = 4px; height = 2px; coverage = opaque; }
    material = opaque;
  }
}
