    chart a_south box { width = 10px; height = 2px; coverage = opaque; }
    chart a_west box { width = 10px; height = 5px; coverage = opaque; }
    chart a_east box { width = 10px; height = 5px; coverage = opaque; }
    chart b_pad box { width = 16px; height = 5px; coverage = opaque; }
    chart b_north box { width = 6px; height = 2px; coverage = opaque; }
    chart b_south box { width = 6px; height = 2px; coverage = opaque; }
    chart b_west box { width = 6px; height = 3px; coverage = opaque; }
    chart b_east box { width = 6px; height = 3px; coverage = opaque; }
    chart c_pad box { width = 16px; height = 5px; coverage = opaque; }
    chart c_north box { width = 6px; height = 2px; coverage = opaque; }
    chart c_south box { width = 6px; height = 2px; coverage = opaque; }
    chart c_west box { width = 6px; height = 3px; coverage = opaque; }
    chart c_east box { width = 6px; height = 3px; coverage = opaque; }
    chart d_pad box { width = 16px; height = 5px; coverage = opaque; }
