ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube a_stem0 { origin = (-9u, 0u, -7u); size = (1u, 8u, 1u); surface = skin.a_stem0; }
        cube a_stem1 { origin = (-7u, 0u, -6u); size = (1u, 6u, 1u); surface = skin.a_stem1; }
        cube a_stem2 { origin = (-10u, 0u, -5u); size = (1u, 9u, 1u); surface = skin.a_stem2; }
        cube a_head2 { origin = (-10.5u, 8u, -5.5u); size = (2u, 3u, 2u); surface = skin.a_head2; }
        cube b_stem0 { origin = (-8u, 0u, 9u); size = (1u, 6u, 1u); surface = skin.b_stem0; }
        cube b_stem1 { origin = (-7u, 0u, 7u); size = (1u, 7u, 1u); surface = skin.b_stem1; }
      }
    }
  }
}
