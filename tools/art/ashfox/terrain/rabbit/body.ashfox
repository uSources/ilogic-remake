ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube body { origin = (-2u, 0u, -2u); size = (4u, 4u, 6u); surface = skin.body; }
        cube head { origin = (-1.5u, 3u, -5u); size = (3u, 3u, 3u); surface = skin.head; }
        cube ear_left { origin = (-1.5u, 6u, -3.5u); size = (1u, 4u, 1u); surface = skin.ear_left; }
        cube ear_right { origin = (0.5u, 6u, -3.5u); size = (1u, 4u, 1u); surface = skin.ear_right; }
        cube paw_left { origin = (-1.5u, 0u, -3u); size = (1u, 1u, 1u); surface = skin.paw_left; }
        cube paw_right { origin = (0.5u, 0u, -3u); size = (1u, 1u, 1u); surface = skin.paw_right; }
        cube tail { origin = (-1u, 2u, 4u); size = (2u, 2u, 1u); surface = skin.tail; }
      }
    }
  }
}
