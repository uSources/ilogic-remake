ashfox-model 1
asset snowman {
  import "./snowman/rig.ashfox" as rig;
  import "./snowman/paint.ashfox" as paint;
  import "./snowman/body.ashfox" as body;
  export asset snowman {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
