ashfox-model 1
asset lilies_0 {
  import "./lilies_0/rig.ashfox" as rig;
  import "./lilies_0/paint.ashfox" as paint;
  import "./lilies_0/body.ashfox" as body;
  export asset lilies_0 {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
