ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube trunk { origin = (-3u, 0u, -2u); size = (2u, 10u, 2u); surface = skin.trunk; }
        cube arm_left { origin = (-5u, 4u, -2u); size = (2u, 2u, 2u); surface = skin.arm_left; }
        cube arm_left_up { origin = (-5u, 6u, -2u); size = (2u, 3u, 2u); surface = skin.arm_left_up; }
        cube arm_right { origin = (-1u, 5u, -2u); size = (2u, 2u, 2u); surface = skin.arm_right; }
        cube arm_right_up { origin = (-1u, 7u, -2u); size = (2u, 2u, 2u); surface = skin.arm_right_up; }
        cube round { origin = (2u, 0u, 1u); size = (4u, 3u, 4u); surface = skin.round; }
        cube bloom { origin = (3u, 3u, 2u); size = (2u, 1u, 2u); surface = skin.bloom; }
      }
    }
  }
}
