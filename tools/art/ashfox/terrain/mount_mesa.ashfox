ashfox-model 1
asset mount_mesa {
  rig contract StaticRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }
  }
  skeleton StaticSkeleton implements StaticRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart layer0 box { width = 60px; height = 19px; coverage = opaque; }
    chart layer1 box { width = 52px; height = 17px; coverage = opaque; }
    chart layer2 box { width = 44px; height = 15px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = mesa; background-alpha = 255;
      palette {
        mesa = (#a8501e, #d0712c, #ee9a48);
        mesa_spots = (#8a3e16, #b05a22, #d07434);
        mesa_light = (#d0782e, #eea050, #ffc46e);
      }

      chart layer0 box {
        origin = (0px, 0px); fill = mesa;
        pattern blotch { paint = mesa_spots; scale = (6px, 1px, 6px); density = 0.3ratio; phase = 0; }
      }
      chart layer1 box {
        origin = (0px, 20px); fill = mesa_light;
      }
      chart layer2 box {
        origin = (0px, 38px); fill = mesa;
        pattern blotch { paint = mesa_spots; scale = (6px, 1px, 6px); density = 0.3ratio; phase = 62; }
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: StaticRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube layer0 { origin = (-7.5u, 0u, -7.5u); size = (15u, 4u, 15u); surface = skin.layer0; }
        cube layer1 { origin = (-6.5u, 4u, -6.5u); size = (13u, 4u, 13u); surface = skin.layer1; }
        cube layer2 { origin = (-5.5u, 8u, -5.5u); size = (11u, 4u, 11u); surface = skin.layer2; }
      }
    }
  }
  export asset mount_mesa {
    settings { density = 16; forward = north; }
    skeleton = StaticSkeleton;
    use Body as model { bind skeleton = StaticRig; bind skin = paint; };
  }
}
