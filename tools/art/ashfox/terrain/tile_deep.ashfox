ashfox-model 1
asset tile_deep {
  import "./tile_deep/rig.ashfox" as rig;
  import "./tile_deep/paint.ashfox" as paint;
  import "./tile_deep/body.ashfox" as body;
  export asset tile_deep {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
