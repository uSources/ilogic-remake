ashfox-model 1
asset lizard {
  import "./lizard/rig.ashfox" as rig;
  import "./lizard/paint.ashfox" as paint;
  import "./lizard/body.ashfox" as body;
  export asset lizard {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
