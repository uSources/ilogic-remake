ashfox-model 1
asset bird {
  import "./bird/rig.ashfox" as rig;
  import "./bird/paint.ashfox" as paint;
  import "./bird/body.ashfox" as body;
  export asset bird {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
