ashfox-model 1
asset tile_grass_3 {
  rig contract StaticRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = rotation; mirror = none; }
  }
  skeleton StaticSkeleton implements StaticRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart base box { width = 64px; height = 26px; coverage = opaque; }
    chart top box { width = 64px; height = 18px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = earth; background-alpha = 255;
      palette {
        earth = (#5a3420, #8a5530, #b47a45);
        earth_spots = (#4a2a18, #6e4228, #8f5b36);
        grass = (#4f9a2e, #7cc63e, #a8e05a);
        grass_spots = (#3f8526, #5fae34, #8fd14f);
        tuft_d = #3f8526;
        daisy_w = #f2f5ff;
        daisy_y = #ffd447;
        poppy_r = #ff5a50;
        buttercup_y = #ffe866;
        clearing_l = #a8e05a;
      }
      stamp tuft { pixels = "d.d/.d."; d = tuft_d; }
      stamp daisy { pixels = ".w./wyw/.w."; w = daisy_w; y = daisy_y; }
      stamp poppy { pixels = "r"; r = poppy_r; }
      stamp buttercup { pixels = "y"; y = buttercup_y; }
      stamp clearing { pixels = "ll./lll"; l = clearing_l; }
      chart base box {
        origin = (0px, 0px); fill = earth;
        pattern blotch { paint = earth_spots; scale = (2px, 1px, 2px); density = 0.2ratio; phase = 54; }
      }
      chart top box {
        origin = (0px, 27px); fill = grass;
        pattern blotch { paint = grass_spots; scale = (2px, 2px, 2px); density = 0.18ratio; phase = 54; }
        face up { stamp tuft { at = (5px, 1px); } stamp daisy { at = (2px, 5px); } stamp daisy { at = (0px, 10px); } stamp poppy { at = (15px, 7px); } stamp poppy { at = (10px, 1px); } stamp poppy { at = (2px, 5px); } stamp poppy { at = (14px, 0px); } stamp buttercup { at = (11px, 7px); } stamp clearing { at = (1px, 0px); } }
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: StaticRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube base { origin = (-8u, -8u, -8u); size = (16u, 10u, 16u); surface = skin.base; }
        cube top { origin = (-8u, 2u, -8u); size = (16u, 2u, 16u); surface = skin.top; }
      }
    }
  }
  export asset tile_grass_3 {
    settings { density = 16; forward = north; }
    skeleton = StaticSkeleton;
    use Body as model { bind skeleton = StaticRig; bind skin = paint; };
  }
}
