ashfox-model 1
asset tumbleweed {
  import "./tumbleweed/rig.ashfox" as rig;
  import "./tumbleweed/paint.ashfox" as paint;
  import "./tumbleweed/body.ashfox" as body;
  export asset tumbleweed {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
