ashfox-model 1
asset seal {
  import "./seal/rig.ashfox" as rig;
  import "./seal/paint.ashfox" as paint;
  import "./seal/body.ashfox" as body;
  export asset seal {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
