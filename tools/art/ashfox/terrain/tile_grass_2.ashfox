ashfox-model 1
asset tile_grass_2 {
  import "./tile_grass_2/rig.ashfox" as rig;
  import "./tile_grass_2/paint.ashfox" as paint;
  import "./tile_grass_2/body.ashfox" as body;
  export asset tile_grass_2 {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
