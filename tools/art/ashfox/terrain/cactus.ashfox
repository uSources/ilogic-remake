ashfox-model 1
asset cactus {
  import "./cactus/rig.ashfox" as rig;
  import "./cactus/paint.ashfox" as paint;
  import "./cactus/body.ashfox" as body;
  export asset cactus {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
