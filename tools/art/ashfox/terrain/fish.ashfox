ashfox-model 1
asset fish {
  import "./fish/rig.ashfox" as rig;
  import "./fish/paint.ashfox" as paint;
  import "./fish/body.ashfox" as body;
  export asset fish {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
