ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 64px; height = 32px; }
    chart a_stem0 box { width = 4px; height = 13px; coverage = opaque; }
    chart a_head0 box { width = 8px; height = 5px; coverage = opaque; }
    chart a_stem1 box { width = 4px; height = 10px; coverage = opaque; }
    chart a_stem2 box { width = 4px; height = 11px; coverage = opaque; }
    chart a_head2 box { width = 8px; height = 5px; coverage = opaque; }
    chart a_stem3 box { width = 4px; height = 8px; coverage = opaque; }
    chart b_stem0 box { width = 4px; height = 11px; coverage = opaque; }
    chart b_head0 box { width = 8px; height = 5px; coverage = opaque; }
    chart b_stem1 box { width = 4px; height = 9px; coverage = opaque; }
    chart b_stem2 box { width = 4px; height = 12px; coverage = opaque; }
    chart b_head2 box { width = 8px; height = 5px; coverage = opaque; }
    chart c_stem0 box { width = 4px; height = 10px; coverage = opaque; }
    chart c_stem1 box { width = 4px; height = 12px; coverage = opaque; }
    chart c_head1 box { width = 8px; height = 5px; coverage = opaque; }
    chart c_stem2 box { width = 4px; height = 8px; coverage = opaque; }
    chart i1_stem box { width = 4px; height = 9px; coverage = opaque; }
    chart i1_bloom box { width = 8px; height = 4px; coverage = opaque; }
    chart i2_stem box { width = 4px; height = 8px; coverage = opaque; }
    chart i2_bloom box { width = 8px; height = 4px; coverage = opaque; }
    chart i3_stem box { width = 4px; height = 7px; coverage = opaque; }
    chart i3_bloom box { width = 8px; height = 4px; coverage = opaque; }
    material = opaque;
  }
}
