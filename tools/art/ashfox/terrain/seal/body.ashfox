ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube body { origin = (-2u, 0u, -4u); size = (4u, 3u, 9u); surface = skin.body; }
        cube head { origin = (-1.5u, 1u, -7u); size = (3u, 3u, 3u); surface = skin.head; }
        cube snout { origin = (-1u, 1u, -8u); size = (2u, 2u, 1u); surface = skin.snout; }
        cube flipper_left { origin = (-3u, 0u, -2u); size = (1u, 1u, 2u); surface = skin.flipper_left; }
        cube flipper_right { origin = (2u, 0u, -2u); size = (1u, 1u, 2u); surface = skin.flipper_right; }
        cube tail_left { origin = (-2.5u, 0u, 5u); size = (2u, 1u, 2u); surface = skin.tail_left; }
        cube tail_right { origin = (0.5u, 0u, 5u); size = (2u, 1u, 2u); surface = skin.tail_right; }
      }
    }
  }
}
