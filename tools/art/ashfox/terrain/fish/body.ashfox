ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube nose { origin = (-1u, -1u, -4u); size = (2u, 2u, 1u); surface = skin.nose; }
        cube body { origin = (-1u, -1.5u, -3u); size = (2u, 3u, 6u); surface = skin.body; }
        cube belly { origin = (-1u, -2.5u, -2u); size = (2u, 1u, 4u); surface = skin.belly; }
        cube fin { origin = (-0.5u, 1.5u, -1u); size = (1u, 1u, 2u); surface = skin.fin; }
        cube tail { origin = (-0.5u, -2u, 3u); size = (1u, 4u, 2u); surface = skin.tail; }
      }
    }
  }
}
