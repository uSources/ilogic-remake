ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 32px); background = snowcap; background-alpha = 255;
      palette {
        snowcap = (#d6e6f6, #f0f6ff, #ffffff);
        eyes_k = #141824;
        scarf = (#9a1c22, #d8323a, #ff6a62);
        carrot = (#c85a10, #ee7a20, #ff9a40);
        hat = (#141824, #262c3c, #3c4458);
      }
      stamp eyes { pixels = "k..k"; k = eyes_k; }
      chart body box { origin = (0px, 0px); fill = snowcap; }
      chart head box { origin = (25px, 0px); fill = snowcap; face north { stamp eyes { at = (0px, 1px); } } }
      chart scarf box { origin = (42px, 0px); fill = scarf; }
      chart nose box { origin = (34px, 12px); fill = carrot; }
      chart brim box { origin = (0px, 12px); fill = hat; }
      chart hat box { origin = (21px, 12px); fill = hat; }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
