ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube body { origin = (-3u, 0u, -3u); size = (6u, 5u, 6u); surface = skin.body; }
        cube head { origin = (-2u, 5u, -2u); size = (4u, 4u, 4u); surface = skin.head; }
        cube scarf { origin = (-2.5u, 4.5u, -2.5u); size = (5u, 1u, 5u); surface = skin.scarf; }
        cube nose { origin = (-0.5u, 6.5u, -3u); size = (1u, 1u, 1u); surface = skin.nose; }
        cube brim { origin = (-2.5u, 9u, -2.5u); size = (5u, 1u, 5u); surface = skin.brim; }
        cube hat { origin = (-1.5u, 10u, -1.5u); size = (3u, 3u, 3u); surface = skin.hat; }
      }
    }
  }
}
