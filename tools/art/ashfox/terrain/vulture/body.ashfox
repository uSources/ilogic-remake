ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube body { origin = (-1.5u, 0u, -3u); size = (3u, 2u, 6u); surface = skin.body; }
        cube ruff { origin = (-1.5u, 0.5u, -4u); size = (3u, 2u, 1u); surface = skin.ruff; }
        cube head { origin = (-1u, 1u, -6u); size = (2u, 2u, 2u); surface = skin.head; }
        cube beak { origin = (-0.5u, 1u, -7u); size = (1u, 1u, 1u); surface = skin.beak; }
        cube wing_left { origin = (-8.5u, 1u, -2.5u); size = (7u, 1u, 5u); surface = skin.wing_left; }
        cube wing_right { origin = (1.5u, 1u, -2.5u); size = (7u, 1u, 5u); surface = skin.wing_right; }
        cube wing_left_finger0 { origin = (-10.5u, 1u, -2.5u); size = (2u, 1u, 1u); surface = skin.wing_left_finger0; }
        cube wing_left_finger1 { origin = (-10.5u, 1u, -0.5u); size = (2u, 1u, 1u); surface = skin.wing_left_finger1; }
        cube wing_left_finger2 { origin = (-10.5u, 1u, 1.5u); size = (2u, 1u, 1u); surface = skin.wing_left_finger2; }
        cube wing_right_finger0 { origin = (8.5u, 1u, -2.5u); size = (2u, 1u, 1u); surface = skin.wing_right_finger0; }
        cube wing_right_finger1 { origin = (8.5u, 1u, -0.5u); size = (2u, 1u, 1u); surface = skin.wing_right_finger1; }
        cube wing_right_finger2 { origin = (8.5u, 1u, 1.5u); size = (2u, 1u, 1u); surface = skin.wing_right_finger2; }
        cube tail { origin = (-2u, 1u, 3u); size = (4u, 1u, 3u); surface = skin.tail; }
      }
    }
  }
}
