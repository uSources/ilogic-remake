ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 64px; height = 32px; }
    chart body box { width = 18px; height = 8px; coverage = opaque; }
    chart ruff box { width = 8px; height = 3px; coverage = opaque; }
    chart head box { width = 8px; height = 4px; coverage = opaque; }
    chart beak box { width = 4px; height = 2px; coverage = opaque; }
    chart wing_left box { width = 24px; height = 6px; coverage = opaque; }
    chart wing_right box { width = 24px; height = 6px; coverage = opaque; }
    chart wing_left_finger0 box { width = 6px; height = 2px; coverage = opaque; }
    chart wing_left_finger1 box { width = 6px; height = 2px; coverage = opaque; }
    chart wing_left_finger2 box { width = 6px; height = 2px; coverage = opaque; }
    chart wing_right_finger0 box { width = 6px; height = 2px; coverage = opaque; }
    chart wing_right_finger1 box { width = 6px; height = 2px; coverage = opaque; }
    chart wing_right_finger2 box { width = 6px; height = 2px; coverage = opaque; }
    chart tail box { width = 14px; height = 4px; coverage = opaque; }
    material = opaque;
  }
}
