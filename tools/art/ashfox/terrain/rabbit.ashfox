ashfox-model 1
asset rabbit {
  import "./rabbit/rig.ashfox" as rig;
  import "./rabbit/paint.ashfox" as paint;
  import "./rabbit/body.ashfox" as body;
  export asset rabbit {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
