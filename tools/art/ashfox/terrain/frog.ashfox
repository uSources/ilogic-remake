ashfox-model 1
asset frog {
  import "./frog/rig.ashfox" as rig;
  import "./frog/paint.ashfox" as paint;
  import "./frog/body.ashfox" as body;
  export asset frog {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
