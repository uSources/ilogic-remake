ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 16px); background = leaf; background-alpha = 255;
      palette {
        leaf = (#25661f, #3c8f2e, #62bd44);
        leaf_spots = (#4fae3a, #78d055, #a2e670);
        stem = (#2f7a2a, #3f9a34, #5cbf4a);
        flower_center = (#c89a10, #f2c81e, #ffe866);
        petal_yellow = (#c89a10, #f2c81e, #ffe866);
        petal_white = (#c8ccd8, #eef2fa, #ffffff);
      }

      chart a_leaves box { origin = (0px, 0px); fill = leaf; pattern blotch { paint = leaf_spots; scale = (2px, 2px, 2px); density = 0.25ratio; phase = 7; } }
      chart b_leaves box { origin = (37px, 0px); fill = leaf; pattern blotch { paint = leaf_spots; scale = (2px, 2px, 2px); density = 0.25ratio; phase = 7; } }
      chart c_leaves box { origin = (50px, 0px); fill = leaf; pattern blotch { paint = leaf_spots; scale = (2px, 2px, 2px); density = 0.25ratio; phase = 7; } }
      chart f0_stem box { origin = (0px, 6px); fill = stem; }
      chart f0_center box { origin = (10px, 6px); fill = flower_center; }
      chart f0_petal0 box { origin = (15px, 6px); fill = petal_yellow; }
      chart f0_petal1 box { origin = (20px, 6px); fill = petal_yellow; }
      chart f0_petal2 box { origin = (25px, 6px); fill = petal_yellow; }
      chart f0_petal3 box { origin = (30px, 6px); fill = petal_yellow; }
      chart f1_stem box { origin = (5px, 6px); fill = stem; }
      chart f1_center box { origin = (35px, 6px); fill = flower_center; }
      chart f1_petal0 box { origin = (40px, 6px); fill = petal_yellow; }
      chart f1_petal1 box { origin = (45px, 6px); fill = petal_yellow; }
      chart f1_petal2 box { origin = (50px, 6px); fill = petal_yellow; }
      chart f1_petal3 box { origin = (55px, 6px); fill = petal_yellow; }
      chart f2_stem box { origin = (17px, 0px); fill = stem; }
      chart f2_center box { origin = (60px, 6px); fill = flower_center; }
      chart f2_petal0 box { origin = (0px, 11px); fill = petal_white; }
      chart f2_petal1 box { origin = (5px, 11px); fill = petal_white; }
      chart f2_petal2 box { origin = (10px, 11px); fill = petal_white; }
      chart f2_petal3 box { origin = (15px, 11px); fill = petal_white; }
      chart f3_stem box { origin = (22px, 0px); fill = stem; }
      chart f3_center box { origin = (20px, 11px); fill = flower_center; }
      chart f3_petal0 box { origin = (25px, 11px); fill = petal_yellow; }
      chart f3_petal1 box { origin = (30px, 11px); fill = petal_yellow; }
      chart f3_petal2 box { origin = (35px, 11px); fill = petal_yellow; }
      chart f3_petal3 box { origin = (40px, 11px); fill = petal_yellow; }
      chart f4_stem box { origin = (27px, 0px); fill = stem; }
      chart f4_center box { origin = (45px, 11px); fill = flower_center; }
      chart f4_petal0 box { origin = (50px, 11px); fill = petal_yellow; }
      chart f4_petal1 box { origin = (55px, 11px); fill = petal_yellow; }
      chart f4_petal2 box { origin = (60px, 11px); fill = petal_yellow; }
      chart f4_petal3 box { origin = (0px, 14px); fill = petal_yellow; }
      chart f5_stem box { origin = (32px, 0px); fill = stem; }
      chart f5_center box { origin = (5px, 14px); fill = flower_center; }
      chart f5_petal0 box { origin = (10px, 14px); fill = petal_white; }
      chart f5_petal1 box { origin = (15px, 14px); fill = petal_white; }
      chart f5_petal2 box { origin = (20px, 14px); fill = petal_white; }
      chart f5_petal3 box { origin = (25px, 14px); fill = petal_white; }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
