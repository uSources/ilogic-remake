ashfox-model 1
asset pines {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }

  surface contract Skin {
    atlas { width = 64px; height = 32px; }
    chart a_trunk box { width = 8px; height = 5px; coverage = opaque; }
    chart a_crown0 box { width = 32px; height = 11px; coverage = opaque; }
    chart a_crown1 box { width = 24px; height = 9px; coverage = opaque; }
    chart a_crown2 box { width = 16px; height = 7px; coverage = opaque; }
    chart a_crown3 box { width = 8px; height = 4px; coverage = opaque; }
    chart b_trunk box { width = 8px; height = 5px; coverage = opaque; }
    chart b_crown0 box { width = 28px; height = 10px; coverage = opaque; }
    chart b_crown1 box { width = 20px; height = 8px; coverage = opaque; }
    chart b_crown2 box { width = 12px; height = 6px; coverage = opaque; }
    chart b_crown3 box { width = 8px; height = 4px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 32px); background = trunk; background-alpha = 255;
      palette {
        trunk = (#4a2c18, #6e4224, #8e5a32);
        pine = (#1d3f6e, #2e5a96, #4a7cc0);
        pine_spots = (#3e6eb0, #5e8ed0, #8ab0ea);
        snowcap = (#d6e6f6, #f0f6ff, #ffffff);
      }

      chart a_trunk box {
        origin = (13px, 22px); fill = trunk;
      }
      chart a_crown0 box {
        origin = (0px, 0px); fill = pine;
        pattern blotch { paint = pine_spots; scale = (2px, 1px, 2px); density = 0.25ratio; phase = 4; }
      }
      chart a_crown1 box {
        origin = (0px, 12px); fill = pine;
        pattern blotch { paint = pine_spots; scale = (2px, 1px, 2px); density = 0.25ratio; phase = 17; }
      }
      chart a_crown2 box {
        origin = (46px, 12px); fill = pine;
        pattern blotch { paint = pine_spots; scale = (2px, 1px, 2px); density = 0.25ratio; phase = 30; }
      }
      chart a_crown3 box {
        origin = (31px, 22px); fill = snowcap;
      }
      chart b_trunk box {
        origin = (22px, 22px); fill = trunk;
      }
      chart b_crown0 box {
        origin = (33px, 0px); fill = pine;
        pattern blotch { paint = pine_spots; scale = (2px, 1px, 2px); density = 0.25ratio; phase = 4; }
      }
      chart b_crown1 box {
        origin = (25px, 12px); fill = pine;
        pattern blotch { paint = pine_spots; scale = (2px, 1px, 2px); density = 0.25ratio; phase = 17; }
      }
      chart b_crown2 box {
        origin = (0px, 22px); fill = pine;
        pattern blotch { paint = pine_spots; scale = (2px, 1px, 2px); density = 0.25ratio; phase = 30; }
      }
      chart b_crown3 box {
        origin = (40px, 22px); fill = snowcap;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube a_trunk { origin = (-5u, 0u, -4u); size = (2u, 3u, 2u); surface = skin.a_trunk; }
        cube a_crown0 { origin = (-8u, 2u, -7u); size = (8u, 3u, 8u); surface = skin.a_crown0; }
        cube a_crown1 { origin = (-7u, 5u, -6u); size = (6u, 3u, 6u); surface = skin.a_crown1; }
        cube a_crown2 { origin = (-6u, 8u, -5u); size = (4u, 3u, 4u); surface = skin.a_crown2; }
        cube a_crown3 { origin = (-5u, 11u, -4u); size = (2u, 2u, 2u); surface = skin.a_crown3; }
        cube b_trunk { origin = (3u, 0u, 2u); size = (2u, 3u, 2u); surface = skin.b_trunk; }
        cube b_crown0 { origin = (0.5u, 2u, -0.5u); size = (7u, 3u, 7u); surface = skin.b_crown0; }
        cube b_crown1 { origin = (1.5u, 5u, 0.5u); size = (5u, 3u, 5u); surface = skin.b_crown1; }
        cube b_crown2 { origin = (2.5u, 8u, 1.5u); size = (3u, 3u, 3u); surface = skin.b_crown2; }
        cube b_crown3 { origin = (3u, 11u, 2u); size = (2u, 2u, 2u); surface = skin.b_crown3; }
      }
    }
  }
  export asset pines {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;

    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
