ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube a_trunk { origin = (-5u, 0u, -4u); size = (2u, 3u, 2u); surface = skin.a_trunk; }
        cube a_crown0 { origin = (-8u, 2u, -7u); size = (8u, 3u, 8u); surface = skin.a_crown0; }
        cube a_crown1 { origin = (-7u, 5u, -6u); size = (6u, 3u, 6u); surface = skin.a_crown1; }
        cube a_crown2 { origin = (-6u, 8u, -5u); size = (4u, 3u, 4u); surface = skin.a_crown2; }
        cube a_crown3 { origin = (-5u, 11u, -4u); size = (2u, 2u, 2u); surface = skin.a_crown3; }
        cube b_trunk { origin = (3u, 0u, 2u); size = (2u, 3u, 2u); surface = skin.b_trunk; }
        cube b_crown0 { origin = (0.5u, 2u, -0.5u); size = (7u, 3u, 7u); surface = skin.b_crown0; }
        cube b_crown1 { origin = (1.5u, 5u, 0.5u); size = (5u, 3u, 5u); surface = skin.b_crown1; }
        cube b_crown2 { origin = (2.5u, 8u, 1.5u); size = (3u, 3u, 3u); surface = skin.b_crown2; }
        cube b_crown3 { origin = (3u, 11u, 2u); size = (2u, 2u, 2u); surface = skin.b_crown3; }
      }
    }
  }
}
