ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube body { origin = (-1.5u, 0u, -2u); size = (3u, 3u, 5u); surface = skin.body; }
        cube head { origin = (-1.5u, 2u, -4u); size = (3u, 3u, 3u); surface = skin.head; }
        cube ear_left { origin = (-1.5u, 5u, -2.5u); size = (1u, 1u, 1u); surface = skin.ear_left; }
        cube ear_right { origin = (0.5u, 5u, -2.5u); size = (1u, 1u, 1u); surface = skin.ear_right; }
        cube paw_left { origin = (-1.5u, 0u, -3u); size = (1u, 1u, 1u); surface = skin.paw_left; }
        cube paw_right { origin = (0.5u, 0u, -3u); size = (1u, 1u, 1u); surface = skin.paw_right; }
        cube tail { origin = (-1.5u, 1u, 3u); size = (3u, 6u, 2u); surface = skin.tail; }
        cube tail_tip { origin = (-1.5u, 7u, 1u); size = (3u, 2u, 3u); surface = skin.tail_tip; }
      }
    }
  }
}
