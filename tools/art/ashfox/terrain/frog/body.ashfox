ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube body { origin = (-2u, 0u, -1u); size = (4u, 3u, 5u); surface = skin.body; }
        cube head { origin = (-2u, 1u, -3u); size = (4u, 2u, 2u); surface = skin.head; }
        cube eye_left { origin = (-2u, 3u, -3u); size = (1u, 1u, 1u); surface = skin.eye_left; }
        cube eye_right { origin = (1u, 3u, -3u); size = (1u, 1u, 1u); surface = skin.eye_right; }
        cube thigh_left { origin = (-3u, 0u, 1u); size = (1u, 2u, 3u); surface = skin.thigh_left; }
        cube thigh_right { origin = (2u, 0u, 1u); size = (1u, 2u, 3u); surface = skin.thigh_right; }
        cube foot_left { origin = (-3u, 0u, -1u); size = (1u, 1u, 2u); surface = skin.foot_left; }
        cube foot_right { origin = (2u, 0u, -1u); size = (1u, 1u, 2u); surface = skin.foot_right; }
        cube hand_left { origin = (-2u, 0u, -3u); size = (1u, 1u, 1u); surface = skin.hand_left; }
        cube hand_right { origin = (1u, 0u, -3u); size = (1u, 1u, 1u); surface = skin.hand_right; }
      }
    }
  }
}
