ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 32px); background = goose; background-alpha = 255;
      palette {
        goose = (#6a6054, #7e7466, #928878);
        goose_neck = (#1e1e20, #2a2a2c, #36363a);
        goose_cheek_w = #e8e4da;
        goose_wing = (#5a5044, #6c6254, #7e7466);
      }
      stamp goose_cheek { pixels = "w"; w = goose_cheek_w; }
      chart body box { origin = (0px, 0px); fill = goose; }
      chart neck box { origin = (25px, 0px); fill = goose_neck; }
      chart head box { origin = (27px, 12px); fill = goose_neck; face east { stamp goose_cheek { at = (1px, 0px); } } face west { stamp goose_cheek { at = (1px, 0px); } } }
      chart beak box { origin = (49px, 12px); fill = goose_neck; }
      chart wing_left box { origin = (38px, 0px); fill = goose_wing; }
      chart wing_right box { origin = (0px, 12px); fill = goose_wing; }
      chart tail box { origin = (38px, 12px); fill = goose_neck; }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
