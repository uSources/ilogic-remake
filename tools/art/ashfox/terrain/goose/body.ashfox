ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube body { origin = (-2u, 0u, -3u); size = (4u, 3u, 8u); surface = skin.body; }
        cube neck { origin = (-1u, 1u, -7u); size = (2u, 2u, 4u); surface = skin.neck; }
        cube head { origin = (-1u, 1u, -10u); size = (2u, 2u, 3u); surface = skin.head; }
        cube beak { origin = (-0.5u, 1u, -11u); size = (1u, 1u, 1u); surface = skin.beak; }
        cube wing_left { origin = (-10u, 2u, -2u); size = (8u, 1u, 5u); surface = skin.wing_left; }
        cube wing_right { origin = (2u, 2u, -2u); size = (8u, 1u, 5u); surface = skin.wing_right; }
        cube tail { origin = (-1.5u, 1u, 5u); size = (3u, 1u, 2u); surface = skin.tail; }
      }
    }
  }
}
