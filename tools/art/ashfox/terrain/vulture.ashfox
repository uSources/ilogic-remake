ashfox-model 1
asset vulture {
  import "./vulture/rig.ashfox" as rig;
  import "./vulture/paint.ashfox" as paint;
  import "./vulture/body.ashfox" as body;
  export asset vulture {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
