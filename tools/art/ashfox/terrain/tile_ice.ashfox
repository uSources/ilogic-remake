ashfox-model 1
asset tile_ice {
  import "./tile_ice/rig.ashfox" as rig;
  import "./tile_ice/paint.ashfox" as paint;
  import "./tile_ice/body.ashfox" as body;
  export asset tile_ice {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
