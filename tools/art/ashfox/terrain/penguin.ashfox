ashfox-model 1
asset penguin {
  import "./penguin/rig.ashfox" as rig;
  import "./penguin/paint.ashfox" as paint;
  import "./penguin/body.ashfox" as body;
  export asset penguin {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;

    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
