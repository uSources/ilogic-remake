ashfox-model 1
asset stronghold_neutral {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }

  surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart plinth box { width = 56px; height = 15px; coverage = opaque; }
    chart dome0 box { width = 48px; height = 16px; coverage = opaque; }
    chart dome1 box { width = 40px; height = 13px; coverage = opaque; }
    chart dome2 box { width = 32px; height = 10px; coverage = opaque; }
    chart dome3 box { width = 20px; height = 6px; coverage = opaque; }
    chart entrance box { width = 8px; height = 4px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = pavement; background-alpha = 255;
      palette {
        pavement = (#8a857a, #b9b2a0, #d6cfbd);
        pavement_spots = (#7a756a, #9a958a, #b0aa9a);
        ribbed_neutral = (#55585e, #8f949c, #c8ccd2);
        ribbed_neutral_spots = (#3a3d42, #62666e, #8f949c);
        slits_k = #14202c;
        body_neutral = (#55585e, #8f949c, #c8ccd2);
        trim_neutral = (#3a3d42, #62666e, #8f949c);
      }
      stamp slits { pixels = "kkk......kkk"; k = slits_k; }
      chart plinth box {
        origin = (0px, 17px); fill = pavement;
        pattern blotch { paint = pavement_spots; scale = (2px, 1px, 2px); density = 0.15ratio; phase = 7; }
      }
      chart dome0 box {
        origin = (0px, 0px); fill = ribbed_neutral;
        pattern blotch { paint = ribbed_neutral_spots; scale = (1px, 2px, 1px); density = 0.3ratio; phase = 7; }
        face north { stamp slits { at = (0px, 1px); } }
      }
      chart dome1 box {
        origin = (0px, 33px); fill = ribbed_neutral;
        pattern blotch { paint = ribbed_neutral_spots; scale = (1px, 2px, 1px); density = 0.3ratio; phase = 7; }
      }
      chart dome2 box {
        origin = (0px, 47px); fill = ribbed_neutral;
        pattern blotch { paint = ribbed_neutral_spots; scale = (1px, 2px, 1px); density = 0.3ratio; phase = 7; }
      }
      chart dome3 box {
        origin = (33px, 47px); fill = body_neutral;
      }
      chart entrance box {
        origin = (54px, 47px); fill = trim_neutral;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube plinth { origin = (-7u, 0u, -7u); size = (14u, 1u, 14u); surface = skin.plinth; }
        cube dome0 { origin = (-6u, 1u, -6u); size = (12u, 4u, 12u); surface = skin.dome0; }
        cube dome1 { origin = (-5u, 5u, -5u); size = (10u, 3u, 10u); surface = skin.dome1; }
        cube dome2 { origin = (-4u, 8u, -4u); size = (8u, 2u, 8u); surface = skin.dome2; }
        cube dome3 { origin = (-2.5u, 10u, -2.5u); size = (5u, 1u, 5u); surface = skin.dome3; }
        cube entrance { origin = (-1.5u, 1u, -7u); size = (3u, 3u, 1u); surface = skin.entrance; }
      }
    }
  }
  export asset stronghold_neutral {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;

    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
