ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube plinth { origin = (-7u, 0u, -7u); size = (14u, 1u, 14u); surface = skin.plinth; }
        cube hall { origin = (-6u, 1u, -4u); size = (12u, 6u, 9u); surface = skin.hall; }
        cube tooth0 { origin = (-6u, 5u, -3.5u); size = (4u, 4u, 8u); rotation = (0deg, 0deg, 45deg); pivot = (-4u, 7u, 0.5u); surface = skin.tooth0; }
        cube tooth1 { origin = (-2u, 5u, -3.5u); size = (4u, 4u, 8u); rotation = (0deg, 0deg, 45deg); pivot = (0u, 7u, 0.5u); surface = skin.tooth1; }
        cube tooth2 { origin = (2u, 5u, -3.5u); size = (4u, 4u, 8u); rotation = (0deg, 0deg, 45deg); pivot = (4u, 7u, 0.5u); surface = skin.tooth2; }
        cube chimney { origin = (4u, 1u, 4u); size = (2u, 11u, 2u); surface = skin.chimney; }
        cube chimney_cap { origin = (3.5u, 12u, 3.5u); size = (3u, 1u, 3u); surface = skin.chimney_cap; }
      }
    }
  }
}
