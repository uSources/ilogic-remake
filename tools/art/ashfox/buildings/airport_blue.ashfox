ashfox-model 1
asset airport_blue {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint radar { parent = body; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind radar { parent-origin = (-4.5u, 15u, -4.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 2.4s; fps = 20; loop = loop; rest-relative = true;
    track radar.rotation {
      key 0s = (0deg, 0deg, 0deg) step;
      key 0.3s = (0deg, 22.5deg, 0deg) step;
      key 0.6s = (0deg, 45deg, 0deg) step;
      key 0.9s = (0deg, 67.5deg, 0deg) step;
      key 1.2s = (0deg, 90deg, 0deg) step;
      key 1.5s = (0deg, 112.5deg, 0deg) step;
      key 1.8s = (0deg, 135deg, 0deg) step;
      key 2.1s = (0deg, 157.5deg, 0deg) step;
      key 2.4s = (0deg, 0deg, 0deg) step;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart runway box { width = 56px; height = 15px; coverage = opaque; }
    chart tower box { width = 16px; height = 13px; coverage = opaque; }
    chart cab box { width = 20px; height = 8px; coverage = opaque; }
    chart cab_roof box { width = 20px; height = 6px; coverage = opaque; }
    chart cab_top box { width = 12px; height = 4px; coverage = opaque; }
    chart radar_dish box { width = 10px; height = 2px; coverage = opaque; }
    chart hangar box { width = 32px; height = 12px; coverage = opaque; }
    chart hangar_roof box { width = 28px; height = 9px; coverage = opaque; }
    chart hangar_ridge box { width = 24px; height = 9px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = asphalt; background-alpha = 255;
      palette {
        asphalt = (#1c2028, #2a2e38, #3c4250);
        dashes_w = #f2f5ff;
        body_blue = (#1a8ea2, #1f9fb4, #2cb0c4);
        rim_body_blue_4_r = #6ad8e4;
        window_glass = (#8ad4f4, #9fe3ff, #b8ecff);
        trim_blue = (#126c7e, #16788a, #1f889a);
        metal = (#4e5666, #8a93a6, #c3cbd9);
        rim_body_blue_8_r = #6ad8e4;
        hangar_door_k = #14202c;
      }
      stamp dashes { pixels = "ww..ww..ww"; w = dashes_w; }
      stamp rim_body_blue_4 { pixels = "rrrr"; r = rim_body_blue_4_r; }
      stamp rim_body_blue_8 { pixels = "rrrrrrrr"; r = rim_body_blue_8_r; }
      stamp hangar_door { pixels = ".kkkkkk./.kkkkkk./.kkkkkk."; k = hangar_door_k; }
      chart runway box {
        origin = (0px, 0px); fill = asphalt;
        face up { stamp dashes { at = (2px, 11px); } }
      }
      chart tower box {
        origin = (0px, 16px); fill = body_blue;
        face north { stamp rim_body_blue_4 { at = (0px, 0px); } }
        face south { stamp rim_body_blue_4 { at = (0px, 0px); } }
        face east { stamp rim_body_blue_4 { at = (0px, 0px); } }
        face west { stamp rim_body_blue_4 { at = (0px, 0px); } }
      }
      chart cab box {
        origin = (0px, 40px); fill = window_glass;
      }
      chart cab_roof box {
        origin = (21px, 40px); fill = trim_blue;
      }
      chart cab_top box {
        origin = (42px, 40px); fill = trim_blue;
      }
      chart radar_dish box {
        origin = (0px, 49px); fill = metal;
      }
      chart hangar box {
        origin = (17px, 16px); fill = body_blue;
        face north { stamp rim_body_blue_8 { at = (0px, 0px); } stamp hangar_door { at = (0px, 1px); } }
        face south { stamp rim_body_blue_8 { at = (0px, 0px); } }
        face east { stamp rim_body_blue_8 { at = (0px, 0px); } }
        face west { stamp rim_body_blue_8 { at = (0px, 0px); } }
      }
      chart hangar_roof box {
        origin = (0px, 30px); fill = body_blue;
      }
      chart hangar_ridge box {
        origin = (29px, 30px); fill = trim_blue;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    bind bone radar to skeleton.radar;
    geometry {
      bone body {
        cube runway { origin = (-7u, 0u, -7u); size = (14u, 1u, 14u); surface = skin.runway; }
        cube tower { origin = (-6.5u, 1u, -6.5u); size = (4u, 9u, 4u); surface = skin.tower; }
        cube cab { origin = (-7u, 10u, -7u); size = (5u, 3u, 5u); surface = skin.cab; }
        cube cab_roof { origin = (-7u, 13u, -7u); size = (5u, 1u, 5u); surface = skin.cab_roof; }
        cube cab_top { origin = (-6u, 14u, -6u); size = (3u, 1u, 3u); surface = skin.cab_top; }
        cube hangar { origin = (-1.5u, 1u, -6u); size = (8u, 4u, 8u); surface = skin.hangar; }
        cube hangar_roof { origin = (-0.5u, 5u, -6u); size = (6u, 1u, 8u); surface = skin.hangar_roof; }
        cube hangar_ridge { origin = (0.5u, 6u, -6u); size = (4u, 1u, 8u); surface = skin.hangar_ridge; }
        bone radar {
          cube radar_dish { origin = (-6.5u, 15u, -5u); size = (4u, 1u, 1u); surface = skin.radar_dish; }
        }
      }
    }
  }
  export asset airport_blue {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
