    chart parapet box { width = 80px; height = 22px; coverage = opaque; }
    chart roof box { width = 72px; height = 19px; coverage = opaque; }
    chart air_unit_0 box { width = 14px; height = 5px; coverage = opaque; }
    chart air_unit_1 box { width = 14px; height = 5px; coverage = opaque; }
    chart water_tank box { width = 20px; height = 10px; coverage = opaque; }
    chart antenna box { width = 4px; height = 10px; coverage = opaque; }
    chart antenna_light box { width = 4px; height = 2px; coverage = opaque; }
    chart planter_left_pot box { width = 16px; height = 6px; coverage = opaque; }
    chart planter_left_bush box { width = 20px; height = 9px; coverage = opaque; }
    chart planter_right_pot box { width = 16px; height = 6px; coverage = opaque; }
    chart planter_right_bush box { width = 20px; height = 9px; coverage = opaque; }
