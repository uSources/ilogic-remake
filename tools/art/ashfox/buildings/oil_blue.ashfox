ashfox-model 1
asset oil_blue {
  import "./oil_blue/rig.ashfox" as rig;
  import "./oil_blue/paint.ashfox" as paint;
  import "./oil_blue/body.ashfox" as body;
  export asset oil_blue {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;
    motion = rig.idle;
    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
