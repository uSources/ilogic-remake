ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = asphalt; background-alpha = 255;
      palette {
        asphalt = (#1c2028, #2a2e38, #3c4250);
        dashes_w = #f2f5ff;
        body_red = (#a42424, #b8282a, #c8383a);
        rim_body_red_4_r = #ee6a60;
        window_glass = (#8ad4f4, #9fe3ff, #b8ecff);
        trim_red = (#741416, #86181a, #962420);
        metal = (#4e5666, #8a93a6, #c3cbd9);
        rim_body_red_8_r = #ee6a60;
        hangar_door_k = #14202c;
      }
      stamp dashes { pixels = "ww..ww..ww"; w = dashes_w; }
      stamp rim_body_red_4 { pixels = "rrrr"; r = rim_body_red_4_r; }
      stamp rim_body_red_8 { pixels = "rrrrrrrr"; r = rim_body_red_8_r; }
      stamp hangar_door { pixels = ".kkkkkk./.kkkkkk./.kkkkkk."; k = hangar_door_k; }
      chart runway box { origin = (0px, 0px); fill = asphalt; face up { stamp dashes { at = (2px, 11px); } } }
      chart tower box { origin = (0px, 16px); fill = body_red; face north { stamp rim_body_red_4 { at = (0px, 0px); } } face south { stamp rim_body_red_4 { at = (0px, 0px); } } face east { stamp rim_body_red_4 { at = (0px, 0px); } } face west { stamp rim_body_red_4 { at = (0px, 0px); } } }
      chart cab box { origin = (0px, 40px); fill = window_glass; }
      chart cab_roof box { origin = (21px, 40px); fill = trim_red; }
      chart cab_top box { origin = (42px, 40px); fill = trim_red; }
      chart radar_dish box { origin = (0px, 49px); fill = metal; }
      chart hangar box { origin = (17px, 16px); fill = body_red; face north { stamp rim_body_red_8 { at = (0px, 0px); } stamp hangar_door { at = (0px, 1px); } } face south { stamp rim_body_red_8 { at = (0px, 0px); } } face east { stamp rim_body_red_8 { at = (0px, 0px); } } face west { stamp rim_body_red_8 { at = (0px, 0px); } } }
      chart hangar_roof box { origin = (0px, 30px); fill = body_red; }
      chart hangar_ridge box { origin = (29px, 30px); fill = trim_red; }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
