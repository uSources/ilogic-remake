ashfox-model 1
asset airport_neutral {
  import "./airport_neutral/rig.ashfox" as rig;
  import "./airport_neutral/paint.ashfox" as paint;
  import "./airport_neutral/body.ashfox" as body;
  export asset airport_neutral {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;
    motion = rig.idle;
    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
