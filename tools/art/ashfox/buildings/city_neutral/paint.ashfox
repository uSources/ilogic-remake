      chart air_unit_1 box { origin = (113px, 121px); fill = metal; face north { stamp air_grille { at = (0px, 0px); } } }
      chart water_tank box { origin = (78px, 101px); fill = trunk; face north { stamp tank_hoops { at = (0px, 1px); } } }
      chart antenna box { origin = (99px, 101px); fill = metal; }
      chart antenna_light box { origin = (13px, 131px); fill = warhead; }
      chart planter_left_pot box { origin = (31px, 121px); fill = brick; }
      chart planter_left_bush box { origin = (104px, 101px); fill = leaf; pattern blotch { paint = leaf_spots; scale = (2px, 2px, 2px); density = 0.25ratio; phase = 7; } }
      chart planter_right_pot box { origin = (48px, 121px); fill = brick; }
      chart planter_right_bush box { origin = (0px, 121px); fill = leaf; pattern blotch { paint = leaf_spots; scale = (2px, 2px, 2px); density = 0.25ratio; phase = 7; } }
      chart lamp_post box { origin = (73px, 101px); fill = metal; }
      chart lamp_light box { origin = (0px, 131px); fill = lamp; }
      grain clustered { seed = 2013; }
      tone voxel;
