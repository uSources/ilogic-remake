ashfox-model 1
asset stronghold_blue {
rig contract ModelRig {
handedness = right;
frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
joint flag { parent = body; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
}
skeleton ModelSkeleton implements ModelRig {
bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
bind body { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
bind flag { parent-origin = (0.5u, 14u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
}
motion idle for ModelRig {
duration = 1.4s; fps = 20; loop = loop; rest-relative = true;
track flag.rotation {
key 0s = (0deg, 0deg, 0deg) catmullrom;
key 0.35s = (0deg, 22deg, 4deg) catmullrom;
key 0.7s = (0deg, 0deg, 0deg) catmullrom;
key 1.05s = (0deg, -22deg, -4deg) catmullrom;
key 1.4s = (0deg, 0deg, 0deg) catmullrom;
}
}
surface contract Skin {
atlas { width = 64px; height = 128px; }
chart plinth box { width = 56px; height = 15px; coverage = opaque; }
chart ring0 box { width = 52px; height = 16px; coverage = opaque; }
chart ring1 box { width = 48px; height = 15px; coverage = opaque; }
chart ring2 box { width = 40px; height = 12px; coverage = opaque; }
chart ring3 box { width = 32px; height = 9px; coverage = opaque; }
chart ring4 box { width = 24px; height = 7px; coverage = opaque; }
chart entrance box { width = 12px; height = 4px; coverage = opaque; }
chart pole box { width = 4px; height = 5px; coverage = opaque; }
chart flag box { width = 8px; height = 3px; coverage = opaque; }
material = opaque;
}
surface paint: Skin {
material = opaque;
texture atlas {
atlas = (64px, 128px); background = pavement; background-alpha = 255;
palette {
pavement = (#aea896, #b9b2a0, #c4bdaa);
pavement_spots = (#9a958a, #a8a290, #b0aa9a);
body_blue = (#1a8ea2, #1f9fb4, #2cb0c4);
rim_body_blue_13_r = #6ad8e4;
rim_body_blue_12_r = #6ad8e4;
slits_k = #14202c;
trim_blue = (#126c7e, #16788a, #1f889a);
rim_trim_blue_5_r = #2fb4c6;
rim_trim_blue_1_r = #2fb4c6;
door_d = #14202c;
metal = (#4e5666, #8a93a6, #c3cbd9);
}
stamp rim_body_blue_13 { pixels = "rrrrrrrrrrrrr"; r = rim_body_blue_13_r; }
stamp rim_body_blue_12 { pixels = "rrrrrrrrrrrr"; r = rim_body_blue_12_r; }
stamp slits { pixels = ".kkk....kkk."; k = slits_k; }
stamp rim_trim_blue_5 { pixels = "rrrrr"; r = rim_trim_blue_5_r; }
stamp rim_trim_blue_1 { pixels = "r"; r = rim_trim_blue_1_r; }
stamp door { pixels = "ddd/ddd/ddd"; d = door_d; }
chart plinth box { origin = (0px, 17px); fill = pavement; pattern blotch { paint = pavement_spots; scale = (2px, 1px, 2px); density = 0.1ratio; phase = 7; } }
chart ring0 box { origin = (0px, 0px); fill = body_blue; face north { stamp rim_body_blue_13 { at = (0px, 0px); } } face south { stamp rim_body_blue_13 { at = (0px, 0px); } } face east { stamp rim_body_blue_13 { at = (0px, 0px); } } face west { stamp rim_body_blue_13 { at = (0px, 0px); } } }
chart ring1 box { origin = (0px, 33px); fill = body_blue; face north { stamp rim_body_blue_12 { at = (0px, 0px); } stamp slits { at = (0px, 1px); } } face south { stamp rim_body_blue_12 { at = (0px, 0px); } } face east { stamp rim_body_blue_12 { at = (0px, 0px); } } face west { stamp rim_body_blue_12 { at = (0px, 0px); } } }
chart ring2 box { origin = (0px, 49px); fill = body_blue; }
chart ring3 box { origin = (0px, 62px); fill = body_blue; }
chart ring4 box { origin = (33px, 62px); fill = body_blue; }
chart entrance box { origin = (0px, 72px); fill = trim_blue; face north { stamp rim_trim_blue_5 { at = (0px, 0px); } stamp door { at = (1px, 0px); } } face south { stamp rim_trim_blue_5 { at = (0px, 0px); } } face east { stamp rim_trim_blue_1 { at = (0px, 0px); } } face west { stamp rim_trim_blue_1 { at = (0px, 0px); } } }
chart pole box { origin = (58px, 62px); fill = metal; }
chart flag box { origin = (13px, 72px); fill = body_blue; }
grain clustered { seed = 2013; }
tone voxel;
}
}
component Body {
requires rig skeleton: ModelRig;
requires surface skin: Skin;
bind bone body to skeleton.body;
bind bone flag to skeleton.flag;
geometry {
bone body {
cube plinth { origin = (-7u, 0u, -7u); size = (14u, 1u, 14u); surface = skin.plinth; }
cube ring0 { origin = (-6.5u, 1u, -6.5u); size = (13u, 3u, 13u); surface = skin.ring0; }
cube ring1 { origin = (-6u, 4u, -6u); size = (12u, 3u, 12u); surface = skin.ring1; }
cube ring2 { origin = (-5u, 7u, -5u); size = (10u, 2u, 10u); surface = skin.ring2; }
cube ring3 { origin = (-4u, 9u, -4u); size = (8u, 1u, 8u); surface = skin.ring3; }
cube ring4 { origin = (-3u, 10u, -3u); size = (6u, 1u, 6u); surface = skin.ring4; }
cube entrance { origin = (-2.5u, 1u, -7.5u); size = (5u, 3u, 1u); surface = skin.entrance; }
cube pole { origin = (-0.5u, 11u, -0.5u); size = (1u, 4u, 1u); surface = skin.pole; }
bone flag {
cube flag { origin = (0.5u, 13u, -0.5u); size = (3u, 2u, 1u); surface = skin.flag; }
}
}
}
}
export asset stronghold_blue {
settings { density = 16; forward = north; }
skeleton = ModelSkeleton;
motion = idle;
use Body as model { bind skeleton = ModelRig; bind skin = paint; };
}
}
