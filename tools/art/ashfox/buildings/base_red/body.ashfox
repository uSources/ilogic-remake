ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    bind bone flag to skeleton.flag;
    bind bone radar to skeleton.radar;
    geometry {
      bone body {
        cube platform { origin = (-14u, 2u, -12u); size = (28u, 3u, 24u); surface = skin.platform; }
        cube tall { origin = (-12u, 5u, -6u); size = (10u, 24u, 10u); surface = skin.tall; }
        cube tall_roof { origin = (-12.5u, 29u, -6.5u); size = (11u, 1u, 11u); surface = skin.tall_roof; }
        cube short { origin = (2u, 5u, -4u); size = (10u, 14u, 10u); surface = skin.short; }
        cube short_roof { origin = (1.5u, 19u, -4.5u); size = (11u, 1u, 11u); surface = skin.short_roof; }
        cube skybridge { origin = (-2u, 14u, -2u); size = (4u, 4u, 4u); surface = skin.skybridge; }
        cube radar_mast { origin = (6u, 20u, 0u); size = (2u, 3u, 2u); surface = skin.radar_mast; }
        cube antenna { origin = (-10u, 30u, 1u); size = (1u, 8u, 1u); surface = skin.antenna; }
        cube antenna_light { origin = (-10u, 38u, 1u); size = (1u, 1u, 1u); surface = skin.antenna_light; }
        cube guard_box { origin = (6u, 5u, -12u); size = (5u, 6u, 4u); surface = skin.guard_box; }
        cube guard_roof { origin = (5.5u, 11u, -12.5u); size = (6u, 1u, 5u); surface = skin.guard_roof; }
        cube barrier { origin = (-6u, 8u, -14u); size = (12u, 1u, 1u); surface = skin.barrier; }
        cube barrier_post { origin = (5u, 5u, -14u); size = (1u, 4u, 1u); surface = skin.barrier_post; }
        cube base_sandbags_0 { origin = (-14u, 5u, -12u); size = (4u, 3u, 3u); surface = skin.base_sandbags_0; }
        cube base_sandbags_1 { origin = (-10u, 5u, -12u); size = (4u, 3u, 3u); surface = skin.base_sandbags_1; }
        cube flag_pole { origin = (12u, 5u, 8u); size = (1u, 14u, 1u); surface = skin.flag_pole; }
        cube flag_ball { origin = (11.5u, 19u, 7.5u); size = (2u, 1u, 2u); surface = skin.flag_ball; }
        bone flag {
          cube flag_cloth { origin = (13u, 14u, 8u); size = (7u, 4u, 1u); surface = skin.flag_cloth; }
        }
        bone radar {
          cube radar_dish { origin = (3u, 23u, 0.5u); size = (8u, 4u, 1u); surface = skin.radar_dish; }
        }
      }
    }
  }
}
