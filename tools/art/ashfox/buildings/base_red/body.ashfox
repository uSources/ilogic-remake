ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    bind bone flag to skeleton.flag;
    bind bone radar to skeleton.radar;
    geometry {
      bone body {
        cube platform { origin = (-7u, 0u, -7u); size = (14u, 3u, 14u); surface = skin.platform; }
        cube tall { origin = (-6u, 3u, -3u); size = (5u, 13u, 5u); surface = skin.tall; }
        cube short { origin = (1u, 3u, -1u); size = (5u, 9u, 5u); surface = skin.short; }
        cube antenna { origin = (-4u, 16u, -1u); size = (1u, 3u, 1u); surface = skin.antenna; }
        cube gate { origin = (-1.5u, 3u, -6u); size = (3u, 2u, 1u); surface = skin.gate; }
        cube radar_post { origin = (3u, 12u, 1u); size = (1u, 1u, 1u); surface = skin.radar_post; }
        bone flag {
          cube flag { origin = (-3u, 17u, -0.5u); size = (3u, 2u, 1u); surface = skin.flag; }
        }
        bone radar {
          cube radar_dish { origin = (1.5u, 13u, 1u); size = (4u, 2u, 1u); surface = skin.radar_dish; }
        }
      }
    }
  }
}
