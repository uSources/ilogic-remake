ashfox-model 1
asset base_blue {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint flag { parent = body; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint radar { parent = body; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind flag { parent-origin = (-3u, 18u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind radar { parent-origin = (3.5u, 13u, 1.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 2.4s; fps = 20; loop = loop; rest-relative = true;
    track flag.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.6s = (0deg, 22deg, 4deg) catmullrom;
      key 1.2s = (0deg, 0deg, 0deg) catmullrom;
      key 1.8s = (0deg, -22deg, -4deg) catmullrom;
      key 2.4s = (0deg, 0deg, 0deg) catmullrom;
    }
    track radar.rotation {
      key 0s = (0deg, 0deg, 0deg) step;
      key 0.3s = (0deg, 22.5deg, 0deg) step;
      key 0.6s = (0deg, 45deg, 0deg) step;
      key 0.9s = (0deg, 67.5deg, 0deg) step;
      key 1.2s = (0deg, 90deg, 0deg) step;
      key 1.5s = (0deg, 112.5deg, 0deg) step;
      key 1.8s = (0deg, 135deg, 0deg) step;
      key 2.1s = (0deg, 157.5deg, 0deg) step;
      key 2.4s = (0deg, 0deg, 0deg) step;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart platform box { width = 56px; height = 17px; coverage = opaque; }
    chart tall box { width = 20px; height = 18px; coverage = opaque; }
    chart short box { width = 20px; height = 14px; coverage = opaque; }
    chart antenna box { width = 4px; height = 4px; coverage = opaque; }
    chart flag box { width = 8px; height = 3px; coverage = opaque; }
    chart gate box { width = 8px; height = 3px; coverage = opaque; }
    chart radar_post box { width = 4px; height = 2px; coverage = opaque; }
    chart radar_dish box { width = 10px; height = 3px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = trim_blue; background-alpha = 255;
      palette {
        trim_blue = (#126c7e, #16788a, #1f889a);
        rim_trim_blue_14_r = #2fb4c6;
        body_blue = (#1a8ea2, #1f9fb4, #2cb0c4);
        rim_body_blue_5_r = #6ad8e4;
        tall_windows_w = #14202c;
        tall_windows_l = #ffe08a;
        short_windows_w = #14202c;
        short_windows_l = #ffe08a;
        metal = (#4e5666, #8a93a6, #c3cbd9);
        asphalt = (#1c2028, #2a2e38, #3c4250);
      }
      stamp rim_trim_blue_14 { pixels = "rrrrrrrrrrrrrr"; r = rim_trim_blue_14_r; }
      stamp rim_body_blue_5 { pixels = "rrrrr"; r = rim_body_blue_5_r; }
      stamp tall_windows { pixels = "www/.../wlw/.../www/.../lww/.../www"; w = tall_windows_w; l = tall_windows_l; }
      stamp short_windows { pixels = "www/.../wwl/.../www"; w = short_windows_w; l = short_windows_l; }
      chart platform box {
        origin = (0px, 19px); fill = trim_blue;
        face north { stamp rim_trim_blue_14 { at = (0px, 0px); } }
        face south { stamp rim_trim_blue_14 { at = (0px, 0px); } }
        face east { stamp rim_trim_blue_14 { at = (0px, 0px); } }
        face west { stamp rim_trim_blue_14 { at = (0px, 0px); } }
      }
      chart tall box {
        origin = (0px, 0px); fill = body_blue;
        face north { stamp rim_body_blue_5 { at = (0px, 0px); } stamp tall_windows { at = (1px, 2px); } }
        face south { stamp rim_body_blue_5 { at = (0px, 0px); } }
        face east { stamp rim_body_blue_5 { at = (0px, 0px); } }
        face west { stamp rim_body_blue_5 { at = (0px, 0px); } }
      }
      chart short box {
        origin = (0px, 37px); fill = body_blue;
        face north { stamp rim_body_blue_5 { at = (0px, 0px); } stamp short_windows { at = (1px, 2px); } }
        face south { stamp rim_body_blue_5 { at = (0px, 0px); } }
        face east { stamp rim_body_blue_5 { at = (0px, 0px); } }
        face west { stamp rim_body_blue_5 { at = (0px, 0px); } }
      }
      chart antenna box {
        origin = (21px, 37px); fill = metal;
      }
      chart flag box {
        origin = (26px, 37px); fill = body_blue;
      }
      chart gate box {
        origin = (35px, 37px); fill = asphalt;
      }
      chart radar_post box {
        origin = (55px, 37px); fill = metal;
      }
      chart radar_dish box {
        origin = (44px, 37px); fill = metal;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    bind bone flag to skeleton.flag;
    bind bone radar to skeleton.radar;
    geometry {
      bone body {
        cube platform { origin = (-7u, 0u, -7u); size = (14u, 3u, 14u); surface = skin.platform; }
        cube tall { origin = (-6u, 3u, -3u); size = (5u, 13u, 5u); surface = skin.tall; }
        cube short { origin = (1u, 3u, -1u); size = (5u, 9u, 5u); surface = skin.short; }
        cube antenna { origin = (-4u, 16u, -1u); size = (1u, 3u, 1u); surface = skin.antenna; }
        cube gate { origin = (-1.5u, 3u, -6u); size = (3u, 2u, 1u); surface = skin.gate; }
        cube radar_post { origin = (3u, 12u, 1u); size = (1u, 1u, 1u); surface = skin.radar_post; }
        bone flag {
          cube flag { origin = (-3u, 17u, -0.5u); size = (3u, 2u, 1u); surface = skin.flag; }
        }
        bone radar {
          cube radar_dish { origin = (1.5u, 13u, 1u); size = (4u, 2u, 1u); surface = skin.radar_dish; }
        }
      }
    }
  }
  export asset base_blue {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
