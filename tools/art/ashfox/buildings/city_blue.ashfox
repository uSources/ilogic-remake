ashfox-model 1
asset city_blue {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }

  surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart plinth box { width = 56px; height = 15px; coverage = opaque; }
    chart tower box { width = 32px; height = 21px; coverage = opaque; }
    chart roof box { width = 36px; height = 10px; coverage = opaque; }
    chart annex box { width = 18px; height = 11px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = pavement; background-alpha = 255;
      palette {
        pavement = (#8a857a, #b9b2a0, #d6cfbd);
        pavement_spots = (#7a756a, #9a958a, #b0aa9a);
        body_blue = (#0f5a6e, #1f9fb4, #5fd6e0);
        front_windows_w = #14202c;
        front_windows_l = #ffe08a;
        side_windows_w = #14202c;
        side_windows_l = #ffe08a;
        door_d = #14202c;
        trim_blue = (#0a3c4c, #16788a, #2fb4c6);
      }
      stamp front_windows { pixels = "w.w.l.w./......../w.l.w.w./......../w.w.w.l./......../l.w.w.w./......../w.w.l.w."; w = front_windows_w; l = front_windows_l; }
      stamp side_windows { pixels = "w.w.l.w./......../w.l.w.w./......../w.w.w.l./......../l.w.w.w./......../w.w.l.w."; w = side_windows_w; l = side_windows_l; }
      stamp door { pixels = "dd/dd/dd"; d = door_d; }
      chart plinth box {
        origin = (0px, 22px); fill = pavement;
        pattern blotch { paint = pavement_spots; scale = (2px, 1px, 2px); density = 0.15ratio; phase = 7; }
      }
      chart tower box {
        origin = (0px, 0px); fill = body_blue;
        face north { stamp front_windows { at = (0px, 1px); } stamp door { at = (3px, 10px); } }
        face east { stamp side_windows { at = (0px, 1px); } }
      }
      chart roof box {
        origin = (19px, 38px); fill = trim_blue;
      }
      chart annex box {
        origin = (0px, 38px); fill = trim_blue;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    geometry {
      bone body {
        cube plinth { origin = (-7u, 0u, -7u); size = (14u, 1u, 14u); surface = skin.plinth; }
        cube tower { origin = (-4u, 1u, -4u); size = (8u, 13u, 8u); surface = skin.tower; }
        cube roof { origin = (-4.5u, 14u, -4.5u); size = (9u, 1u, 9u); surface = skin.roof; }
        cube annex { origin = (4u, 1u, -2u); size = (3u, 5u, 6u); surface = skin.annex; }
      }
    }
  }
  export asset city_blue {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;

    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
