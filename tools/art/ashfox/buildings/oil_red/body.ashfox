ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    bind bone pump to skeleton.pump;
    geometry {
      bone body {
        cube plinth { origin = (-7u, 0u, -7u); size = (14u, 1u, 14u); surface = skin.plinth; }
        cube deck { origin = (-6u, 1u, -4u); size = (12u, 2u, 8u); surface = skin.deck; }
        cube leg_left { origin = (-5u, 3u, -1u); size = (2u, 8u, 2u); surface = skin.leg_left; }
        cube leg_right { origin = (3u, 3u, -1u); size = (2u, 8u, 2u); surface = skin.leg_right; }
        cube drill { origin = (-1u, 3u, -0.5u); size = (2u, 8u, 1u); surface = skin.drill; }
        bone pump {
          cube beam { origin = (-6u, 11u, -2u); size = (12u, 2u, 4u); surface = skin.beam; }
          cube cap { origin = (-1.5u, 13u, -1.5u); size = (3u, 2u, 3u); surface = skin.cap; }
        }
      }
    }
  }
}
