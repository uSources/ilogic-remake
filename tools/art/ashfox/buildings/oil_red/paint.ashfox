ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (128px, 128px); background = pavement; background-alpha = 255;
      palette {
        pavement = (#aea896, #b9b2a0, #c4bdaa);
        pavement_spots = (#9a958a, #a8a290, #b0aa9a);
        curb28_k = #7a7468;
        oil_black = (#14161c, #1c1f27, #262a34);
        skid_stripes_y = #e8c020;
        skid_stripes_k = #1a1e28;
        trim_red = (#741416, #86181a, #962420);
        metal = (#4e5666, #8a93a6, #c3cbd9);
        gun = (#2a2e38, #343a46, #3e4554);
        body_red = (#a42424, #b8282a, #c8383a);
        beam_rivets_r = #741416;
        rim_body_red_4_r = #ee6a60;
        head_face_k = #741416;
        rim_trim_red_1_r = #c23a36;
        rim_trim_red_3_r = #c23a36;
        rim_trim_red_6_r = #c23a36;
        rim_trim_red_5_r = #c23a36;
        gearbox_plate_h = #c3cbd9;
        weight_stripe_y = #e8c020;
        motor_fins_k = #3a4050;
        warhead = (#c02830, #d8323a, #e8484e);
        rim_body_red_12_r = #ee6a60;
        rim_body_red_8_r = #ee6a60;
        tank_band_k = #741416;
        ladder_rungs_k = #3a4050;
        barrel_band_k = #3a3a3a;
      }
      stamp curb28 { pixels = "kkkkkkkkkkkkkkkkkkkkkkkkkkkk"; k = curb28_k; }
      stamp skid_stripes { pixels = "yyykkkyyykkkyyykkkyyykkkyyy/yykkkyyykkkyyykkkyyykkkyyyk"; y = skid_stripes_y; k = skid_stripes_k; }
      stamp beam_rivets { pixels = ".r....r....r....r....r.."; r = beam_rivets_r; }
      stamp rim_body_red_4 { pixels = "rrrr"; r = rim_body_red_4_r; }
      stamp head_face { pixels = "kkkk"; k = head_face_k; }
      stamp rim_trim_red_1 { pixels = "r"; r = rim_trim_red_1_r; }
      stamp rim_trim_red_3 { pixels = "rrr"; r = rim_trim_red_3_r; }
      stamp rim_trim_red_6 { pixels = "rrrrrr"; r = rim_trim_red_6_r; }
      stamp rim_trim_red_5 { pixels = "rrrrr"; r = rim_trim_red_5_r; }
      stamp gearbox_plate { pixels = "hh/hh"; h = gearbox_plate_h; }
      stamp weight_stripe { pixels = "yyyyyy"; y = weight_stripe_y; }
      stamp motor_fins { pixels = "k.k./k.k."; k = motor_fins_k; }
      stamp rim_body_red_12 { pixels = "rrrrrrrrrrrr"; r = rim_body_red_12_r; }
      stamp rim_body_red_8 { pixels = "rrrrrrrr"; r = rim_body_red_8_r; }
      stamp tank_band { pixels = "kkkkkkkkkkkk"; k = tank_band_k; }
      stamp ladder_rungs { pixels = "kk/../kk/../kk/../kk/../kk/../kk/.."; k = ladder_rungs_k; }
      stamp barrel_band { pixels = "kkk/.../kkk"; k = barrel_band_k; }
      chart plinth box { origin = (0px, 0px); fill = pavement; pattern blotch { paint = pavement_spots; scale = (2px, 1px, 2px); density = 0.1ratio; phase = 7; } face north { stamp curb28 { at = (0px, 1px); } } face south { stamp curb28 { at = (0px, 1px); } } face east { stamp curb28 { at = (0px, 1px); } } face west { stamp curb28 { at = (0px, 1px); } } }
      chart skid box { origin = (0px, 90px); fill = oil_black; face north { stamp skid_stripes { at = (0px, 0px); } } }
      chart samson_front_left box { origin = (82px, 31px); fill = trim_red; }
      chart samson_front_right box { origin = (0px, 56px); fill = trim_red; }
      chart samson_back_left box { origin = (37px, 56px); fill = trim_red; }
      chart samson_back_right box { origin = (74px, 56px); fill = trim_red; }
      chart samson_saddle box { origin = (101px, 101px); fill = metal; }
      chart samson_bearing box { origin = (0px, 110px); fill = metal; }
      chart equalizer box { origin = (80px, 90px); fill = metal; }
      chart pitman_front box { origin = (30px, 75px); fill = gun; }
      chart pitman_back box { origin = (35px, 75px); fill = gun; }
      chart walking_beam box { origin = (17px, 110px); fill = body_red; face north { stamp beam_rivets { at = (0px, 1px); } } face south { stamp beam_rivets { at = (0px, 1px); } } }
      chart horse_head box { origin = (111px, 56px); fill = body_red; face north { stamp rim_body_red_4 { at = (0px, 0px); } } face south { stamp rim_body_red_4 { at = (0px, 0px); } } face east { stamp rim_body_red_4 { at = (0px, 0px); } } face west { stamp rim_body_red_4 { at = (0px, 0px); } stamp head_face { at = (0px, 0px); } } }
      chart horse_head_tip box { origin = (71px, 90px); fill = trim_red; face north { stamp rim_trim_red_1 { at = (0px, 0px); } } face south { stamp rim_trim_red_1 { at = (0px, 0px); } } face east { stamp rim_trim_red_3 { at = (0px, 0px); } } face west { stamp rim_trim_red_3 { at = (0px, 0px); } } }
      chart bridle box { origin = (40px, 75px); fill = gun; }
      chart gearbox box { origin = (7px, 75px); fill = trim_red; face north { stamp rim_trim_red_6 { at = (0px, 0px); } stamp gearbox_plate { at = (2px, 2px); } } face south { stamp rim_trim_red_6 { at = (0px, 0px); } } face east { stamp rim_trim_red_5 { at = (0px, 0px); } } face west { stamp rim_trim_red_5 { at = (0px, 0px); } } }
      chart counterweight_front box { origin = (101px, 90px); fill = oil_black; face north { stamp weight_stripe { at = (0px, 0px); } } }
      chart counterweight_back box { origin = (0px, 101px); fill = oil_black; face south { stamp weight_stripe { at = (0px, 0px); } } }
      chart crank_hub_front box { origin = (102px, 110px); fill = metal; }
      chart crank_hub_back box { origin = (109px, 110px); fill = metal; }
      chart motor box { origin = (15px, 101px); fill = metal; face east { stamp motor_fins { at = (0px, 1px); } } }
      chart wellhead box { origin = (34px, 101px); fill = metal; }
      chart wellhead_valve box { origin = (74px, 110px); fill = warhead; }
      chart tank box { origin = (41px, 31px); fill = body_red; face north { stamp rim_body_red_12 { at = (0px, 0px); } stamp tank_band { at = (0px, 3px); } } face south { stamp rim_body_red_12 { at = (0px, 0px); } stamp tank_band { at = (0px, 3px); } } face east { stamp rim_body_red_8 { at = (0px, 0px); } } face west { stamp rim_body_red_8 { at = (0px, 0px); } } }
      chart tank_round box { origin = (0px, 31px); fill = body_red; face north { stamp rim_body_red_8 { at = (0px, 0px); } } face south { stamp rim_body_red_8 { at = (0px, 0px); } } face east { stamp rim_body_red_12 { at = (0px, 0px); } } face west { stamp rim_body_red_12 { at = (0px, 0px); } } }
      chart tank_top box { origin = (45px, 75px); fill = trim_red; }
      chart tank_ladder box { origin = (0px, 75px); fill = metal; face east { stamp ladder_rungs { at = (0px, 0px); } } }
      chart pipe_to_tank box { origin = (86px, 101px); fill = gun; }
      chart pipe_along box { origin = (91px, 110px); fill = gun; }
      chart barrel_0 box { origin = (47px, 101px); fill = oil_black; face north { stamp barrel_band { at = (0px, 1px); } } }
      chart barrel_1 box { origin = (60px, 101px); fill = warhead; face north { stamp barrel_band { at = (0px, 1px); } } }
      chart barrel_2 box { origin = (73px, 101px); fill = oil_black; face north { stamp barrel_band { at = (0px, 1px); } } }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
