ashfox-model 1
module rig {
  export rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint pump { parent = body; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  export skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind pump { parent-origin = (0u, 12u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  export motion idle for ModelRig {
    duration = 2s; fps = 20; loop = loop; rest-relative = true;
    track pump.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.5s = (0deg, 0deg, 9deg) catmullrom;
      key 1s = (0deg, 0deg, 0deg) catmullrom;
      key 1.5s = (0deg, 0deg, -9deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
}
