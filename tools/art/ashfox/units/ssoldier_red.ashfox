ashfox-model 1
asset ssoldier_red {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint leg_left { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint leg_right { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint torso { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint head { parent = torso; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint arm_left { parent = torso; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint arm_right { parent = torso; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint gear { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind leg_left { parent-origin = (-1.5u, 5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind leg_right { parent-origin = (1.5u, 5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind torso { parent-origin = (0u, 5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind head { parent-origin = (0u, 4u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind arm_left { parent-origin = (-3.5u, 3.5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind arm_right { parent-origin = (3.5u, 3.5u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind gear { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 1.6s; fps = 20; loop = loop; rest-relative = true;
    track torso.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.4s = (0deg, 4deg, 0deg) catmullrom;
      key 0.8s = (0deg, 0deg, 0deg) catmullrom;
      key 1.2s = (0deg, -4deg, 0deg) catmullrom;
      key 1.6s = (0deg, 0deg, 0deg) catmullrom;
    }
    track head.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.4s = (3deg, 0deg, 2deg) catmullrom;
      key 0.8s = (0deg, 0deg, 0deg) catmullrom;
      key 1.2s = (-3deg, 0deg, -2deg) catmullrom;
      key 1.6s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion drive for ModelRig {
    duration = 0.5s; fps = 20; loop = loop; rest-relative = true;
    track leg_left.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.125s = (30deg, 0deg, 0deg) linear;
      key 0.25s = (0deg, 0deg, 0deg) linear;
      key 0.375s = (-30deg, 0deg, 0deg) linear;
      key 0.5s = (0deg, 0deg, 0deg) linear;
    }
    track leg_right.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.125s = (-30deg, 0deg, 0deg) linear;
      key 0.25s = (0deg, 0deg, 0deg) linear;
      key 0.375s = (30deg, 0deg, 0deg) linear;
      key 0.5s = (0deg, 0deg, 0deg) linear;
    }
    track arm_left.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.125s = (-25deg, 0deg, 0deg) linear;
      key 0.25s = (0deg, 0deg, 0deg) linear;
      key 0.375s = (25deg, 0deg, 0deg) linear;
      key 0.5s = (0deg, 0deg, 0deg) linear;
    }
    track torso.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.125s = (0deg, 0deg, 3deg) linear;
      key 0.25s = (0deg, 0deg, 0deg) linear;
      key 0.375s = (0deg, 0deg, -3deg) linear;
      key 0.5s = (0deg, 0deg, 0deg) linear;
    }
  }
  motion fire for ModelRig {
    duration = 0.4s; fps = 30; loop = once; rest-relative = true;
    track arm_right.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (18deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
    track torso.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (6deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart boot_left box { width = 10px; height = 4px; coverage = opaque; }
    chart leg_left box { width = 8px; height = 6px; coverage = opaque; }
    chart boot_right box { width = 10px; height = 4px; coverage = opaque; }
    chart leg_right box { width = 8px; height = 6px; coverage = opaque; }
    chart torso box { width = 16px; height = 7px; coverage = opaque; }
    chart head box { width = 24px; height = 10px; coverage = opaque; }
    chart helmet box { width = 28px; height = 10px; coverage = opaque; }
    chart helmet_top box { width = 20px; height = 6px; coverage = opaque; }
    chart neck_guard box { width = 16px; height = 3px; coverage = opaque; }
    chart arm_left box { width = 8px; height = 5px; coverage = opaque; }
    chart arm_right box { width = 8px; height = 5px; coverage = opaque; }
    chart shield box { width = 14px; height = 11px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = boot; background-alpha = 255;
      palette {
        boot = (#3a3430, #4c443c, #5e544a);
        dark_red = (#80181a, #962220, #a82c28);
        rim_dark_red_2_r = #c04a40;
        team_red = (#b02824, #c8302a, #d84038);
        rim_team_red_5_r = #f2786c;
        rim_team_red_3_r = #f2786c;
        belt5_x = #5a3a22;
        belt3_x = #5a3a22;
        skin = (#e4b88c, #f1c79b, #f8d4ac);
        eyes_k = #1d2a4a;
        mask_m = #80181a;
        mask_side_m = #80181a;
        rim_team_red_7_r = #f2786c;
        rim_team_red_2_r = #f2786c;
        hand2_x = #f1c79b;
        riot = (#4a505c, #5a606c, #6a707c);
        rim_riot_6_r = #9aa0ac;
        rim_riot_1_r = #9aa0ac;
        visor_g = #2a3a48;
        rivets_r = #8a909c;
      }
      stamp rim_dark_red_2 { pixels = "rr"; r = rim_dark_red_2_r; }
      stamp rim_team_red_5 { pixels = "rrrrr"; r = rim_team_red_5_r; }
      stamp rim_team_red_3 { pixels = "rrr"; r = rim_team_red_3_r; }
      stamp belt5 { pixels = "xxxxx"; x = belt5_x; }
      stamp belt3 { pixels = "xxx"; x = belt3_x; }
      stamp eyes { pixels = "k..k"; k = eyes_k; }
      stamp mask { pixels = "mmmmmm/mmmmmm"; m = mask_m; }
      stamp mask_side { pixels = "mmmmmm/mmmmmm"; m = mask_side_m; }
      stamp rim_team_red_7 { pixels = "rrrrrrr"; r = rim_team_red_7_r; }
      stamp rim_team_red_2 { pixels = "rr"; r = rim_team_red_2_r; }
      stamp hand2 { pixels = "xx"; x = hand2_x; }
      stamp rim_riot_6 { pixels = "rrrrrr"; r = rim_riot_6_r; }
      stamp rim_riot_1 { pixels = "r"; r = rim_riot_1_r; }
      stamp visor { pixels = "gggg/gggg"; g = visor_g; }
      stamp rivets { pixels = "r....r"; r = rivets_r; }
      chart boot_left box {
        origin = (39px, 23px); fill = boot;
      }
      chart leg_left box {
        origin = (46px, 12px); fill = dark_red;
        face north { stamp rim_dark_red_2 { at = (0px, 0px); } }
        face south { stamp rim_dark_red_2 { at = (0px, 0px); } }
        face east { stamp rim_dark_red_2 { at = (0px, 0px); } }
        face west { stamp rim_dark_red_2 { at = (0px, 0px); } }
      }
      chart boot_right box {
        origin = (50px, 23px); fill = boot;
      }
      chart leg_right box {
        origin = (55px, 12px); fill = dark_red;
        face north { stamp rim_dark_red_2 { at = (0px, 0px); } }
        face south { stamp rim_dark_red_2 { at = (0px, 0px); } }
        face east { stamp rim_dark_red_2 { at = (0px, 0px); } }
        face west { stamp rim_dark_red_2 { at = (0px, 0px); } }
      }
      chart torso box {
        origin = (29px, 12px); fill = team_red;
        face north { stamp rim_team_red_5 { at = (0px, 0px); } stamp belt5 { at = (0px, 3px); } }
        face south { stamp rim_team_red_5 { at = (0px, 0px); } stamp belt5 { at = (0px, 3px); } }
        face east { stamp rim_team_red_3 { at = (0px, 0px); } stamp belt3 { at = (0px, 3px); } }
        face west { stamp rim_team_red_3 { at = (0px, 0px); } stamp belt3 { at = (0px, 3px); } }
      }
      chart head box {
        origin = (15px, 0px); fill = skin;
        face north { stamp eyes { at = (1px, 1px); } stamp mask { at = (0px, 2px); } }
        face east { stamp mask_side { at = (0px, 2px); } }
        face west { stamp mask_side { at = (0px, 2px); } }
      }
      chart helmet box {
        origin = (0px, 12px); fill = team_red;
        face north { stamp rim_team_red_7 { at = (0px, 0px); } }
        face south { stamp rim_team_red_7 { at = (0px, 0px); } }
        face east { stamp rim_team_red_7 { at = (0px, 0px); } }
        face west { stamp rim_team_red_7 { at = (0px, 0px); } }
      }
      chart helmet_top box {
        origin = (0px, 23px); fill = team_red;
      }
      chart neck_guard box {
        origin = (0px, 30px); fill = team_red;
      }
      chart arm_left box {
        origin = (21px, 23px); fill = team_red;
        face north { stamp rim_team_red_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } }
        face south { stamp rim_team_red_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } }
        face east { stamp rim_team_red_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } }
        face west { stamp rim_team_red_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } }
      }
      chart arm_right box {
        origin = (30px, 23px); fill = team_red;
        face north { stamp rim_team_red_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } }
        face south { stamp rim_team_red_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } }
        face east { stamp rim_team_red_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } }
        face west { stamp rim_team_red_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } }
      }
      chart shield box {
        origin = (0px, 0px); fill = riot;
        face north { stamp rim_riot_6 { at = (0px, 0px); } stamp visor { at = (1px, 2px); } stamp rivets { at = (0px, 8px); } }
        face south { stamp rim_riot_6 { at = (0px, 0px); } }
        face east { stamp rim_riot_1 { at = (0px, 0px); } }
        face west { stamp rim_riot_1 { at = (0px, 0px); } }
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone leg_left to skeleton.leg_left;
    bind bone leg_right to skeleton.leg_right;
    bind bone torso to skeleton.torso;
    bind bone head to skeleton.head;
    bind bone arm_left to skeleton.arm_left;
    bind bone arm_right to skeleton.arm_right;
    bind bone gear to skeleton.gear;
    geometry {
      bone leg_left {
        cube boot_left { origin = (-2.5u, 0u, -1.5u); size = (2u, 1u, 3u); surface = skin.boot_left; }
        cube leg_left { origin = (-2.5u, 1u, -1u); size = (2u, 4u, 2u); surface = skin.leg_left; }
      }
      bone leg_right {
        cube boot_right { origin = (0.5u, 0u, -1.5u); size = (2u, 1u, 3u); surface = skin.boot_right; }
        cube leg_right { origin = (0.5u, 1u, -1u); size = (2u, 4u, 2u); surface = skin.leg_right; }
      }
      bone torso {
        cube torso { origin = (-2.5u, 5u, -1.5u); size = (5u, 4u, 3u); surface = skin.torso; }
        bone head {
          cube head { origin = (-3u, 9u, -3u); size = (6u, 4u, 6u); surface = skin.head; }
          cube helmet { origin = (-3.5u, 12u, -3.5u); size = (7u, 3u, 7u); surface = skin.helmet; }
          cube helmet_top { origin = (-2.5u, 15u, -2.5u); size = (5u, 1u, 5u); surface = skin.helmet_top; }
          cube neck_guard { origin = (-3.5u, 10u, 2.5u); size = (7u, 2u, 1u); surface = skin.neck_guard; }
        }
        bone arm_left {
          cube arm_left { origin = (-4.5u, 6u, -1u); size = (2u, 3u, 2u); surface = skin.arm_left; }
          cube shield { origin = (-7.5u, 1u, -4.5u); size = (6u, 10u, 1u); surface = skin.shield; }
        }
        bone arm_right {
          cube arm_right { origin = (2.5u, 6u, -1u); size = (2u, 3u, 2u); surface = skin.arm_right; }
        }
      }
      bone gear {
      }
    }
  }
  export asset ssoldier_red {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    motion = drive;
    motion = fire;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
