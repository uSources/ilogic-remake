ashfox-model 1
asset artillery_red {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint chassis { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint hull { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint turret { parent = hull; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint barrel { parent = turret; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind chassis { parent-origin = (0u, 2u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind hull { parent-origin = (0u, 3u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind turret { parent-origin = (0u, 2u, 2u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind barrel { parent-origin = (0u, 2u, -2u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 1.2s; fps = 20; loop = loop; rest-relative = true;
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (0.6deg, 0deg, 0.4deg) catmullrom;
      key 0.6s = (0deg, 0deg, 0deg) catmullrom;
      key 0.9s = (-0.6deg, 0deg, -0.4deg) catmullrom;
      key 1.2s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion drive for ModelRig {
    duration = 0.4s; fps = 20; loop = loop; rest-relative = true;
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.1s = (-2deg, 0deg, 1deg) catmullrom;
      key 0.2s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (2deg, 0deg, -1deg) catmullrom;
      key 0.4s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion fire for ModelRig {
    duration = 0.5s; fps = 30; loop = once; rest-relative = true;
    track barrel.scale {
      key 0s = (1, 1, 1) linear;
      key 0.05s = (1.15, 1.15, 0.6) linear;
      key 0.4s = (1, 1, 1) linear;
    }
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (5deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 128px; }
    chart track0 box { width = 34px; height = 17px; coverage = opaque; }
    chart track1 box { width = 34px; height = 17px; coverage = opaque; }
    chart hull box { width = 38px; height = 13px; coverage = opaque; }
    chart mount box { width = 22px; height = 8px; coverage = opaque; }
    chart barrel box { width = 26px; height = 13px; coverage = opaque; }
    chart gunner_head box { width = 12px; height = 6px; coverage = opaque; }
    chart gunner_helmet box { width = 16px; height = 6px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 128px); background = tread; background-alpha = 255;
      palette {
        tread = (#141824, #262c3c, #3c4458);
        tread_spots = (#3c4458, #5c6474, #7c8494);
        camo_red = (#8a1a1a, #c8302a, #f0605a);
        camo_red_spots = (#601212, #962220, #c84038);
        team_red = (#8a1a1a, #c8302a, #f0605a);
        steel = (#4e5666, #8a93a6, #c3cbd9);
        skin = (#c8946a, #f1c79b, #ffe2c4);
      }

      chart track0 box {
        origin = (0px, 0px); fill = tread;
        pattern blotch { paint = tread_spots; scale = (1px, 1px, 2px); density = 0.3ratio; phase = 7; }
      }
      chart track1 box {
        origin = (0px, 18px); fill = tread;
        pattern blotch { paint = tread_spots; scale = (1px, 1px, 2px); density = 0.3ratio; phase = 7; }
      }
      chart hull box {
        origin = (0px, 36px); fill = camo_red;
        pattern blotch { paint = camo_red_spots; scale = (3px, 2px, 3px); density = 0.25ratio; phase = 7; }
      }
      chart mount box {
        origin = (27px, 50px); fill = team_red;
      }
      chart barrel box {
        origin = (0px, 50px); fill = steel;
      }
      chart gunner_head box {
        origin = (50px, 50px); fill = skin;
      }
      chart gunner_helmet box {
        origin = (0px, 64px); fill = team_red;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone chassis to skeleton.chassis;
    bind bone hull to skeleton.hull;
    bind bone turret to skeleton.turret;
    bind bone barrel to skeleton.barrel;
    geometry {
      bone chassis {
        cube track0 { origin = (-6u, 0u, -6.5u); size = (4u, 4u, 13u); surface = skin.track0; }
        cube track1 { origin = (2u, 0u, -6.5u); size = (4u, 4u, 13u); surface = skin.track1; }
      }
      bone hull {
        cube hull { origin = (-4u, 3u, -5u); size = (8u, 2u, 11u); surface = skin.hull; }
        bone turret {
          cube mount { origin = (-3u, 5u, 0u); size = (6u, 3u, 5u); surface = skin.mount; }
          cube gunner_head { origin = (-1.5u, 8u, 2u); size = (3u, 3u, 3u); surface = skin.gunner_head; }
          cube gunner_helmet { origin = (-2u, 10u, 1.5u); size = (4u, 2u, 4u); surface = skin.gunner_helmet; }
          bone barrel {
            cube barrel { origin = (-1u, 6.5u, -10u); size = (2u, 2u, 11u); rotation = (30deg, 0deg, 0deg); pivot = (0u, 7u, 0u); surface = skin.barrel; }
          }
        }
      }
    }
  }
  export asset artillery_red {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    motion = drive;
    motion = fire;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
