ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        wheels11_s = #5a6272;
        wheels11_t = #363d4c;
        sprocket_s = #6a7282;
        team_blue = (#2766c4, #2f74d6, #3d84e2);
        rim_team_blue_6_r = #6fb0f2;
        rim_team_blue_5_r = #6fb0f2;
        steel = (#7a8394, #8a93a6, #9aa3b6);
        gun = (#2a2e38, #343a46, #3e4554);
      }
      stamp wheels11 { pixels = "ttttttttttt/.ss.ss.ss../.ss.ss.ss../ttttttttttt"; s = wheels11_s; t = wheels11_t; }
      stamp sprocket { pixels = "ss/ss"; s = sprocket_s; }
      stamp rim_team_blue_6 { pixels = "rrrrrr"; r = rim_team_blue_6_r; }
      stamp rim_team_blue_5 { pixels = "rrrrr"; r = rim_team_blue_5_r; }
      chart track0 box { origin = (0px, 0px); fill = tread; face west { stamp wheels11 { at = (0px, 0px); } } face north { stamp sprocket { at = (1px, 1px); } } face south { stamp sprocket { at = (1px, 1px); } } }
      chart track1 box { origin = (31px, 0px); fill = tread; face east { stamp wheels11 { at = (0px, 0px); } } face north { stamp sprocket { at = (1px, 1px); } } face south { stamp sprocket { at = (1px, 1px); } } }
      chart hull box { origin = (0px, 16px); fill = team_blue; }
      chart turret box { origin = (0px, 30px); fill = team_blue; face north { stamp rim_team_blue_6 { at = (0px, 0px); } } face south { stamp rim_team_blue_6 { at = (0px, 0px); } } face east { stamp rim_team_blue_5 { at = (0px, 0px); } } face west { stamp rim_team_blue_5 { at = (0px, 0px); } } }
      chart turret_top box { origin = (38px, 30px); fill = team_blue; }
      chart barrel box { origin = (23px, 30px); fill = steel; }
      chart muzzle box { origin = (53px, 30px); fill = gun; }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
