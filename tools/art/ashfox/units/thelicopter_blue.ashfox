ashfox-model 1
asset thelicopter_blue {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint rotor { parent = body; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 10u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind rotor { parent-origin = (0u, 7u, -1u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 2s; fps = 20; loop = loop; rest-relative = true;
    track body.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.5s = (3deg, 0deg, 5deg) catmullrom;
      key 1s = (0deg, 0deg, 0deg) catmullrom;
      key 1.5s = (-3deg, 0deg, -5deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion drive for ModelRig {
    duration = 1s; fps = 20; loop = loop; rest-relative = true;
    track body.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.25s = (-4deg, 0deg, 6deg) catmullrom;
      key 0.5s = (0deg, 0deg, 0deg) catmullrom;
      key 0.75s = (4deg, 0deg, -6deg) catmullrom;
      key 1s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion fire for ModelRig {
    duration = 0.4s; fps = 30; loop = once; rest-relative = true;
    track body.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (-5deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart cabin box { width = 30px; height = 14px; coverage = opaque; }
    chart bubble box { width = 16px; height = 6px; coverage = opaque; }
    chart boom box { width = 20px; height = 10px; coverage = opaque; }
    chart tail_rotor box { width = 6px; height = 6px; coverage = opaque; }
    chart skid_left box { width = 18px; height = 9px; coverage = opaque; }
    chart skid_right box { width = 18px; height = 9px; coverage = opaque; }
    chart mast box { width = 4px; height = 2px; coverage = opaque; }
    chart blade_a box { width = 38px; height = 2px; coverage = opaque; }
    chart blade_b box { width = 38px; height = 19px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = team_blue; background-alpha = 255;
      palette {
        team_blue = (#1d4fa8, #2f74d6, #5ea8f2);
        glass = (#4f9fc8, #9fe3ff, #e6f8ff);
        dark_blue = (#163a7a, #1f56a8, #3f84d8);
        steel = (#4e5666, #8a93a6, #c3cbd9);
        gun = (#20242e, #3a404e, #5c6474);
      }

      chart cabin box {
        origin = (0px, 20px); fill = team_blue;
      }
      chart bubble box {
        origin = (38px, 35px); fill = glass;
      }
      chart boom box {
        origin = (31px, 20px); fill = dark_blue;
      }
      chart tail_rotor box {
        origin = (55px, 35px); fill = steel;
      }
      chart skid_left box {
        origin = (0px, 35px); fill = gun;
      }
      chart skid_right box {
        origin = (19px, 35px); fill = gun;
      }
      chart mast box {
        origin = (0px, 45px); fill = steel;
      }
      chart blade_a box {
        origin = (5px, 45px); fill = gun;
      }
      chart blade_b box {
        origin = (0px, 0px); fill = gun;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    bind bone rotor to skeleton.rotor;
    geometry {
      bone body {
        cube cabin { origin = (-3.5u, 10u, -5u); size = (7u, 6u, 8u); surface = skin.cabin; }
        cube bubble { origin = (-3u, 11u, -7u); size = (6u, 4u, 2u); surface = skin.bubble; }
        cube boom { origin = (-1u, 13u, 3u); size = (2u, 2u, 8u); surface = skin.boom; }
        cube tail_rotor { origin = (1u, 12u, 9u); size = (1u, 4u, 2u); surface = skin.tail_rotor; }
        cube skid_left { origin = (-4u, 8u, -5u); size = (1u, 1u, 8u); surface = skin.skid_left; }
        cube skid_right { origin = (3u, 8u, -5u); size = (1u, 1u, 8u); surface = skin.skid_right; }
        cube mast { origin = (-0.5u, 16u, -1.5u); size = (1u, 1u, 1u); surface = skin.mast; }
        bone rotor {
          cube blade_a { origin = (-9u, 17u, -1.5u); size = (18u, 1u, 1u); surface = skin.blade_a; }
          cube blade_b { origin = (-0.5u, 17u, -10u); size = (1u, 1u, 18u); surface = skin.blade_b; }
        }
      }
    }
  }
  export asset thelicopter_blue {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    motion = drive;
    motion = fire;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
