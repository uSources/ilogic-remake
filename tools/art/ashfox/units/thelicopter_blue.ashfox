key 1s = (0deg, 0deg, 0deg) step;
}
}
motion fire for ModelRig {
duration = 0.4s; fps = 30; loop = once; rest-relative = true;
track body.rotation {
key 0s = (0deg, 0deg, 0deg) linear;
key 0.06s = (-5deg, 0deg, 0deg) linear;
key 0.4s = (0deg, 0deg, 0deg) linear;
}
}
surface contract Skin {
atlas { width = 64px; height = 64px; }
chart cabin box { width = 30px; height = 14px; coverage = opaque; }
chart cabin_top box { width = 22px; height = 7px; coverage = opaque; }
chart bubble box { width = 18px; height = 8px; coverage = opaque; }
chart boom box { width = 20px; height = 10px; coverage = opaque; }
chart tail_fin box { width = 6px; height = 5px; coverage = opaque; }
chart skid0 box { width = 22px; height = 11px; coverage = opaque; }
chart strut_front0 box { width = 4px; height = 3px; coverage = opaque; }
chart strut_back0 box { width = 4px; height = 3px; coverage = opaque; }
chart skid1 box { width = 22px; height = 11px; coverage = opaque; }
chart strut_front1 box { width = 4px; height = 3px; coverage = opaque; }
chart strut_back1 box { width = 4px; height = 3px; coverage = opaque; }
chart mast box { width = 4px; height = 2px; coverage = opaque; }
chart blade_a box { width = 42px; height = 2px; coverage = opaque; }
chart blade_b box { width = 42px; height = 21px; coverage = opaque; }
chart tail_blade_a box { width = 4px; height = 5px; coverage = opaque; }
chart tail_blade_b box { width = 10px; height = 5px; coverage = opaque; }
material = opaque;
}
surface paint: Skin {
material = opaque;
texture atlas {
atlas = (64px, 64px); background = team_blue; background-alpha = 255;
palette {
team_blue = (#2766c4, #2f74d6, #3d84e2);
rim_team_blue_7_r = #6fb0f2;
rim_team_blue_8_r = #6fb0f2;
glass = (#8ad4f4, #9fe3ff, #b8ecff);
dark_blue = (#1a468e, #1f56a8, #2a64b8);
rim_dark_blue_1_r = #3f7ccc;
rim_dark_blue_2_r = #3f7ccc;
gun = (#2a2e38, #343a46, #3e4554);
steel = (#7a8394, #8a93a6, #9aa3b6);
blur = (#8fb8d8, #a8cce6, #c0dcf0);
}
stamp rim_team_blue_7 { pixels = "rrrrrrr"; r = rim_team_blue_7_r; }
stamp rim_team_blue_8 { pixels = "rrrrrrrr"; r = rim_team_blue_8_r; }
stamp rim_dark_blue_1 { pixels = "r"; r = rim_dark_blue_1_r; }
stamp rim_dark_blue_2 { pixels = "rr"; r = rim_dark_blue_2_r; }
chart cabin box { origin = (0px, 22px); fill = team_blue; face north { stamp rim_team_blue_7 { at = (0px, 0px); } } face south { stamp rim_team_blue_7 { at = (0px, 0px); } } face east { stamp rim_team_blue_8 { at = (0px, 0px); } } face west { stamp rim_team_blue_8 { at = (0px, 0px); } } }
chart cabin_top box { origin = (0px, 49px); fill = team_blue; }
chart bubble box { origin = (44px, 37px); fill = glass; }
chart boom box { origin = (23px, 37px); fill = dark_blue; }
chart tail_fin box { origin = (23px, 49px); fill = dark_blue; face north { stamp rim_dark_blue_1 { at = (0px, 0px); } } face south { stamp rim_dark_blue_1 { at = (0px, 0px); } } face east { stamp rim_dark_blue_2 { at = (0px, 0px); } } face west { stamp rim_dark_blue_2 { at = (0px, 0px); } } }
chart skid0 box { origin = (31px, 22px); fill = gun; }
chart strut_front0 box { origin = (46px, 49px); fill = gun; }
chart strut_back0 box { origin = (51px, 49px); fill = gun; }
chart skid1 box { origin = (0px, 37px); fill = gun; }
chart strut_front1 box { origin = (56px, 49px); fill = gun; }
chart strut_back1 box { origin = (0px, 57px); fill = gun; }
chart mast box { origin = (5px, 57px); fill = steel; }
chart blade_a box { origin = (10px, 57px); fill = blur; }
chart blade_b box { origin = (0px, 0px); fill = blur; }
chart tail_blade_a box { origin = (30px, 49px); fill = steel; }
chart tail_blade_b box { origin = (35px, 49px); fill = steel; }
grain clustered { seed = 2013; }
tone voxel;
}
}
component Body {
requires rig skeleton: ModelRig;
requires surface skin: Skin;
bind bone body to skeleton.body;
bind bone rotor to skeleton.rotor;
bind bone tail_rotor to skeleton.tail_rotor;
geometry {
bone body {
cube cabin { origin = (-3.5u, 10u, -4u); size = (7u, 6u, 8u); surface = skin.cabin; }
cube cabin_top { origin = (-2.5u, 16u, -3u); size = (5u, 1u, 6u); surface = skin.cabin_top; }
cube bubble { origin = (-3u, 10.5u, -7u); size = (6u, 5u, 3u); surface = skin.bubble; }
cube boom { origin = (-1u, 13u, 4u); size = (2u, 2u, 8u); surface = skin.boom; }
cube tail_fin { origin = (-0.5u, 15u, 10u); size = (1u, 3u, 2u); surface = skin.tail_fin; }
cube skid0 { origin = (-4u, 7u, -5u); size = (1u, 1u, 10u); surface = skin.skid0; }
cube strut_front0 { origin = (-4u, 8u, -3u); size = (1u, 2u, 1u); surface = skin.strut_front0; }
cube strut_back0 { origin = (-4u, 8u, 2u); size = (1u, 2u, 1u); surface = skin.strut_back0; }
cube skid1 { origin = (3u, 7u, -5u); size = (1u, 1u, 10u); surface = skin.skid1; }
cube strut_front1 { origin = (3u, 8u, -3u); size = (1u, 2u, 1u); surface = skin.strut_front1; }
cube strut_back1 { origin = (3u, 8u, 2u); size = (1u, 2u, 1u); surface = skin.strut_back1; }
cube mast { origin = (-0.5u, 17u, -0.5u); size = (1u, 1u, 1u); surface = skin.mast; }
bone rotor {
cube blade_a { origin = (-10u, 18u, -0.5u); size = (20u, 1u, 1u); surface = skin.blade_a; }
cube blade_b { origin = (-0.5u, 18u, -10u); size = (1u, 1u, 20u); surface = skin.blade_b; }
}
bone tail_rotor {
cube tail_blade_a { origin = (1u, 11.5u, 10.5u); size = (1u, 4u, 1u); surface = skin.tail_blade_a; }
cube tail_blade_b { origin = (1u, 13u, 9u); size = (1u, 1u, 4u); surface = skin.tail_blade_b; }
}
}
}
}
export asset thelicopter_blue {
settings { density = 16; forward = north; }
skeleton = ModelSkeleton;
motion = idle;
motion = drive;
motion = fire;
use Body as model { bind skeleton = ModelRig; bind skin = paint; };
}
}
