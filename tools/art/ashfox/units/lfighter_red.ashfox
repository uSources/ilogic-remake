ashfox-model 1
asset lfighter_red {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint prop { parent = body; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 10u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind prop { parent-origin = (0u, 2u, -7.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 0.2s; fps = 20; loop = loop; rest-relative = true;
    track prop.rotation {
      key 0s = (0deg, 0deg, 0deg) step;
      key 0.05s = (0deg, 0deg, 45deg) step;
      key 0.1s = (0deg, 0deg, 90deg) step;
      key 0.15s = (0deg, 0deg, 135deg) step;
      key 0.2s = (0deg, 0deg, 0deg) step;
    }
  }
  motion drive for ModelRig {
    duration = 0.2s; fps = 20; loop = loop; rest-relative = true;
    track prop.rotation {
      key 0s = (0deg, 0deg, 0deg) step;
      key 0.05s = (0deg, 0deg, 45deg) step;
      key 0.1s = (0deg, 0deg, 90deg) step;
      key 0.15s = (0deg, 0deg, 135deg) step;
      key 0.2s = (0deg, 0deg, 0deg) step;
    }
  }
  motion fire for ModelRig {
    duration = 0.4s; fps = 30; loop = once; rest-relative = true;
    track body.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (-5deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 32px; }
    chart fuselage box { width = 30px; height = 15px; coverage = opaque; }
    chart wing_top box { width = 40px; height = 5px; coverage = opaque; }
    chart wing_low box { width = 36px; height = 5px; coverage = opaque; }
    chart tail box { width = 6px; height = 5px; coverage = opaque; }
    chart pilot box { width = 8px; height = 4px; coverage = opaque; }
    chart prop_hub box { width = 4px; height = 2px; coverage = opaque; }
    chart prop_blade box { width = 16px; height = 2px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 32px); background = team_red; background-alpha = 255;
      palette {
        team_red = (#8a1a1a, #c8302a, #f0605a);
        dark_red = (#601212, #962220, #c84038);
        skin = (#c8946a, #f1c79b, #ffe2c4);
        steel = (#4e5666, #8a93a6, #c3cbd9);
      }

      chart fuselage box {
        origin = (0px, 0px); fill = team_red;
      }
      chart wing_top box {
        origin = (0px, 16px); fill = dark_red;
      }
      chart wing_low box {
        origin = (0px, 22px); fill = dark_red;
      }
      chart tail box {
        origin = (37px, 22px); fill = dark_red;
      }
      chart pilot box {
        origin = (44px, 22px); fill = skin;
      }
      chart prop_hub box {
        origin = (53px, 22px); fill = steel;
      }
      chart prop_blade box {
        origin = (0px, 28px); fill = steel;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    bind bone prop to skeleton.prop;
    geometry {
      bone body {
        cube fuselage { origin = (-1.5u, 10u, -7u); size = (3u, 3u, 12u); surface = skin.fuselage; }
        cube wing_top { origin = (-8u, 13u, -4u); size = (16u, 1u, 4u); surface = skin.wing_top; }
        cube wing_low { origin = (-7u, 10u, -4u); size = (14u, 1u, 4u); surface = skin.wing_low; }
        cube tail { origin = (-0.5u, 13u, 3u); size = (1u, 3u, 2u); surface = skin.tail; }
        cube pilot { origin = (-1u, 13u, -2u); size = (2u, 2u, 2u); surface = skin.pilot; }
        bone prop {
          cube prop_hub { origin = (-0.5u, 11.5u, -8u); size = (1u, 1u, 1u); surface = skin.prop_hub; }
          cube prop_blade { origin = (-3.5u, 11.5u, -8.5u); size = (7u, 1u, 1u); surface = skin.prop_blade; }
        }
      }
    }
  }
  export asset lfighter_red {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    motion = drive;
    motion = fire;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
