    chart engine_deck box { width = 42px; height = 6px; coverage = opaque; }
    chart toolbox box { width = 24px; height = 10px; coverage = opaque; }
    chart turret box { width = 62px; height = 23px; coverage = opaque; }
    chart mantlet box { width = 28px; height = 8px; coverage = opaque; }
    chart cupola box { width = 24px; height = 8px; coverage = opaque; }
    chart hatch box { width = 16px; height = 5px; coverage = opaque; }
    chart periscope box { width = 6px; height = 3px; coverage = opaque; }
    chart bustle box { width = 34px; height = 9px; coverage = opaque; }
