ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 128px; height = 128px; }
    chart cabin box { width = 60px; height = 28px; coverage = opaque; }
    chart cabin_top box { width = 44px; height = 14px; coverage = opaque; }
    chart engine box { width = 28px; height = 11px; coverage = opaque; }
    chart bubble box { width = 32px; height = 14px; coverage = opaque; }
    chart bubble_mid box { width = 24px; height = 10px; coverage = opaque; }
    chart bubble_tip box { width = 18px; height = 7px; coverage = opaque; }
    chart boom box { width = 40px; height = 20px; coverage = opaque; }
    chart tail_fin box { width = 12px; height = 10px; coverage = opaque; }
    chart tail_plane box { width = 26px; height = 4px; coverage = opaque; }
    chart skid_left box { width = 48px; height = 24px; coverage = opaque; }
    chart strut_front_left box { width = 6px; height = 5px; coverage = opaque; }
    chart strut_back_left box { width = 6px; height = 5px; coverage = opaque; }
    chart skid_right box { width = 48px; height = 24px; coverage = opaque; }
    chart strut_front_right box { width = 6px; height = 5px; coverage = opaque; }
    chart strut_back_right box { width = 6px; height = 5px; coverage = opaque; }
    chart mast box { width = 8px; height = 4px; coverage = opaque; }
    chart rotor_hub box { width = 16px; height = 5px; coverage = opaque; }
    chart blade_a box { width = 84px; height = 3px; coverage = opaque; }
    chart blade_b box { width = 84px; height = 41px; coverage = opaque; }
    chart tail_blade_a box { width = 4px; height = 9px; coverage = opaque; }
    chart tail_blade_b box { width = 18px; height = 9px; coverage = opaque; }
    material = opaque;
  }
}
