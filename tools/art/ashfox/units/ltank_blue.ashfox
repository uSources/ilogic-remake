ashfox-model 1
asset ltank_blue {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint chassis { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint hull { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint turret { parent = hull; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint barrel { parent = turret; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind chassis { parent-origin = (0u, 2u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind hull { parent-origin = (0u, 3u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind turret { parent-origin = (0u, 2u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind barrel { parent-origin = (0u, 1.5u, -2.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 1.2s; fps = 20; loop = loop; rest-relative = true;
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (0.6deg, 0deg, 0.4deg) catmullrom;
      key 0.6s = (0deg, 0deg, 0deg) catmullrom;
      key 0.9s = (-0.6deg, 0deg, -0.4deg) catmullrom;
      key 1.2s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion drive for ModelRig {
    duration = 0.4s; fps = 20; loop = loop; rest-relative = true;
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.1s = (-2deg, 0deg, 1deg) catmullrom;
      key 0.2s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (2deg, 0deg, -1deg) catmullrom;
      key 0.4s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion fire for ModelRig {
    duration = 0.5s; fps = 30; loop = once; rest-relative = true;
    track barrel.scale {
      key 0s = (1, 1, 1) linear;
      key 0.05s = (1.15, 1.15, 0.6) linear;
      key 0.4s = (1, 1, 1) linear;
    }
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (5deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart track0 box { width = 30px; height = 15px; coverage = opaque; }
    chart track1 box { width = 30px; height = 15px; coverage = opaque; }
    chart hull box { width = 42px; height = 13px; coverage = opaque; }
    chart turret box { width = 22px; height = 8px; coverage = opaque; }
    chart turret_top box { width = 14px; height = 4px; coverage = opaque; }
    chart barrel box { width = 14px; height = 7px; coverage = opaque; }
    chart muzzle box { width = 6px; height = 3px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        wheels11_s = #5a6272;
        wheels11_t = #363d4c;
        sprocket_s = #6a7282;
        team_blue = (#2766c4, #2f74d6, #3d84e2);
        rim_team_blue_6_r = #6fb0f2;
        rim_team_blue_5_r = #6fb0f2;
        steel = (#7a8394, #8a93a6, #9aa3b6);
        gun = (#2a2e38, #343a46, #3e4554);
      }
      stamp wheels11 { pixels = "ttttttttttt/.ss.ss.ss../.ss.ss.ss../ttttttttttt"; s = wheels11_s; t = wheels11_t; }
      stamp sprocket { pixels = "ss/ss"; s = sprocket_s; }
      stamp rim_team_blue_6 { pixels = "rrrrrr"; r = rim_team_blue_6_r; }
      stamp rim_team_blue_5 { pixels = "rrrrr"; r = rim_team_blue_5_r; }
      chart track0 box {
        origin = (0px, 0px); fill = tread;
        face west { stamp wheels11 { at = (0px, 0px); } }
        face north { stamp sprocket { at = (1px, 1px); } }
        face south { stamp sprocket { at = (1px, 1px); } }
      }
      chart track1 box {
        origin = (31px, 0px); fill = tread;
        face east { stamp wheels11 { at = (0px, 0px); } }
        face north { stamp sprocket { at = (1px, 1px); } }
        face south { stamp sprocket { at = (1px, 1px); } }
      }
      chart hull box {
        origin = (0px, 16px); fill = team_blue;
      }
      chart turret box {
        origin = (0px, 30px); fill = team_blue;
        face north { stamp rim_team_blue_6 { at = (0px, 0px); } }
        face south { stamp rim_team_blue_6 { at = (0px, 0px); } }
        face east { stamp rim_team_blue_5 { at = (0px, 0px); } }
        face west { stamp rim_team_blue_5 { at = (0px, 0px); } }
      }
      chart turret_top box {
        origin = (38px, 30px); fill = team_blue;
      }
      chart barrel box {
        origin = (23px, 30px); fill = steel;
      }
      chart muzzle box {
        origin = (53px, 30px); fill = gun;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone chassis to skeleton.chassis;
    bind bone hull to skeleton.hull;
    bind bone turret to skeleton.turret;
    bind bone barrel to skeleton.barrel;
    geometry {
      bone chassis {
        cube track0 { origin = (-6u, 0u, -5.5u); size = (4u, 4u, 11u); surface = skin.track0; }
        cube track1 { origin = (2u, 0u, -5.5u); size = (4u, 4u, 11u); surface = skin.track1; }
      }
      bone hull {
        cube hull { origin = (-5u, 3u, -5.5u); size = (10u, 2u, 11u); surface = skin.hull; }
        bone turret {
          cube turret { origin = (-3u, 5u, -2.5u); size = (6u, 3u, 5u); surface = skin.turret; }
          cube turret_top { origin = (-2u, 8u, -1.5u); size = (4u, 1u, 3u); surface = skin.turret_top; }
          bone barrel {
            cube barrel { origin = (-0.5u, 6u, -8.5u); size = (1u, 1u, 6u); surface = skin.barrel; }
            cube muzzle { origin = (-1u, 5.5u, -9.5u); size = (2u, 2u, 1u); surface = skin.muzzle; }
          }
        }
      }
    }
  }
  export asset ltank_blue {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    motion = drive;
    motion = fire;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
