ashfox-model 1
asset lfighter_blue {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint body { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint prop { parent = body; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind body { parent-origin = (0u, 10u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind prop { parent-origin = (0u, 2u, -8u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 2s; fps = 20; loop = loop; rest-relative = true;
    track body.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.5s = (3deg, 0deg, 5deg) catmullrom;
      key 1s = (0deg, 0deg, 0deg) catmullrom;
      key 1.5s = (-3deg, 0deg, -5deg) catmullrom;
      key 2s = (0deg, 0deg, 0deg) catmullrom;
    }
    track prop.rotation {
      key 0s = (0deg, 0deg, 0deg) step;
      key 0.05s = (0deg, 0deg, 22.5deg) step;
      key 0.1s = (0deg, 0deg, 45deg) step;
      key 0.15s = (0deg, 0deg, 67.5deg) step;
      key 0.2s = (0deg, 0deg, 90deg) step;
      key 0.25s = (0deg, 0deg, 112.5deg) step;
      key 0.3s = (0deg, 0deg, 135deg) step;
      key 0.35s = (0deg, 0deg, 157.5deg) step;
      key 0.4s = (0deg, 0deg, 180deg) step;
      key 0.45s = (0deg, 0deg, 202.5deg) step;
      key 0.5s = (0deg, 0deg, 225deg) step;
      key 0.55s = (0deg, 0deg, 247.5deg) step;
      key 0.6s = (0deg, 0deg, 270deg) step;
      key 0.65s = (0deg, 0deg, 292.5deg) step;
      key 0.7s = (0deg, 0deg, 315deg) step;
      key 0.75s = (0deg, 0deg, 337.5deg) step;
      key 0.8s = (0deg, 0deg, 360deg) step;
      key 0.85s = (0deg, 0deg, 382.5deg) step;
      key 0.9s = (0deg, 0deg, 405deg) step;
      key 0.95s = (0deg, 0deg, 427.5deg) step;
      key 1s = (0deg, 0deg, 450deg) step;
      key 1.05s = (0deg, 0deg, 472.5deg) step;
      key 1.1s = (0deg, 0deg, 495deg) step;
      key 1.15s = (0deg, 0deg, 517.5deg) step;
      key 1.2s = (0deg, 0deg, 540deg) step;
      key 1.25s = (0deg, 0deg, 562.5deg) step;
      key 1.3s = (0deg, 0deg, 585deg) step;
      key 1.35s = (0deg, 0deg, 607.5deg) step;
      key 1.4s = (0deg, 0deg, 630deg) step;
      key 1.45s = (0deg, 0deg, 652.5deg) step;
      key 1.5s = (0deg, 0deg, 675deg) step;
      key 1.55s = (0deg, 0deg, 697.5deg) step;
      key 1.6s = (0deg, 0deg, 720deg) step;
      key 1.65s = (0deg, 0deg, 742.5deg) step;
      key 1.7s = (0deg, 0deg, 765deg) step;
      key 1.75s = (0deg, 0deg, 787.5deg) step;
      key 1.8s = (0deg, 0deg, 810deg) step;
      key 1.85s = (0deg, 0deg, 832.5deg) step;
      key 1.9s = (0deg, 0deg, 855deg) step;
      key 1.95s = (0deg, 0deg, 877.5deg) step;
      key 2s = (0deg, 0deg, 0deg) step;
    }
  }
  motion drive for ModelRig {
    duration = 1s; fps = 20; loop = loop; rest-relative = true;
    track body.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.25s = (-4deg, 0deg, 6deg) catmullrom;
      key 0.5s = (0deg, 0deg, 0deg) catmullrom;
      key 0.75s = (4deg, 0deg, -6deg) catmullrom;
      key 1s = (0deg, 0deg, 0deg) catmullrom;
    }
    track prop.rotation {
      key 0s = (0deg, 0deg, 0deg) step;
      key 0.05s = (0deg, 0deg, 22.5deg) step;
      key 0.1s = (0deg, 0deg, 45deg) step;
      key 0.15s = (0deg, 0deg, 67.5deg) step;
      key 0.2s = (0deg, 0deg, 90deg) step;
      key 0.25s = (0deg, 0deg, 112.5deg) step;
      key 0.3s = (0deg, 0deg, 135deg) step;
      key 0.35s = (0deg, 0deg, 157.5deg) step;
      key 0.4s = (0deg, 0deg, 180deg) step;
      key 0.45s = (0deg, 0deg, 202.5deg) step;
      key 0.5s = (0deg, 0deg, 225deg) step;
      key 0.55s = (0deg, 0deg, 247.5deg) step;
      key 0.6s = (0deg, 0deg, 270deg) step;
      key 0.65s = (0deg, 0deg, 292.5deg) step;
      key 0.7s = (0deg, 0deg, 315deg) step;
      key 0.75s = (0deg, 0deg, 337.5deg) step;
      key 0.8s = (0deg, 0deg, 360deg) step;
      key 0.85s = (0deg, 0deg, 382.5deg) step;
      key 0.9s = (0deg, 0deg, 405deg) step;
      key 0.95s = (0deg, 0deg, 427.5deg) step;
      key 1s = (0deg, 0deg, 0deg) step;
    }
  }
  motion fire for ModelRig {
    duration = 0.4s; fps = 30; loop = once; rest-relative = true;
    track body.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (-5deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 32px; }
    chart fuselage box { width = 30px; height = 15px; coverage = opaque; }
    chart cowl box { width = 10px; height = 5px; coverage = opaque; }
    chart tail box { width = 12px; height = 6px; coverage = opaque; }
    chart fin box { width = 8px; height = 7px; coverage = opaque; }
    chart tailplane box { width = 20px; height = 3px; coverage = opaque; }
    chart wing box { width = 38px; height = 6px; coverage = opaque; }
    chart windscreen box { width = 10px; height = 2px; coverage = opaque; }
    chart pilot box { width = 8px; height = 4px; coverage = opaque; }
    chart pilot_helmet box { width = 12px; height = 4px; coverage = opaque; }
    chart wheel_left box { width = 6px; height = 4px; coverage = opaque; }
    chart wheel_right box { width = 6px; height = 4px; coverage = opaque; }
    chart prop_hub box { width = 6px; height = 3px; coverage = opaque; }
    chart prop_a box { width = 16px; height = 2px; coverage = opaque; }
    chart prop_b box { width = 4px; height = 8px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 32px); background = team_blue; background-alpha = 255;
      palette {
        team_blue = (#2766c4, #2f74d6, #3d84e2);
        rim_team_blue_4_r = #6fb0f2;
        rim_team_blue_11_r = #6fb0f2;
        steel = (#7a8394, #8a93a6, #9aa3b6);
        dark_blue = (#1a468e, #1f56a8, #2a64b8);
        rim_dark_blue_1_r = #3f7ccc;
        rim_dark_blue_3_r = #3f7ccc;
        glass = (#8ad4f4, #9fe3ff, #b8ecff);
        skin = (#e4b88c, #f1c79b, #f8d4ac);
        tire = (#14171e, #1c2029, #252a35);
        gun = (#2a2e38, #343a46, #3e4554);
      }
      stamp rim_team_blue_4 { pixels = "rrrr"; r = rim_team_blue_4_r; }
      stamp rim_team_blue_11 { pixels = "rrrrrrrrrrr"; r = rim_team_blue_11_r; }
      stamp rim_dark_blue_1 { pixels = "r"; r = rim_dark_blue_1_r; }
      stamp rim_dark_blue_3 { pixels = "rrr"; r = rim_dark_blue_3_r; }
      chart fuselage box {
        origin = (0px, 0px); fill = team_blue;
        face north { stamp rim_team_blue_4 { at = (0px, 0px); } }
        face south { stamp rim_team_blue_4 { at = (0px, 0px); } }
        face east { stamp rim_team_blue_11 { at = (0px, 0px); } }
        face west { stamp rim_team_blue_11 { at = (0px, 0px); } }
      }
      chart cowl box {
        origin = (39px, 16px); fill = steel;
      }
      chart tail box {
        origin = (45px, 0px); fill = team_blue;
      }
      chart fin box {
        origin = (36px, 0px); fill = dark_blue;
        face north { stamp rim_dark_blue_1 { at = (0px, 0px); } }
        face south { stamp rim_dark_blue_1 { at = (0px, 0px); } }
        face east { stamp rim_dark_blue_3 { at = (0px, 0px); } }
        face west { stamp rim_dark_blue_3 { at = (0px, 0px); } }
      }
      chart tailplane box {
        origin = (27px, 23px); fill = dark_blue;
      }
      chart wing box {
        origin = (0px, 16px); fill = dark_blue;
      }
      chart windscreen box {
        origin = (0px, 28px); fill = glass;
      }
      chart pilot box {
        origin = (50px, 16px); fill = skin;
      }
      chart pilot_helmet box {
        origin = (0px, 23px); fill = team_blue;
      }
      chart wheel_left box {
        origin = (13px, 23px); fill = tire;
      }
      chart wheel_right box {
        origin = (20px, 23px); fill = tire;
      }
      chart prop_hub box {
        origin = (48px, 23px); fill = gun;
      }
      chart prop_a box {
        origin = (11px, 28px); fill = steel;
      }
      chart prop_b box {
        origin = (31px, 0px); fill = steel;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone body to skeleton.body;
    bind bone prop to skeleton.prop;
    geometry {
      bone body {
        cube fuselage { origin = (-2u, 10u, -6u); size = (4u, 4u, 11u); surface = skin.fuselage; }
        cube cowl { origin = (-2u, 10u, -7u); size = (4u, 4u, 1u); surface = skin.cowl; }
        cube tail { origin = (-1u, 11u, 5u); size = (2u, 2u, 4u); surface = skin.tail; }
        cube fin { origin = (-0.5u, 13u, 6u); size = (1u, 4u, 3u); surface = skin.fin; }
        cube tailplane { origin = (-4u, 11.5u, 7u); size = (8u, 1u, 2u); surface = skin.tailplane; }
        cube wing { origin = (-7u, 10u, -3u); size = (14u, 1u, 5u); surface = skin.wing; }
        cube windscreen { origin = (-2u, 14u, -2u); size = (4u, 1u, 1u); surface = skin.windscreen; }
        cube pilot { origin = (-1u, 14u, -1u); size = (2u, 2u, 2u); surface = skin.pilot; }
        cube pilot_helmet { origin = (-1.5u, 16u, -1.5u); size = (3u, 1u, 3u); surface = skin.pilot_helmet; }
        cube wheel_left { origin = (-3u, 8u, -4u); size = (1u, 2u, 2u); surface = skin.wheel_left; }
        cube wheel_right { origin = (2u, 8u, -4u); size = (1u, 2u, 2u); surface = skin.wheel_right; }
        bone prop {
          cube prop_hub { origin = (-1u, 11u, -8u); size = (2u, 2u, 1u); surface = skin.prop_hub; }
          cube prop_a { origin = (-3.5u, 11.5u, -8.5u); size = (7u, 1u, 1u); surface = skin.prop_a; }
          cube prop_b { origin = (-0.5u, 8.5u, -8.5u); size = (1u, 7u, 1u); surface = skin.prop_b; }
        }
      }
    }
  }
  export asset lfighter_blue {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    motion = drive;
    motion = fire;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
