ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart fuselage box { width = 40px; height = 20px; coverage = opaque; }
    chart nose box { width = 12px; height = 6px; coverage = opaque; }
    chart windscreen box { width = 12px; height = 3px; coverage = opaque; }
    chart wing box { width = 56px; height = 7px; coverage = opaque; }
    chart engine_left box { width = 16px; height = 8px; coverage = opaque; }
    chart engine_right box { width = 16px; height = 8px; coverage = opaque; }
    chart prop_left_a box { width = 12px; height = 2px; coverage = opaque; }
    chart prop_left_b box { width = 4px; height = 6px; coverage = opaque; }
    chart prop_right_a box { width = 12px; height = 2px; coverage = opaque; }
    chart prop_right_b box { width = 4px; height = 6px; coverage = opaque; }
    chart fin box { width = 10px; height = 9px; coverage = opaque; }
    chart tailplane box { width = 26px; height = 4px; coverage = opaque; }
    material = opaque;
  }
}
