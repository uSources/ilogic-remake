          cube rider_shin_left { origin = (-6u, 13.5u, -14u); size = (3u, 3u, 8u); rotation = (-97deg, 0deg, 0deg); pivot = (-4.5u, 15u, -6u); surface = skin.rider_shin_left; }
          cube rider_boot_left { origin = (-6u, 6u, -8u); size = (3u, 3u, 5u); surface = skin.rider_boot_left; }
          cube rider_upper_arm_left { origin = (-8u, 19u, -7.5u); size = (3u, 3u, 6u); rotation = (-49deg, 20.5deg, 0deg); pivot = (-6.5u, 20.5u, -1.5u); surface = skin.rider_upper_arm_left; }
          cube rider_forearm_left { origin = (-10u, 15u, -12u); size = (3u, 3u, 7u); rotation = (22.5deg, -21deg, 0deg); pivot = (-8.5u, 16.5u, -5u); surface = skin.rider_forearm_left; }
          cube rider_glove_left { origin = (-7.5u, 17.5u, -12.5u); size = (3u, 3u, 3u); surface = skin.rider_glove_left; }
          cube rider_thigh_right { origin = (1u, 13.5u, -6u); size = (3u, 3u, 7u); rotation = (0deg, -16deg, 0deg); pivot = (2.5u, 15u, 1u); surface = skin.rider_thigh_right; }
          cube rider_shin_right { origin = (3u, 13.5u, -14u); size = (3u, 3u, 8u); rotation = (-97deg, 0deg, 0deg); pivot = (4.5u, 15u, -6u); surface = skin.rider_shin_right; }
          cube rider_boot_right { origin = (3u, 6u, -8u); size = (3u, 3u, 5u); surface = skin.rider_boot_right; }
          cube rider_upper_arm_right { origin = (5u, 19u, -7.5u); size = (3u, 3u, 6u); rotation = (-49deg, -20.5deg, 0deg); pivot = (6.5u, 20.5u, -1.5u); surface = skin.rider_upper_arm_right; }
          cube rider_forearm_right { origin = (7u, 15u, -12u); size = (3u, 3u, 7u); rotation = (22.5deg, 21deg, 0deg); pivot = (8.5u, 16.5u, -5u); surface = skin.rider_forearm_right; }
          cube rider_glove_right { origin = (4.5u, 17.5u, -12.5u); size = (3u, 3u, 3u); surface = skin.rider_glove_right; }
          cube scarf_knot { origin = (-3u, 21.5u, 1.5u); size = (6u, 2u, 3u); surface = skin.scarf_knot; }
          cube scarf_tail { origin = (-2.5u, 20.5u, 4.5u); size = (5u, 2u, 5u); rotation = (20deg, 0deg, 0deg); pivot = (0u, 21.5u, 4.5u); surface = skin.scarf_tail; }
          cube scarf_end { origin = (-2u, 18u, 8.5u); size = (4u, 2u, 4u); rotation = (35deg, 0deg, 0deg); pivot = (0u, 19u, 8.5u); surface = skin.scarf_end; }
        }
