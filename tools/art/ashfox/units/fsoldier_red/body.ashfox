        cube front_fender { origin = (-2.5u, 13u, -16u); size = (5u, 1u, 7u); rotation = (10deg, 0deg, 0deg); pivot = (0u, 13.5u, -12u); surface = skin.front_fender; }
        cube headlight { origin = (-3u, 14u, -15u); size = (6u, 5u, 2u); surface = skin.headlight; }
        cube handlebar { origin = (-6.5u, 18.5u, -11.5u); size = (13u, 1u, 1u); surface = skin.handlebar; }
        cube exhaust { origin = (3.5u, 6u, -5u); size = (2u, 2u, 8u); surface = skin.exhaust; }
        cube muffler { origin = (3.5u, 8u, 3u); size = (3u, 3u, 9u); rotation = (-15deg, 0deg, 0deg); pivot = (5u, 9.5u, 3u); surface = skin.muffler; }
        cube tail_light { origin = (-1u, 15u, 15u); size = (2u, 1u, 1u); surface = skin.tail_light; }
        bone rider {
