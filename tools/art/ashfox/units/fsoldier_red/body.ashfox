          cube buckle { origin = (-1.5u, 14u, -4u); size = (3u, 2u, 1u); rotation = (-12deg, 0deg, 0deg); pivot = (0u, 14u, 1u); surface = skin.buckle; }
          cube pouch_left { origin = (-4.5u, 14u, -4u); size = (2u, 2u, 1u); rotation = (-12deg, 0deg, 0deg); pivot = (0u, 14u, 1u); surface = skin.pouch_left; }
          cube pouch_right { origin = (2.5u, 14u, -4u); size = (2u, 2u, 1u); rotation = (-12deg, 0deg, 0deg); pivot = (0u, 14u, 1u); surface = skin.pouch_right; }
          cube head { origin = (-6u, 22u, -6u); size = (12u, 9u, 11u); rotation = (-12deg, 0deg, 0deg); pivot = (0u, 14u, 1u); surface = skin.head; }
          cube helmet { origin = (-7u, 28u, -7u); size = (14u, 6u, 13u); rotation = (-12deg, 0deg, 0deg); pivot = (0u, 14u, 1u); surface = skin.helmet; }
          cube helmet_top { origin = (-5u, 34u, -5u); size = (10u, 2u, 9u); rotation = (-12deg, 0deg, 0deg); pivot = (0u, 14u, 1u); surface = skin.helmet_top; }
          cube neck_guard { origin = (-7u, 25u, 4u); size = (14u, 3u, 2u); rotation = (-12deg, 0deg, 0deg); pivot = (0u, 14u, 1u); surface = skin.neck_guard; }
          cube goggles { origin = (-6u, 29u, -8u); size = (12u, 4u, 1u); rotation = (-12deg, 0deg, 0deg); pivot = (0u, 14u, 1u); surface = skin.goggles; }
          cube lens_left { origin = (-5u, 30u, -9u); size = (4u, 2u, 1u); rotation = (-12deg, 0deg, 0deg); pivot = (0u, 14u, 1u); surface = skin.lens_left; }
