        cube wheel_front_round { origin = (-1.5u, 2.5u, -18u); size = (3u, 7u, 12u); surface = skin.wheel_front_round; }
        cube wheel_front_hub_left { origin = (-2.5u, 3.5u, -14.5u); size = (1u, 5u, 5u); surface = skin.wheel_front_hub_left; }
        cube wheel_front_hub_right { origin = (1.5u, 3.5u, -14.5u); size = (1u, 5u, 5u); surface = skin.wheel_front_hub_right; }
      }
      bone wheels_back {
