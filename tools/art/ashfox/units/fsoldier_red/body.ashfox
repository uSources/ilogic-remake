        cube wheel_back_round { origin = (-1.5u, 2.5u, 5u); size = (3u, 7u, 12u); surface = skin.wheel_back_round; }
        cube wheel_back_hub_left { origin = (-2.5u, 3.5u, 8.5u); size = (1u, 5u, 5u); surface = skin.wheel_back_hub_left; }
        cube wheel_back_hub_right { origin = (1.5u, 3.5u, 8.5u); size = (1u, 5u, 5u); surface = skin.wheel_back_hub_right; }
