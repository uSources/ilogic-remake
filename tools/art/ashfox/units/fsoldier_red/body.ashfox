ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone hull to skeleton.hull;
    bind bone wheels_front to skeleton.wheels_front;
    bind bone wheels_back to skeleton.wheels_back;
    bind bone rider to skeleton.rider;
    geometry {
      bone hull {
        cube fork_left { origin = (-3u, 17.5u, -23u); size = (1u, 1u, 12u); rotation = (-85deg, 0deg, 0deg); pivot = (-2.5u, 18u, -11u); surface = skin.fork_left; }
        cube fork_right { origin = (2u, 17.5u, -23u); size = (1u, 1u, 12u); rotation = (-85deg, 0deg, 0deg); pivot = (2.5u, 18u, -11u); surface = skin.fork_right; }
        cube swingarm { origin = (-1u, 7u, -9u); size = (2u, 2u, 10u); rotation = (-168.5deg, 0deg, 0deg); pivot = (0u, 8u, 1u); surface = skin.swingarm; }
        cube engine { origin = (-3.5u, 5u, -6u); size = (7u, 7u, 10u); surface = skin.engine; }
