ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 64px; height = 256px; }
    chart boot_leg_left box { width = 20px; height = 9px; coverage = opaque; }
    chart leg_left box { width = 16px; height = 10px; coverage = opaque; }
    chart boot_leg_right box { width = 20px; height = 9px; coverage = opaque; }
    chart leg_right box { width = 16px; height = 10px; coverage = opaque; }
    chart torso box { width = 32px; height = 14px; coverage = opaque; }
    chart buckle box { width = 8px; height = 3px; coverage = opaque; }
    chart pouch_left box { width = 6px; height = 3px; coverage = opaque; }
    chart pouch_right box { width = 6px; height = 3px; coverage = opaque; }
    chart head box { width = 46px; height = 20px; coverage = opaque; }
    chart helmet box { width = 54px; height = 19px; coverage = opaque; }
    chart helmet_top box { width = 38px; height = 11px; coverage = opaque; }
    chart neck_guard box { width = 32px; height = 5px; coverage = opaque; }
    chart brim box { width = 32px; height = 3px; coverage = opaque; }
    chart upper_arm_right box { width = 12px; height = 8px; coverage = opaque; }
    chart fore_arm_right box { width = 14px; height = 7px; coverage = opaque; }
    chart hand_arm_right box { width = 12px; height = 6px; coverage = opaque; }
    chart upper_arm_left box { width = 12px; height = 8px; coverage = opaque; }
    chart fore_arm_left box { width = 16px; height = 8px; coverage = opaque; }
    chart hand_arm_left box { width = 12px; height = 6px; coverage = opaque; }
    chart chest_plate box { width = 18px; height = 6px; coverage = opaque; }
    chart back_plate box { width = 18px; height = 7px; coverage = opaque; }
    chart pad_left box { width = 18px; height = 7px; coverage = opaque; }
    chart pad_right box { width = 18px; height = 7px; coverage = opaque; }
    chart shield box { width = 24px; height = 20px; coverage = opaque; }
    chart pistol_grip box { width = 8px; height = 5px; coverage = opaque; }
    chart pistol_slide box { width = 14px; height = 7px; coverage = opaque; }
    chart pistol_muzzle box { width = 4px; height = 2px; coverage = opaque; }
    material = opaque;
  }
}
