ashfox-model 1
asset artillery_blue {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint chassis { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint hull { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint turret { parent = hull; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint barrel { parent = turret; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind chassis { parent-origin = (0u, 2u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind hull { parent-origin = (0u, 3u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind turret { parent-origin = (0u, 2u, 2u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind barrel { parent-origin = (0u, 2.5u, -2u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 1.2s; fps = 20; loop = loop; rest-relative = true;
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (0.6deg, 0deg, 0.4deg) catmullrom;
      key 0.6s = (0deg, 0deg, 0deg) catmullrom;
      key 0.9s = (-0.6deg, 0deg, -0.4deg) catmullrom;
      key 1.2s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion drive for ModelRig {
    duration = 0.4s; fps = 20; loop = loop; rest-relative = true;
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.1s = (-2deg, 0deg, 1deg) catmullrom;
      key 0.2s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (2deg, 0deg, -1deg) catmullrom;
      key 0.4s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion fire for ModelRig {
    duration = 0.5s; fps = 30; loop = once; rest-relative = true;
    track barrel.scale {
      key 0s = (1, 1, 1) linear;
      key 0.05s = (1.15, 1.15, 0.6) linear;
      key 0.4s = (1, 1, 1) linear;
    }
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (5deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 128px; }
    chart track0 box { width = 34px; height = 17px; coverage = opaque; }
    chart track1 box { width = 34px; height = 17px; coverage = opaque; }
    chart hull box { width = 44px; height = 14px; coverage = opaque; }
    chart mount box { width = 24px; height = 9px; coverage = opaque; }
    chart barrel box { width = 28px; height = 14px; coverage = opaque; }
    chart muzzle box { width = 10px; height = 5px; coverage = opaque; }
    chart gunner box { width = 14px; height = 6px; coverage = opaque; }
    chart gunner_head box { width = 16px; height = 8px; coverage = opaque; }
    chart gunner_helmet box { width = 20px; height = 7px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 128px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        wheels13_s = #5a6272;
        wheels13_t = #363d4c;
        sprocket_s = #6a7282;
        team_blue = (#2766c4, #2f74d6, #3d84e2);
        rim_team_blue_6_r = #6fb0f2;
        rim_team_blue_3_r = #6fb0f2;
        rim_team_blue_11_r = #6fb0f2;
        gun = (#2a2e38, #343a46, #3e4554);
        rim_team_blue_4_r = #6fb0f2;
        skin = (#e4b88c, #f1c79b, #f8d4ac);
        eyes_k = #1d2a4a;
        strap5_x = #5a3a22;
        goggles5_b = #5a3a22;
        goggles5_g = #a8dcec;
      }
      stamp wheels13 { pixels = "ttttttttttttt/.ss.ss.ss.ss./.ss.ss.ss.ss./ttttttttttttt"; s = wheels13_s; t = wheels13_t; }
      stamp sprocket { pixels = "ss/ss"; s = sprocket_s; }
      stamp rim_team_blue_6 { pixels = "rrrrrr"; r = rim_team_blue_6_r; }
      stamp rim_team_blue_3 { pixels = "rrr"; r = rim_team_blue_3_r; }
      stamp rim_team_blue_11 { pixels = "rrrrrrrrrrr"; r = rim_team_blue_11_r; }
      stamp rim_team_blue_4 { pixels = "rrrr"; r = rim_team_blue_4_r; }
      stamp eyes { pixels = "k..k/k..k"; k = eyes_k; }
      stamp strap5 { pixels = "xxxxx"; x = strap5_x; }
      stamp goggles5 { pixels = "bgggb"; b = goggles5_b; g = goggles5_g; }
      chart track0 box {
        origin = (0px, 0px); fill = tread;
        face west { stamp wheels13 { at = (0px, 0px); } }
        face north { stamp sprocket { at = (1px, 1px); } }
        face south { stamp sprocket { at = (1px, 1px); } }
      }
      chart track1 box {
        origin = (0px, 18px); fill = tread;
        face east { stamp wheels13 { at = (0px, 0px); } }
        face north { stamp sprocket { at = (1px, 1px); } }
        face south { stamp sprocket { at = (1px, 1px); } }
      }
      chart hull box {
        origin = (0px, 36px); fill = team_blue;
      }
      chart mount box {
        origin = (29px, 51px); fill = team_blue;
        face north { stamp rim_team_blue_6 { at = (0px, 0px); } }
        face south { stamp rim_team_blue_6 { at = (0px, 0px); } }
        face east { stamp rim_team_blue_6 { at = (0px, 0px); } }
        face west { stamp rim_team_blue_6 { at = (0px, 0px); } }
      }
      chart barrel box {
        origin = (0px, 51px); fill = team_blue;
        face north { stamp rim_team_blue_3 { at = (0px, 0px); } }
        face south { stamp rim_team_blue_3 { at = (0px, 0px); } }
        face east { stamp rim_team_blue_11 { at = (0px, 0px); } }
        face west { stamp rim_team_blue_11 { at = (0px, 0px); } }
      }
      chart muzzle box {
        origin = (53px, 66px); fill = gun;
      }
      chart gunner box {
        origin = (38px, 66px); fill = team_blue;
        face north { stamp rim_team_blue_4 { at = (0px, 0px); } }
        face south { stamp rim_team_blue_4 { at = (0px, 0px); } }
        face east { stamp rim_team_blue_3 { at = (0px, 0px); } }
        face west { stamp rim_team_blue_3 { at = (0px, 0px); } }
      }
      chart gunner_head box {
        origin = (0px, 66px); fill = skin;
        face north { stamp eyes { at = (0px, 1px); } }
      }
      chart gunner_helmet box {
        origin = (17px, 66px); fill = team_blue;
        face south { stamp strap5 { at = (0px, 1px); } }
        face east { stamp strap5 { at = (0px, 1px); } }
        face west { stamp strap5 { at = (0px, 1px); } }
        face north { stamp goggles5 { at = (0px, 1px); } }
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone chassis to skeleton.chassis;
    bind bone hull to skeleton.hull;
    bind bone turret to skeleton.turret;
    bind bone barrel to skeleton.barrel;
    geometry {
      bone chassis {
        cube track0 { origin = (-6u, 0u, -6.5u); size = (4u, 4u, 13u); surface = skin.track0; }
        cube track1 { origin = (2u, 0u, -6.5u); size = (4u, 4u, 13u); surface = skin.track1; }
      }
      bone hull {
        cube hull { origin = (-5u, 3u, -6u); size = (10u, 2u, 12u); surface = skin.hull; }
        bone turret {
          cube mount { origin = (-3u, 5u, -1u); size = (6u, 3u, 6u); surface = skin.mount; }
          cube gunner { origin = (-2u, 8u, 2u); size = (4u, 3u, 3u); surface = skin.gunner; }
          cube gunner_head { origin = (-2u, 11u, 1.5u); size = (4u, 4u, 4u); surface = skin.gunner_head; }
          cube gunner_helmet { origin = (-2.5u, 14u, 1u); size = (5u, 2u, 5u); surface = skin.gunner_helmet; }
          bone barrel {
            cube barrel { origin = (-1.5u, 6u, -10u); size = (3u, 3u, 11u); rotation = (40deg, 0deg, 0deg); pivot = (0u, 7.5u, 0u); surface = skin.barrel; }
            cube muzzle { origin = (-2u, 5.5u, -11u); size = (4u, 4u, 1u); rotation = (40deg, 0deg, 0deg); pivot = (0u, 7.5u, 0u); surface = skin.muzzle; }
          }
        }
      }
    }
  }
  export asset artillery_blue {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    motion = drive;
    motion = fire;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
