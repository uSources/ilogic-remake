ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (128px, 256px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        big_wheels_l = #3a4050;
        big_wheels_t = #141824;
        big_wheels_w = #4a5262;
        big_wheels_h = #8a93a6;
        track_end_links_l = #3a4050;
        track_end_links_t = #141824;
        dark_red = (#80181a, #962220, #a82c28);
        rim_dark_red_14_r = #c04a40;
        rim_dark_red_22_r = #c04a40;
        team_red = (#b02824, #c8302a, #d84038);
        artillery_edge_r = #f2786c;
        artillery_edge_d = #80181a;
        lamp = (#e8c020, #f8d838, #fff070);
        canteen = (#4e5a3a, #5c6a44, #6a7a4e);
        ammo_latch_y = #e8c040;
        mount_seams_d = #80181a;
        trunnion_bolt_h = #8a93a6;
        rim_dark_red_6_r = #c04a40;
        rim_dark_red_2_r = #c04a40;
        gun = (#2a2e38, #343a46, #3e4554);
        gun_bore_k = #141824;
        rim_team_red_6_r = #f2786c;
        rim_team_red_4_r = #f2786c;
        skin = (#e4b88c, #f1c79b, #f8d4ac);
        driver_face_k = #1d2a4a;
        driver_face_m = #8a4a3a;
        leather = (#4a2e1a, #5a3a22, #6a4630);
        glass = (#8ad4f4, #9fe3ff, #b8ecff);
        pack = (#6a462a, #7e5432, #8e6040);
        bag_flap_d = #5a3a22;
      }
      stamp big_wheels { pixels = "ltltltltltltltltltltltltlt/........................../..ww...ww...ww...ww...ww../.wwww.wwww.wwww.wwww.wwww./.whhw.whhw.whhw.whhw.whhw./.whhw.whhw.whhw.whhw.whhw./.wwww.wwww.wwww.wwww.wwww./ltltltltltltltltltltltltlt"; l = big_wheels_l; t = big_wheels_t; w = big_wheels_w; h = big_wheels_h; }
      stamp track_end_links { pixels = "lllllll/ttttttt/lllllll/ttttttt/lllllll/ttttttt/lllllll/ttttttt"; l = track_end_links_l; t = track_end_links_t; }
      stamp rim_dark_red_14 { pixels = "rrrrrrrrrrrrrr"; r = rim_dark_red_14_r; }
      stamp rim_dark_red_22 { pixels = "rrrrrrrrrrrrrrrrrrrrrr"; r = rim_dark_red_22_r; }
      stamp artillery_edge { pixels = "rrrrrrrrrrrrrrrrrrrrrrrrrr/........................../dddddddddddddddddddddddddd"; r = artillery_edge_r; d = artillery_edge_d; }
      stamp ammo_latch { pixels = "yy"; y = ammo_latch_y; }
      stamp mount_seams { pixels = "..d...d...d./..d...d...d."; d = mount_seams_d; }
      stamp trunnion_bolt { pixels = ".hh./.hh."; h = trunnion_bolt_h; }
      stamp rim_dark_red_6 { pixels = "rrrrrr"; r = rim_dark_red_6_r; }
      stamp rim_dark_red_2 { pixels = "rr"; r = rim_dark_red_2_r; }
      stamp gun_bore { pixels = ".kk./kkkk/kkkk/.kk."; k = gun_bore_k; }
      stamp rim_team_red_6 { pixels = "rrrrrr"; r = rim_team_red_6_r; }
      stamp rim_team_red_4 { pixels = "rrrr"; r = rim_team_red_4_r; }
      stamp driver_face { pixels = ".kk..kk./.kk..kk./......../...mm..."; k = driver_face_k; m = driver_face_m; }
      stamp bag_flap { pixels = "ddddd"; d = bag_flap_d; }
      chart track0 box { origin = (0px, 0px); fill = tread; face west { stamp big_wheels { at = (0px, 0px); } } face north { stamp track_end_links { at = (0px, 0px); } } face south { stamp track_end_links { at = (0px, 0px); } } }
      chart track1 box { origin = (0px, 35px); fill = tread; face east { stamp big_wheels { at = (0px, 0px); } } face north { stamp track_end_links { at = (0px, 0px); } } face south { stamp track_end_links { at = (0px, 0px); } } }
      chart lower_hull box { origin = (0px, 101px); fill = dark_red; face north { stamp rim_dark_red_14 { at = (0px, 0px); } } face south { stamp rim_dark_red_14 { at = (0px, 0px); } } face east { stamp rim_dark_red_22 { at = (0px, 0px); } } face west { stamp rim_dark_red_22 { at = (0px, 0px); } } }
      chart hull box { origin = (0px, 70px); fill = team_red; face east { stamp artillery_edge { at = (0px, 0px); } } face west { stamp artillery_edge { at = (0px, 0px); } } }
      chart front_plate box { origin = (0px, 158px); fill = dark_red; }
      chart headlight_left box { origin = (59px, 158px); fill = lamp; }
      chart headlight_right box { origin = (68px, 158px); fill = lamp; }
      chart ammo_box box { origin = (54px, 147px); fill = canteen; face east { stamp ammo_latch { at = (2px, 1px); } } }
      chart mount box { origin = (0px, 130px); fill = team_red; face east { stamp mount_seams { at = (0px, 1px); } } face west { stamp mount_seams { at = (0px, 1px); } } }
      chart trunnion box { origin = (0px, 147px); fill = dark_red; face east { stamp trunnion_bolt { at = (1px, 1px); } } face west { stamp trunnion_bolt { at = (1px, 1px); } } }
      chart gun_barrel box { origin = (73px, 101px); fill = team_red; }
      chart gun_band box { origin = (77px, 147px); fill = dark_red; face north { stamp rim_dark_red_6 { at = (0px, 0px); } } face south { stamp rim_dark_red_6 { at = (0px, 0px); } } face east { stamp rim_dark_red_2 { at = (0px, 0px); } } face west { stamp rim_dark_red_2 { at = (0px, 0px); } } }
      chart gun_muzzle box { origin = (94px, 147px); fill = gun; face north { stamp gun_bore { at = (1px, 1px); } } }
      chart gunner_torso box { origin = (33px, 147px); fill = team_red; face north { stamp rim_team_red_6 { at = (0px, 0px); } } face south { stamp rim_team_red_6 { at = (0px, 0px); } } face east { stamp rim_team_red_4 { at = (0px, 0px); } } face west { stamp rim_team_red_4 { at = (0px, 0px); } } }
      chart gunner_head box { origin = (53px, 130px); fill = skin; face north { stamp driver_face { at = (0px, 2px); } } }
      chart gunner_helmet box { origin = (84px, 130px); fill = team_red; }
      chart gunner_goggles box { origin = (77px, 158px); fill = leather; }
      chart gunner_lens_left box { origin = (96px, 158px); fill = glass; }
      chart gunner_lens_right box { origin = (105px, 158px); fill = glass; }
      chart gunner_bag box { origin = (111px, 147px); fill = pack; face south { stamp bag_flap { at = (0px, 0px); } } }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
