ashfox-model 1
asset missile_truck_blue {
  import "./missile_truck_blue/rig.ashfox" as rig;
  import "./missile_truck_blue/paint.ashfox" as paint;
  import "./missile_truck_blue/body.ashfox" as body;
  export asset missile_truck_blue {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;
    motion = rig.idle;
    motion = rig.drive;
    motion = rig.fire;
    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
