ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone chassis to skeleton.chassis;
    bind bone hull to skeleton.hull;
    bind bone turret to skeleton.turret;
    bind bone barrel to skeleton.barrel;
    geometry {
      bone chassis {
        cube track0 { origin = (-15u, 0u, -13u); size = (7u, 8u, 26u); surface = skin.track0; }
        cube track1 { origin = (8u, 0u, -13u); size = (7u, 8u, 26u); surface = skin.track1; }
      }
      bone hull {
        cube lower_hull { origin = (-7u, 2u, -11u); size = (14u, 6u, 22u); surface = skin.lower_hull; }
        cube hull { origin = (-15u, 8u, -13u); size = (30u, 4u, 26u); surface = skin.hull; }
        cube front_plate { origin = (-14u, 9u, -14u); size = (28u, 3u, 1u); surface = skin.front_plate; }
        cube headlight_left { origin = (-13u, 10u, -15u); size = (3u, 2u, 1u); surface = skin.headlight_left; }
        cube headlight_right { origin = (10u, 10u, -15u); size = (3u, 2u, 1u); surface = skin.headlight_right; }
        cube ammo_box { origin = (8u, 12u, 5u); size = (5u, 3u, 6u); surface = skin.ammo_box; }
        bone turret {
          cube mount { origin = (-7u, 12u, -5u); size = (14u, 4u, 12u); surface = skin.mount; }
          cube trunnion { origin = (-5u, 16u, -4u); size = (10u, 4u, 6u); surface = skin.trunnion; }
          cube gunner_torso { origin = (-3u, 12u, 6u); size = (6u, 6u, 4u); surface = skin.gunner_torso; }
          cube gunner_head { origin = (-4u, 18u, 6u); size = (8u, 7u, 7u); surface = skin.gunner_head; }
          cube gunner_helmet { origin = (-5u, 23u, 5u); size = (10u, 4u, 9u); surface = skin.gunner_helmet; }
          cube gunner_goggles { origin = (-4u, 23.5u, 4u); size = (8u, 2u, 1u); surface = skin.gunner_goggles; }
          cube gunner_lens_left { origin = (-3.5u, 24u, 3u); size = (3u, 1u, 1u); surface = skin.gunner_lens_left; }
          cube gunner_lens_right { origin = (0.5u, 24u, 3u); size = (3u, 1u, 1u); surface = skin.gunner_lens_right; }
          cube gunner_bag { origin = (-2.5u, 12.5u, 10u); size = (5u, 5u, 2u); surface = skin.gunner_bag; }
          bone barrel {
            cube gun_barrel { origin = (-2.5u, 15.5u, -21u); size = (5u, 5u, 20u); rotation = (40deg, 0deg, 0deg); pivot = (0u, 18u, -1u); surface = skin.gun_barrel; }
            cube gun_band { origin = (-3u, 15u, -9u); size = (6u, 6u, 2u); rotation = (40deg, 0deg, 0deg); pivot = (0u, 18u, -1u); surface = skin.gun_band; }
            cube gun_muzzle { origin = (-3u, 15u, -23u); size = (6u, 6u, 2u); rotation = (40deg, 0deg, 0deg); pivot = (0u, 18u, -1u); surface = skin.gun_muzzle; }
          }
        }
      }
    }
  }
}
