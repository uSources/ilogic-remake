ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (128px, 256px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        big_wheels_l = #3a4050;
        big_wheels_t = #141824;
        big_wheels_w = #4a5262;
        big_wheels_h = #8a93a6;
        track_end_links_l = #3a4050;
        track_end_links_t = #141824;
        dark_blue = (#1a468e, #1f56a8, #2a64b8);
        rim_dark_blue_14_r = #3f7ccc;
        rim_dark_blue_24_r = #3f7ccc;
        team_blue = (#2766c4, #2f74d6, #3d84e2);
        artillery_edge_r = #6fb0f2;
        artillery_edge_d = #1a468e;
        lamp = (#e8c020, #f8d838, #fff070);
        gun = (#2a2e38, #343a46, #3e4554);
        spade_teeth_k = #6a7282;
        canteen = (#4e5a3a, #5c6a44, #6a7a4e);
        ammo_latch_y = #e8c040;
        rim_team_blue_20_r = #6fb0f2;
        rim_team_blue_18_r = #6fb0f2;
        casemate_door_d = #1a468e;
        casemate_door_h = #8a93a6;
        casemate_vents_k = #141824;
        casemate_handle_h = #8a93a6;
        rim_dark_blue_10_r = #3f7ccc;
        rim_dark_blue_2_r = #3f7ccc;
        gun_bore_k = #141824;
        brake_slots_k = #141824;
      }
      stamp big_wheels { pixels = "ltltltltltltltltltltltltltlt/............................/...ww...ww...ww...ww...ww.../..wwww.wwww.wwww.wwww.wwww../..whhw.whhw.whhw.whhw.whhw../..whhw.whhw.whhw.whhw.whhw../..wwww.wwww.wwww.wwww.wwww../ltltltltltltltltltltltltltlt"; l = big_wheels_l; t = big_wheels_t; w = big_wheels_w; h = big_wheels_h; }
      stamp track_end_links { pixels = "lllllll/ttttttt/lllllll/ttttttt/lllllll/ttttttt/lllllll/ttttttt"; l = track_end_links_l; t = track_end_links_t; }
      stamp rim_dark_blue_14 { pixels = "rrrrrrrrrrrrrr"; r = rim_dark_blue_14_r; }
      stamp rim_dark_blue_24 { pixels = "rrrrrrrrrrrrrrrrrrrrrrrr"; r = rim_dark_blue_24_r; }
      stamp artillery_edge { pixels = "rrrrrrrrrrrrrrrrrrrrrrrrrrrr/............................/dddddddddddddddddddddddddddd"; r = artillery_edge_r; d = artillery_edge_d; }
      stamp spade_teeth { pixels = "k.k.k./....../....../....../....../....../....../k.k.k."; k = spade_teeth_k; }
      stamp ammo_latch { pixels = "yy"; y = ammo_latch_y; }
      stamp rim_team_blue_20 { pixels = "rrrrrrrrrrrrrrrrrrrr"; r = rim_team_blue_20_r; }
      stamp rim_team_blue_18 { pixels = "rrrrrrrrrrrrrrrrrr"; r = rim_team_blue_18_r; }
      stamp casemate_door { pixels = "dddddd/d....d/d....d/d...hd/d....d/d....d/d....d/dddddd"; d = casemate_door_d; h = casemate_door_h; }
      stamp casemate_vents { pixels = "kkkkkkkkkkkk/............/kkkkkkkkkkkk/............/kkkkkkkkkkkk/............/kkkkkkkkkkkk/............"; k = casemate_vents_k; }
      stamp casemate_handle { pixels = "hhh"; h = casemate_handle_h; }
      stamp rim_dark_blue_10 { pixels = "rrrrrrrrrr"; r = rim_dark_blue_10_r; }
      stamp rim_dark_blue_2 { pixels = "rr"; r = rim_dark_blue_2_r; }
      stamp gun_bore { pixels = ".kk./kkkk/kkkk/.kk."; k = gun_bore_k; }
      stamp brake_slots { pixels = "k.k/k.k/k.k"; k = brake_slots_k; }
      chart track0 box { origin = (0px, 0px); fill = tread; face west { stamp big_wheels { at = (0px, 0px); } } face north { stamp track_end_links { at = (0px, 0px); } } face south { stamp track_end_links { at = (0px, 0px); } } }
      chart track1 box { origin = (0px, 37px); fill = tread; face east { stamp big_wheels { at = (0px, 0px); } } face north { stamp track_end_links { at = (0px, 0px); } } face south { stamp track_end_links { at = (0px, 0px); } } }
      chart lower_hull box { origin = (0px, 107px); fill = dark_blue; face north { stamp rim_dark_blue_14 { at = (0px, 0px); } } face south { stamp rim_dark_blue_14 { at = (0px, 0px); } } face east { stamp rim_dark_blue_24 { at = (0px, 0px); } } face west { stamp rim_dark_blue_24 { at = (0px, 0px); } } }
      chart hull box { origin = (0px, 74px); fill = team_blue; face east { stamp artillery_edge { at = (0px, 0px); } } face west { stamp artillery_edge { at = (0px, 0px); } } }
      chart front_plate box { origin = (21px, 206px); fill = dark_blue; }
      chart headlight_left box { origin = (80px, 206px); fill = lamp; }
      chart headlight_right box { origin = (89px, 206px); fill = lamp; }
      chart spade_left box { origin = (46px, 195px); fill = gun; face south { stamp spade_teeth { at = (0px, 0px); } } }
      chart spade_right box { origin = (61px, 195px); fill = gun; face south { stamp spade_teeth { at = (0px, 0px); } } }
      chart ammo_box box { origin = (95px, 195px); fill = canteen; face north { stamp ammo_latch { at = (2px, 1px); } } }
      chart casemate box { origin = (0px, 138px); fill = team_blue; face north { stamp rim_team_blue_20 { at = (0px, 0px); } } face south { stamp rim_team_blue_20 { at = (0px, 0px); } stamp casemate_vents { at = (4px, 2px); } } face east { stamp rim_team_blue_18 { at = (0px, 0px); } stamp casemate_door { at = (7px, 2px); } } face west { stamp rim_team_blue_18 { at = (0px, 0px); } stamp casemate_door { at = (7px, 2px); } } }
      chart casemate_roof box { origin = (53px, 168px); fill = dark_blue; }
      chart casemate_hatch box { origin = (0px, 206px); fill = team_blue; face up { stamp casemate_handle { at = (1px, 2px); } } }
      chart casemate_antenna box { origin = (122px, 168px); fill = gun; }
      chart mantlet box { origin = (0px, 195px); fill = dark_blue; face north { stamp rim_dark_blue_10 { at = (0px, 0px); } } face south { stamp rim_dark_blue_10 { at = (0px, 0px); } } face east { stamp rim_dark_blue_2 { at = (0px, 0px); } } face west { stamp rim_dark_blue_2 { at = (0px, 0px); } } }
      chart gun_barrel box { origin = (0px, 168px); fill = team_blue; }
      chart gun_sleeve box { origin = (25px, 195px); fill = dark_blue; }
      chart gun_brake box { origin = (76px, 195px); fill = gun; face north { stamp gun_bore { at = (1px, 1px); } } face east { stamp brake_slots { at = (0px, 1px); } } face west { stamp brake_slots { at = (0px, 1px); } } }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
