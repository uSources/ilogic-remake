ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 64px); background = boot; background-alpha = 255;
      palette {
        boot = (#3a3430, #4c443c, #5e544a);
        dark_blue = (#1a468e, #1f56a8, #2a64b8);
        rim_dark_blue_2_r = #3f7ccc;
        team_blue = (#2766c4, #2f74d6, #3d84e2);
        rim_team_blue_5_r = #6fb0f2;
        rim_team_blue_3_r = #6fb0f2;
        belt5_x = #5a3a22;
        belt3_x = #5a3a22;
        skin = (#e4b88c, #f1c79b, #f8d4ac);
        eyes_k = #1d2a4a;
        camo_blue = (#2766c4, #2f74d6, #3d84e2);
        camo_blue_spots = (#4a4a2a, #6a6a3a, #8a7a4a);
        strap7_x = #5a3a22;
        goggles7_b = #5a3a22;
        goggles7_g = #a8dcec;
        rim_team_blue_2_r = #6fb0f2;
        hand2_x = #f1c79b;
        hand_s = #f1c79b;
        steel = (#7a8394, #8a93a6, #9aa3b6);
        gun = (#2a2e38, #343a46, #3e4554);
        sandbag = (#c4a670, #d2b47e, #dec28e);
        seams10_d = #a88a5a;
        seams6_d = #a88a5a;
      }
      stamp rim_dark_blue_2 { pixels = "rr"; r = rim_dark_blue_2_r; }
      stamp rim_team_blue_5 { pixels = "rrrrr"; r = rim_team_blue_5_r; }
      stamp rim_team_blue_3 { pixels = "rrr"; r = rim_team_blue_3_r; }
      stamp belt5 { pixels = "xxxxx"; x = belt5_x; }
      stamp belt3 { pixels = "xxx"; x = belt3_x; }
      stamp eyes { pixels = "k..k/k..k"; k = eyes_k; }
      stamp strap7 { pixels = "xxxxxxx"; x = strap7_x; }
      stamp goggles7 { pixels = "bggbggb"; b = goggles7_b; g = goggles7_g; }
      stamp rim_team_blue_2 { pixels = "rr"; r = rim_team_blue_2_r; }
      stamp hand2 { pixels = "xx"; x = hand2_x; }
      stamp hand { pixels = "ss/ss"; s = hand_s; }
      stamp seams10 { pixels = "..d..d..d"; d = seams10_d; }
      stamp seams6 { pixels = "..d.."; d = seams6_d; }
      chart boot_left box { origin = (19px, 26px); fill = boot; }
      chart leg_left box { origin = (41px, 11px); fill = dark_blue; face north { stamp rim_dark_blue_2 { at = (0px, 0px); } } face south { stamp rim_dark_blue_2 { at = (0px, 0px); } } face east { stamp rim_dark_blue_2 { at = (0px, 0px); } } face west { stamp rim_dark_blue_2 { at = (0px, 0px); } } }
      chart boot_right box { origin = (30px, 26px); fill = boot; }
      chart leg_right box { origin = (50px, 11px); fill = dark_blue; face north { stamp rim_dark_blue_2 { at = (0px, 0px); } } face south { stamp rim_dark_blue_2 { at = (0px, 0px); } } face east { stamp rim_dark_blue_2 { at = (0px, 0px); } } face west { stamp rim_dark_blue_2 { at = (0px, 0px); } } }
      chart torso box { origin = (0px, 11px); fill = team_blue; face north { stamp rim_team_blue_5 { at = (0px, 0px); } stamp belt5 { at = (0px, 3px); } } face south { stamp rim_team_blue_5 { at = (0px, 0px); } stamp belt5 { at = (0px, 3px); } } face east { stamp rim_team_blue_3 { at = (0px, 0px); } stamp belt3 { at = (0px, 3px); } } face west { stamp rim_team_blue_3 { at = (0px, 0px); } stamp belt3 { at = (0px, 3px); } } }
      chart head box { origin = (0px, 0px); fill = skin; face north { stamp eyes { at = (1px, 1px); } } }
      chart helmet box { origin = (25px, 0px); fill = camo_blue; pattern blotch { paint = camo_blue_spots; scale = (1px, 1px, 1px); density = 0.5ratio; phase = 7; } face south { stamp strap7 { at = (0px, 1px); } } face east { stamp strap7 { at = (0px, 1px); } } face west { stamp strap7 { at = (0px, 1px); } } face north { stamp goggles7 { at = (0px, 1px); } } }
      chart helmet_top box { origin = (0px, 19px); fill = camo_blue; pattern blotch { paint = camo_blue_spots; scale = (1px, 1px, 1px); density = 0.5ratio; phase = 7; } }
      chart neck_guard box { origin = (0px, 32px); fill = camo_blue; pattern blotch { paint = camo_blue_spots; scale = (1px, 1px, 1px); density = 0.5ratio; phase = 7; } }
      chart arm_left box { origin = (21px, 19px); fill = team_blue; face north { stamp rim_team_blue_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } } face south { stamp rim_team_blue_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } } face east { stamp rim_team_blue_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } } face west { stamp rim_team_blue_2 { at = (0px, 0px); } stamp hand2 { at = (0px, 2px); } } }
      chart arm_right box { origin = (17px, 11px); fill = team_blue; face north { stamp hand { at = (0px, 0px); } } }
      chart base_plate box { origin = (41px, 26px); fill = steel; }
      chart tube box { origin = (32px, 11px); fill = gun; }
      chart sandbags box { origin = (30px, 19px); fill = sandbag; face north { stamp seams10 { at = (0px, 1px); } } }
      chart sandbags_top box { origin = (0px, 26px); fill = sandbag; face north { stamp seams6 { at = (0px, 1px); } } }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
