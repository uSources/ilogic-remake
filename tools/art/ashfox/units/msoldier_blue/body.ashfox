        cube goggles { origin = (-6u, 24u, -8u); size = (12u, 4u, 1u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.goggles; }
        cube lens_left { origin = (-5u, 25u, -9u); size = (4u, 2u, 1u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.lens_left; }
        cube lens_right { origin = (1u, 25u, -9u); size = (4u, 2u, 1u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.lens_right; }
        cube thigh_left { origin = (-4.5u, 7u, -6u); size = (4u, 4u, 6u); rotation = (-18.5deg, 4.5deg, 0deg); pivot = (-2.5u, 9u, 0u); surface = skin.thigh_left; }
        cube shin_left { origin = (-5u, 5u, -12u); size = (4u, 4u, 6u); rotation = (-85deg, 5deg, 0deg); pivot = (-3u, 7u, -6u); surface = skin.shin_left; }
        cube boot_left { origin = (-5.5u, 0u, -10.5u); size = (4u, 3u, 6u); surface = skin.boot_left; }
        cube thigh_right { origin = (0.5u, 7u, -5u); size = (4u, 4u, 6u); rotation = (-135deg, -10deg, 0deg); pivot = (2.5u, 9u, 1u); surface = skin.thigh_right; }
        cube shin_right { origin = (1.5u, 3u, 0u); size = (4u, 4u, 5u); rotation = (-139deg, -5.5deg, 0deg); pivot = (3.5u, 5u, 5u); surface = skin.shin_right; }
        cube boot_right { origin = (2u, 0u, 5u); size = (4u, 3u, 6u); surface = skin.boot_right; }
        cube upper_arm_left { origin = (-8.5u, 14u, -10u); size = (3u, 3u, 8u); rotation = (-26.5deg, -42deg, 0deg); pivot = (-7u, 15.5u, -2u); surface = skin.upper_arm_left; }
        cube forearm_left { origin = (-3.5u, 11.5u, -13u); size = (3u, 3u, 6u); rotation = (40.5deg, -44.5deg, 0deg); pivot = (-2u, 13u, -7u); surface = skin.forearm_left; }
        cube hand_left { origin = (1u, 14.5u, -12u); size = (3u, 3u, 3u); surface = skin.hand_left; }
        cube upper_arm_right { origin = (5.5u, 14u, -8u); size = (3u, 3u, 6u); rotation = (-41deg, -20.5deg, 0deg); pivot = (7u, 15.5u, -2u); surface = skin.upper_arm_right; }
        cube forearm_right { origin = (7.5u, 10.5u, -12u); size = (3u, 3u, 6u); rotation = (41.5deg, 14deg, 0deg); pivot = (9u, 12u, -6u); surface = skin.forearm_right; }
        cube hand_right { origin = (6u, 14.5u, -12u); size = (3u, 3u, 3u); surface = skin.hand_right; }
