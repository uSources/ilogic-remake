        cube shell_tip { origin = (4u, 18.5u, -11.5u); size = (2u, 1u, 2u); surface = skin.shell_tip; }
      }
      bone gear {
        cube mortar_plate { origin = (1u, 0u, -19.5u); size = (8u, 1u, 7u); surface = skin.mortar_plate; }
        cube mortar_tube { origin = (4u, 1u, -17u); size = (2u, 13u, 2u); rotation = (25deg, 0deg, 0deg); pivot = (5u, 1u, -16u); surface = skin.mortar_tube; }
        cube mortar_muzzle { origin = (3.5u, 13u, -17.5u); size = (3u, 1u, 3u); rotation = (25deg, 0deg, 0deg); pivot = (5u, 1u, -16u); surface = skin.mortar_muzzle; }
        cube bipod_clamp { origin = (3u, 7.5u, -13.5u); size = (4u, 2u, 2u); surface = skin.bipod_clamp; }
        cube bipod_leg_left { origin = (4.5u, 8u, -23.5u); size = (1u, 1u, 11u); rotation = (-118deg, 25deg, 0deg); pivot = (5u, 8.5u, -12.5u); surface = skin.bipod_leg_left; }
        cube bipod_leg_right { origin = (4.5u, 8u, -23.5u); size = (1u, 1u, 11u); rotation = (-118deg, -25deg, 0deg); pivot = (5u, 8.5u, -12.5u); surface = skin.bipod_leg_right; }
