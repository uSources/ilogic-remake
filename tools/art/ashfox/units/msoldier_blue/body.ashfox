ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    bind bone gear to skeleton.gear;
    geometry {
      bone body {
        cube torso { origin = (-5u, 9u, -3u); size = (10u, 8u, 6u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.torso; }
        cube buckle { origin = (-1.5u, 9u, -4u); size = (3u, 2u, 1u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.buckle; }
        cube pouch_left { origin = (-4.5u, 9u, -4u); size = (2u, 2u, 1u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.pouch_left; }
        cube pouch_right { origin = (2.5u, 9u, -4u); size = (2u, 2u, 1u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.pouch_right; }
        cube head { origin = (-6u, 17u, -6u); size = (12u, 9u, 11u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.head; }
        cube helmet { origin = (-7u, 23u, -7u); size = (14u, 6u, 13u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.helmet; }
        cube helmet_top { origin = (-5u, 29u, -5u); size = (10u, 2u, 9u); rotation = (-15deg, 0deg, 0deg); pivot = (0u, 9u, 1u); surface = skin.helmet_top; }
