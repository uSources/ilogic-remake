ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 256px); background = boot_grey; background-alpha = 255;
      palette {
        boot_grey = (#7a726a, #8a8279, #9d958d);
        sole4_x = #3a3430;
        sole6_x = #3a3430;
        dark_blue = (#1a468e, #1f56a8, #2a64b8);
        rim_dark_blue_4_r = #3f7ccc;
        knee_k = #1a468e;
        team_blue = (#2766c4, #2f74d6, #3d84e2);
        rim_team_blue_10_r = #6fb0f2;
        rim_team_blue_6_r = #6fb0f2;
        belt10x2_x = #5a3a22;
        belt6x2_x = #5a3a22;
        straps_s = #5a3a22;
        brass = (#c09a30, #d8b040, #ecc858);
        prong_k = #5a3a22;
        pack = (#6a462a, #7e5432, #8e6040);
        skin = (#e4b88c, #f1c79b, #f8d4ac);
        face_k = #1d2a4a;
        face_m = #8a4a3a;
        ear_h = #4a2c1c;
        ear_e = #e0a47e;
        hair_h = #4a2c1c;
        rim_team_blue_14_r = #6fb0f2;
        rim_team_blue_13_r = #6fb0f2;
        helmet_strap13x2_x = #5a3a22;
        leather = (#4a2e1a, #5a3a22, #6a4630);
        glass = (#8ad4f4, #9fe3ff, #b8ecff);
        lens_shine_w = #ffffff;
        gun = (#2a2e38, #343a46, #3e4554);
        receiver_side_s = #6a7282;
        receiver_side_k = #141824;
        steel = (#7a8394, #8a93a6, #9aa3b6);
        pack_strap_d = #5a3a22;
        flap_buckle_y = #e8c040;
        pocket_flap_d = #5a3a22;
        pocket_flap_y = #e8c040;
        canteen = (#4e5a3a, #5c6a44, #6a7a4e);
        canteen_cap_k = #141824;
        pouch_flap_d = #3a2416;
        bedroll = (#5e5a36, #6a6640, #76724a);
        ties_t = #5a3a22;
      }
      stamp sole4 { pixels = "xxxx"; x = sole4_x; }
      stamp sole6 { pixels = "xxxxxx"; x = sole6_x; }
      stamp rim_dark_blue_4 { pixels = "rrrr"; r = rim_dark_blue_4_r; }
      stamp knee { pixels = "kk/kk"; k = knee_k; }
      stamp rim_team_blue_10 { pixels = "rrrrrrrrrr"; r = rim_team_blue_10_r; }
      stamp rim_team_blue_6 { pixels = "rrrrrr"; r = rim_team_blue_6_r; }
      stamp belt10x2 { pixels = "xxxxxxxxxx/xxxxxxxxxx"; x = belt10x2_x; }
      stamp belt6x2 { pixels = "xxxxxx/xxxxxx"; x = belt6x2_x; }
      stamp straps { pixels = "..s....s../..s....s../..s....s../..s....s../..s....s../..s....s.."; s = straps_s; }
      stamp prong { pixels = ".k./.k."; k = prong_k; }
      stamp face { pixels = "............/..kk....kk../..kk....kk../............/....mmmm...."; k = face_k; m = face_m; }
      stamp ear { pixels = "hhhhhhhhhhh/....ee...../....ee....."; h = ear_h; e = ear_e; }
      stamp hair { pixels = "hhhhhhhhhhhh/hhhhhhhhhhhh/hhhhhhhhhhhh"; h = hair_h; }
      stamp rim_team_blue_14 { pixels = "rrrrrrrrrrrrrr"; r = rim_team_blue_14_r; }
      stamp rim_team_blue_13 { pixels = "rrrrrrrrrrrrr"; r = rim_team_blue_13_r; }
      stamp helmet_strap13x2 { pixels = "xxxxxxxxxxxxx/xxxxxxxxxxxxx"; x = helmet_strap13x2_x; }
      stamp lens_shine { pixels = "w"; w = lens_shine_w; }
      stamp receiver_side { pixels = ".ss.k"; s = receiver_side_s; k = receiver_side_k; }
      stamp pack_strap { pixels = "d..d/d..d/d..d/d..d/d..d"; d = pack_strap_d; }
      stamp flap_buckle { pixels = "yy/yy"; y = flap_buckle_y; }
      stamp pocket_flap { pixels = "dddddd/..yy.."; d = pocket_flap_d; y = pocket_flap_y; }
      stamp canteen_cap { pixels = ".k."; k = canteen_cap_k; }
      stamp pouch_flap { pixels = "ddd"; d = pouch_flap_d; }
      stamp ties { pixels = "..t....t../..t....t../..t....t.."; t = ties_t; }
      chart boot_leg_left box { origin = (34px, 68px); fill = boot_grey; face north { stamp sole4 { at = (0px, 2px); } } face south { stamp sole4 { at = (0px, 2px); } } face east { stamp sole6 { at = (0px, 2px); } } face west { stamp sole6 { at = (0px, 2px); } } }
      chart leg_left box { origin = (0px, 68px); fill = dark_blue; face north { stamp rim_dark_blue_4 { at = (0px, 0px); } stamp knee { at = (1px, 2px); } } face south { stamp rim_dark_blue_4 { at = (0px, 0px); } } face east { stamp rim_dark_blue_4 { at = (0px, 0px); } } face west { stamp rim_dark_blue_4 { at = (0px, 0px); } } }
      chart boot_leg_right box { origin = (0px, 79px); fill = boot_grey; face north { stamp sole4 { at = (0px, 2px); } } face south { stamp sole4 { at = (0px, 2px); } } face east { stamp sole6 { at = (0px, 2px); } } face west { stamp sole6 { at = (0px, 2px); } } }
      chart leg_right box { origin = (17px, 68px); fill = dark_blue; face north { stamp rim_dark_blue_4 { at = (0px, 0px); } stamp knee { at = (1px, 2px); } } face south { stamp rim_dark_blue_4 { at = (0px, 0px); } } face east { stamp rim_dark_blue_4 { at = (0px, 0px); } } face west { stamp rim_dark_blue_4 { at = (0px, 0px); } } }
      chart torso box { origin = (0px, 41px); fill = team_blue; face north { stamp rim_team_blue_10 { at = (0px, 0px); } stamp belt10x2 { at = (0px, 6px); } stamp straps { at = (0px, 0px); } } face south { stamp rim_team_blue_10 { at = (0px, 0px); } stamp belt10x2 { at = (0px, 6px); } } face east { stamp rim_team_blue_6 { at = (0px, 0px); } stamp belt6x2 { at = (0px, 6px); } } face west { stamp rim_team_blue_6 { at = (0px, 0px); } stamp belt6x2 { at = (0px, 6px); } } }
      chart buckle box { origin = (0px, 127px); fill = brass; face north { stamp prong { at = (0px, 0px); } } }
      chart pouch_left box { origin = (9px, 127px); fill = pack; }
      chart pouch_right box { origin = (16px, 127px); fill = pack; }
      chart head box { origin = (0px, 0px); fill = skin; face north { stamp face { at = (0px, 3px); } } face east { stamp ear { at = (0px, 3px); } } face west { stamp ear { at = (0px, 3px); } } face south { stamp hair { at = (0px, 3px); } } }
      chart helmet box { origin = (0px, 21px); fill = team_blue; face north { stamp rim_team_blue_14 { at = (0px, 0px); } } face south { stamp rim_team_blue_14 { at = (0px, 0px); } } face east { stamp rim_team_blue_13 { at = (0px, 0px); } stamp helmet_strap13x2 { at = (0px, 2px); } } face west { stamp rim_team_blue_13 { at = (0px, 0px); } stamp helmet_strap13x2 { at = (0px, 2px); } } }
      chart helmet_top box { origin = (0px, 56px); fill = team_blue; }
      chart neck_guard box { origin = (27px, 114px); fill = team_blue; }
      chart goggles box { origin = (0px, 121px); fill = leather; }
      chart lens_left box { origin = (23px, 127px); fill = glass; face north { stamp lens_shine { at = (0px, 0px); } } }
      chart lens_right box { origin = (34px, 127px); fill = glass; face north { stamp lens_shine { at = (0px, 0px); } } }
      chart upper_arm_right box { origin = (0px, 89px); fill = team_blue; }
      chart fore_arm_right box { origin = (13px, 89px); fill = team_blue; }
      chart hand_arm_right box { origin = (0px, 107px); fill = skin; }
      chart upper_arm_left box { origin = (30px, 89px); fill = team_blue; }
      chart fore_arm_left box { origin = (39px, 56px); fill = team_blue; }
      chart hand_arm_left box { origin = (13px, 107px); fill = skin; }
      chart stock box { origin = (31px, 98px); fill = pack; }
      chart receiver box { origin = (21px, 79px); fill = gun; face east { stamp receiver_side { at = (0px, 1px); } } face west { stamp receiver_side { at = (0px, 1px); } } }
      chart magazine box { origin = (26px, 107px); fill = gun; }
      chart sight box { origin = (45px, 127px); fill = steel; }
      chart handguard box { origin = (36px, 79px); fill = pack; }
      chart barrel box { origin = (27px, 121px); fill = steel; }
      chart muzzle box { origin = (53px, 121px); fill = gun; }
      chart backpack box { origin = (33px, 41px); fill = pack; face east { stamp pack_strap { at = (0px, 1px); } } face west { stamp pack_strap { at = (0px, 1px); } } }
      chart pack_flap box { origin = (0px, 98px); fill = leather; face south { stamp flap_buckle { at = (4px, 1px); } } }
      chart pack_pocket box { origin = (38px, 121px); fill = pack; face south { stamp pocket_flap { at = (0px, 0px); } } }
      chart canteen box { origin = (44px, 98px); fill = canteen; face west { stamp canteen_cap { at = (0px, 0px); } } }
      chart side_pouch box { origin = (35px, 107px); fill = leather; face east { stamp pouch_flap { at = (0px, 0px); } } }
      chart bedroll box { origin = (0px, 114px); fill = bedroll; face north { stamp ties { at = (0px, 0px); } } face south { stamp ties { at = (0px, 0px); } } }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
