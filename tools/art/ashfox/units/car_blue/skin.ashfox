ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 64px; height = 64px; }
    chart wheel_front_left box { width = 12px; height = 10px; coverage = opaque; }
    chart wheel_front_left_round box { width = 14px; height = 10px; coverage = opaque; }
    chart wheel_front_right box { width = 12px; height = 10px; coverage = opaque; }
    chart wheel_front_right_round box { width = 14px; height = 10px; coverage = opaque; }
    chart wheel_back_left box { width = 12px; height = 10px; coverage = opaque; }
    chart wheel_back_left_round box { width = 14px; height = 10px; coverage = opaque; }
    chart wheel_back_right box { width = 12px; height = 10px; coverage = opaque; }
    chart wheel_back_right_round box { width = 14px; height = 10px; coverage = opaque; }
    chart body box { width = 44px; height = 16px; coverage = opaque; }
    chart windshield box { width = 18px; height = 3px; coverage = opaque; }
    chart windshield_frame box { width = 20px; height = 2px; coverage = opaque; }
    chart driver_head box { width = 16px; height = 8px; coverage = opaque; }
    chart driver_helmet box { width = 20px; height = 7px; coverage = opaque; }
    chart gun_post box { width = 4px; height = 5px; coverage = opaque; }
    chart gun_body box { width = 10px; height = 5px; coverage = opaque; }
    chart gun box { width = 12px; height = 6px; coverage = opaque; }
    material = opaque;
  }
}
