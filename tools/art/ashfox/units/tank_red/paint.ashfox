ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 128px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        wheels14_s = #5a6272;
        wheels14_t = #363d4c;
        sprocket_s = #6a7282;
        team_red = (#b02824, #c8302a, #d84038);
        rim_team_red_12_r = #f2786c;
        rim_team_red_13_r = #f2786c;
        rim_team_red_8_r = #f2786c;
        rim_team_red_7_r = #f2786c;
        dark_red = (#80181a, #962220, #a82c28);
        steel = (#7a8394, #8a93a6, #9aa3b6);
      }
      stamp wheels14 { pixels = "tttttttttttttt/.ss.ss.ss.ss../.ss.ss.ss.ss../tttttttttttttt"; s = wheels14_s; t = wheels14_t; }
      stamp sprocket { pixels = "ss/ss"; s = sprocket_s; }
      stamp rim_team_red_12 { pixels = "rrrrrrrrrrrr"; r = rim_team_red_12_r; }
      stamp rim_team_red_13 { pixels = "rrrrrrrrrrrrr"; r = rim_team_red_13_r; }
      stamp rim_team_red_8 { pixels = "rrrrrrrr"; r = rim_team_red_8_r; }
      stamp rim_team_red_7 { pixels = "rrrrrrr"; r = rim_team_red_7_r; }
      chart track0 box { origin = (0px, 0px); fill = tread; face west { stamp wheels14 { at = (0px, 0px); } } face north { stamp sprocket { at = (1px, 1px); } } face south { stamp sprocket { at = (1px, 1px); } } }
      chart track1 box { origin = (0px, 19px); fill = tread; face east { stamp wheels14 { at = (0px, 0px); } } face north { stamp sprocket { at = (1px, 1px); } } face south { stamp sprocket { at = (1px, 1px); } } }
      chart hull box { origin = (0px, 38px); fill = team_red; face north { stamp rim_team_red_12 { at = (0px, 0px); } } face south { stamp rim_team_red_12 { at = (0px, 0px); } } face east { stamp rim_team_red_13 { at = (0px, 0px); } } face west { stamp rim_team_red_13 { at = (0px, 0px); } } }
      chart turret box { origin = (0px, 55px); fill = team_red; face north { stamp rim_team_red_8 { at = (0px, 0px); } } face south { stamp rim_team_red_8 { at = (0px, 0px); } } face east { stamp rim_team_red_7 { at = (0px, 0px); } } face west { stamp rim_team_red_7 { at = (0px, 0px); } } }
      chart turret_top box { origin = (19px, 66px); fill = team_red; }
      chart hatch box { origin = (42px, 66px); fill = dark_red; }
      chart mantlet box { origin = (51px, 66px); fill = dark_red; }
      chart barrel_left box { origin = (31px, 55px); fill = steel; }
      chart barrel_right box { origin = (0px, 66px); fill = steel; }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
