ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 32px); background = team_blue; background-alpha = 255;
      palette {
        team_blue = (#2766c4, #2f74d6, #3d84e2);
        rim_team_blue_5_r = #6fb0f2;
        rim_team_blue_12_r = #6fb0f2;
        steel = (#7a8394, #8a93a6, #9aa3b6);
        glass = (#8ad4f4, #9fe3ff, #b8ecff);
        dark_blue = (#1a468e, #1f56a8, #2a64b8);
        rim_dark_blue_1_r = #3f7ccc;
        rim_dark_blue_3_r = #3f7ccc;
        gun = (#2a2e38, #343a46, #3e4554);
      }
      stamp rim_team_blue_5 { pixels = "rrrrr"; r = rim_team_blue_5_r; }
      stamp rim_team_blue_12 { pixels = "rrrrrrrrrrrr"; r = rim_team_blue_12_r; }
      stamp rim_dark_blue_1 { pixels = "r"; r = rim_dark_blue_1_r; }
      stamp rim_dark_blue_3 { pixels = "rrr"; r = rim_dark_blue_3_r; }
      chart fuselage box { origin = (0px, 0px); fill = team_blue; face north { stamp rim_team_blue_5 { at = (0px, 0px); } } face south { stamp rim_team_blue_5 { at = (0px, 0px); } } face east { stamp rim_team_blue_12 { at = (0px, 0px); } } face west { stamp rim_team_blue_12 { at = (0px, 0px); } } }
      chart nose box { origin = (35px, 18px); fill = steel; }
      chart canopy box { origin = (35px, 0px); fill = glass; }
      chart wing box { origin = (0px, 18px); fill = dark_blue; }
      chart tailplane box { origin = (0px, 25px); fill = dark_blue; }
      chart fin box { origin = (52px, 0px); fill = dark_blue; face north { stamp rim_dark_blue_1 { at = (0px, 0px); } } face south { stamp rim_dark_blue_1 { at = (0px, 0px); } } face east { stamp rim_dark_blue_3 { at = (0px, 0px); } } face west { stamp rim_dark_blue_3 { at = (0px, 0px); } } }
      chart nozzle box { origin = (46px, 18px); fill = gun; }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
