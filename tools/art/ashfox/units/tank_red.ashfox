ashfox-model 1
asset tank_red {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint chassis { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint hull { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint turret { parent = hull; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint barrel { parent = turret; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind chassis { parent-origin = (0u, 2u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind hull { parent-origin = (0u, 3u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind turret { parent-origin = (0u, 3u, 0.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind barrel { parent-origin = (0u, 1.5u, -3.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 1.2s; fps = 20; loop = loop; rest-relative = true;
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (0.6deg, 0deg, 0.4deg) catmullrom;
      key 0.6s = (0deg, 0deg, 0deg) catmullrom;
      key 0.9s = (-0.6deg, 0deg, -0.4deg) catmullrom;
      key 1.2s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion drive for ModelRig {
    duration = 0.4s; fps = 20; loop = loop; rest-relative = true;
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.1s = (-2deg, 0deg, 1deg) catmullrom;
      key 0.2s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (2deg, 0deg, -1deg) catmullrom;
      key 0.4s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion fire for ModelRig {
    duration = 0.5s; fps = 30; loop = once; rest-relative = true;
    track barrel.scale {
      key 0s = (1, 1, 1) linear;
      key 0.05s = (1.15, 1.15, 0.6) linear;
      key 0.4s = (1, 1, 1) linear;
    }
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (5deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 128px; }
    chart track0 box { width = 36px; height = 18px; coverage = opaque; }
    chart track1 box { width = 36px; height = 18px; coverage = opaque; }
    chart hull box { width = 50px; height = 16px; coverage = opaque; }
    chart turret box { width = 30px; height = 10px; coverage = opaque; }
    chart turret_top box { width = 22px; height = 6px; coverage = opaque; }
    chart hatch box { width = 8px; height = 3px; coverage = opaque; }
    chart mantlet box { width = 12px; height = 3px; coverage = opaque; }
    chart barrel_left box { width = 18px; height = 9px; coverage = opaque; }
    chart barrel_right box { width = 18px; height = 9px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 128px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        wheels14_s = #5a6272;
        wheels14_t = #363d4c;
        sprocket_s = #6a7282;
        team_red = (#b02824, #c8302a, #d84038);
        rim_team_red_12_r = #f2786c;
        rim_team_red_13_r = #f2786c;
        rim_team_red_8_r = #f2786c;
        rim_team_red_7_r = #f2786c;
        dark_red = (#80181a, #962220, #a82c28);
        steel = (#7a8394, #8a93a6, #9aa3b6);
      }
      stamp wheels14 { pixels = "tttttttttttttt/.ss.ss.ss.ss../.ss.ss.ss.ss../tttttttttttttt"; s = wheels14_s; t = wheels14_t; }
      stamp sprocket { pixels = "ss/ss"; s = sprocket_s; }
      stamp rim_team_red_12 { pixels = "rrrrrrrrrrrr"; r = rim_team_red_12_r; }
      stamp rim_team_red_13 { pixels = "rrrrrrrrrrrrr"; r = rim_team_red_13_r; }
      stamp rim_team_red_8 { pixels = "rrrrrrrr"; r = rim_team_red_8_r; }
      stamp rim_team_red_7 { pixels = "rrrrrrr"; r = rim_team_red_7_r; }
      chart track0 box {
        origin = (0px, 0px); fill = tread;
        face west { stamp wheels14 { at = (0px, 0px); } }
        face north { stamp sprocket { at = (1px, 1px); } }
        face south { stamp sprocket { at = (1px, 1px); } }
      }
      chart track1 box {
        origin = (0px, 19px); fill = tread;
        face east { stamp wheels14 { at = (0px, 0px); } }
        face north { stamp sprocket { at = (1px, 1px); } }
        face south { stamp sprocket { at = (1px, 1px); } }
      }
      chart hull box {
        origin = (0px, 38px); fill = team_red;
        face north { stamp rim_team_red_12 { at = (0px, 0px); } }
        face south { stamp rim_team_red_12 { at = (0px, 0px); } }
        face east { stamp rim_team_red_13 { at = (0px, 0px); } }
        face west { stamp rim_team_red_13 { at = (0px, 0px); } }
      }
      chart turret box {
        origin = (0px, 55px); fill = team_red;
        face north { stamp rim_team_red_8 { at = (0px, 0px); } }
        face south { stamp rim_team_red_8 { at = (0px, 0px); } }
        face east { stamp rim_team_red_7 { at = (0px, 0px); } }
        face west { stamp rim_team_red_7 { at = (0px, 0px); } }
      }
      chart turret_top box {
        origin = (19px, 66px); fill = team_red;
      }
      chart hatch box {
        origin = (42px, 66px); fill = dark_red;
      }
      chart mantlet box {
        origin = (51px, 66px); fill = dark_red;
      }
      chart barrel_left box {
        origin = (31px, 55px); fill = steel;
      }
      chart barrel_right box {
        origin = (0px, 66px); fill = steel;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone chassis to skeleton.chassis;
    bind bone hull to skeleton.hull;
    bind bone turret to skeleton.turret;
    bind bone barrel to skeleton.barrel;
    geometry {
      bone chassis {
        cube track0 { origin = (-7u, 0u, -7u); size = (4u, 4u, 14u); surface = skin.track0; }
        cube track1 { origin = (3u, 0u, -7u); size = (4u, 4u, 14u); surface = skin.track1; }
      }
      bone hull {
        cube hull { origin = (-6u, 3u, -6.5u); size = (12u, 3u, 13u); surface = skin.hull; }
        bone turret {
          cube turret { origin = (-4u, 6u, -3u); size = (8u, 3u, 7u); surface = skin.turret; }
          cube turret_top { origin = (-3u, 9u, -2u); size = (6u, 1u, 5u); surface = skin.turret_top; }
          cube hatch { origin = (-2u, 10u, 0u); size = (2u, 1u, 2u); surface = skin.hatch; }
          cube mantlet { origin = (-2.5u, 6.5u, -4u); size = (5u, 2u, 1u); surface = skin.mantlet; }
          bone barrel {
            cube barrel_left { origin = (-2u, 7u, -11u); size = (1u, 1u, 8u); surface = skin.barrel_left; }
            cube barrel_right { origin = (1u, 7u, -11u); size = (1u, 1u, 8u); surface = skin.barrel_right; }
          }
        }
      }
    }
  }
  export asset tank_red {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    motion = drive;
    motion = fire;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
