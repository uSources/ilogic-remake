ashfox-model 1
asset car_blue {
rig contract ModelRig {
handedness = right;
frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
joint hull { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
joint wheels_front { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
joint wheels_back { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
joint turret { parent = hull; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
joint barrel { parent = turret; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
}
skeleton ModelSkeleton implements ModelRig {
bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
bind hull { parent-origin = (0u, 3u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
bind wheels_front { parent-origin = (0u, 3u, -5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
bind wheels_back { parent-origin = (0u, 3u, 5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
bind turret { parent-origin = (2u, 3u, 3.5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
bind barrel { parent-origin = (0u, 4.5u, -2u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
}
motion idle for ModelRig {
duration = 1.2s; fps = 20; loop = loop; rest-relative = true;
track hull.rotation {
key 0s = (0deg, 0deg, 0deg) catmullrom;
key 0.3s = (0.5deg, 0deg, 0.5deg) catmullrom;
key 0.6s = (0deg, 0deg, 0deg) catmullrom;
key 0.9s = (-0.5deg, 0deg, -0.5deg) catmullrom;
key 1.2s = (0deg, 0deg, 0deg) catmullrom;
}
}
motion drive for ModelRig {
duration = 0.4s; fps = 20; loop = loop; rest-relative = true;
track wheels_front.rotation {
key 0s = (0deg, 0deg, 0deg) step;
key 0.1s = (-22.5deg, 0deg, 0deg) step;
key 0.2s = (-45deg, 0deg, 0deg) step;
key 0.3s = (-67.5deg, 0deg, 0deg) step;
key 0.4s = (0deg, 0deg, 0deg) step;
}
track wheels_back.rotation {
key 0s = (0deg, 0deg, 0deg) step;
key 0.1s = (-22.5deg, 0deg, 0deg) step;
key 0.2s = (-45deg, 0deg, 0deg) step;
key 0.3s = (-67.5deg, 0deg, 0deg) step;
key 0.4s = (0deg, 0deg, 0deg) step;
}
track hull.rotation {
key 0s = (0deg, 0deg, 0deg) linear;
key 0.1s = (-1.5deg, 0deg, 1deg) linear;
key 0.2s = (0deg, 0deg, 0deg) linear;
key 0.3s = (1.5deg, 0deg, -1deg) linear;
key 0.4s = (0deg, 0deg, 0deg) linear;
}
}
motion fire for ModelRig {
duration = 0.4s; fps = 30; loop = once; rest-relative = true;
track turret.rotation {
key 0s = (0deg, 0deg, 0deg) linear;
key 0.06s = (10deg, 0deg, 0deg) linear;
key 0.4s = (0deg, 0deg, 0deg) linear;
}
track hull.rotation {
key 0s = (0deg, 0deg, 0deg) linear;
key 0.06s = (3deg, 0deg, 0deg) linear;
key 0.4s = (0deg, 0deg, 0deg) linear;
}
}
surface contract Skin {
atlas { width = 64px; height = 64px; }
chart wheel_front_left box { width = 12px; height = 10px; coverage = opaque; }
chart wheel_front_left_round box { width = 14px; height = 10px; coverage = opaque; }
chart wheel_front_right box { width = 12px; height = 10px; coverage = opaque; }
chart wheel_front_right_round box { width = 14px; height = 10px; coverage = opaque; }
chart wheel_back_left box { width = 12px; height = 10px; coverage = opaque; }
chart wheel_back_left_round box { width = 14px; height = 10px; coverage = opaque; }
chart wheel_back_right box { width = 12px; height = 10px; coverage = opaque; }
chart wheel_back_right_round box { width = 14px; height = 10px; coverage = opaque; }
chart body box { width = 44px; height = 16px; coverage = opaque; }
chart windshield box { width = 18px; height = 3px; coverage = opaque; }
chart windshield_frame box { width = 20px; height = 2px; coverage = opaque; }
chart driver_head box { width = 16px; height = 8px; coverage = opaque; }
chart driver_helmet box { width = 20px; height = 7px; coverage = opaque; }
chart gun_post box { width = 4px; height = 5px; coverage = opaque; }
chart gun_body box { width = 10px; height = 5px; coverage = opaque; }
chart gun box { width = 12px; height = 6px; coverage = opaque; }
material = opaque;
}
surface paint: Skin {
material = opaque;
texture atlas {
atlas = (64px, 64px); background = tire; background-alpha = 255;
palette {
tire = (#14171e, #1c2029, #252a35);
hub_h = #8a93a6;
team_blue = (#2766c4, #2f74d6, #3d84e2);
rim_team_blue_9_r = #6fb0f2;
rim_team_blue_13_r = #6fb0f2;
glass = (#8ad4f4, #9fe3ff, #b8ecff);
gun = (#2a2e38, #343a46, #3e4554);
skin = (#e4b88c, #f1c79b, #f8d4ac);
eyes_k = #1d2a4a;
strap5_x = #5a3a22;
goggles5_b = #5a3a22;
goggles5_g = #a8dcec;
}
stamp hub { pixels = "hh/hh"; h = hub_h; }
stamp rim_team_blue_9 { pixels = "rrrrrrrrr"; r = rim_team_blue_9_r; }
stamp rim_team_blue_13 { pixels = "rrrrrrrrrrrrr"; r = rim_team_blue_13_r; }
stamp eyes { pixels = "k..k/k..k"; k = eyes_k; }
stamp strap5 { pixels = "xxxxx"; x = strap5_x; }
stamp goggles5 { pixels = "bgggb"; b = goggles5_b; g = goggles5_g; }
chart wheel_front_left box { origin = (45px, 0px); fill = tire; face east { stamp hub { at = (1px, 2px); } } face west { stamp hub { at = (1px, 2px); } } }
chart wheel_front_left_round box { origin = (0px, 17px); fill = tire; }
chart wheel_front_right box { origin = (15px, 17px); fill = tire; face east { stamp hub { at = (1px, 2px); } } face west { stamp hub { at = (1px, 2px); } } }
chart wheel_front_right_round box { origin = (28px, 17px); fill = tire; }
chart wheel_back_left box { origin = (43px, 17px); fill = tire; face east { stamp hub { at = (1px, 2px); } } face west { stamp hub { at = (1px, 2px); } } }
chart wheel_back_left_round box { origin = (0px, 28px); fill = tire; }
chart wheel_back_right box { origin = (15px, 28px); fill = tire; face east { stamp hub { at = (1px, 2px); } } face west { stamp hub { at = (1px, 2px); } } }
chart wheel_back_right_round box { origin = (28px, 28px); fill = tire; }
chart body box { origin = (0px, 0px); fill = team_blue; face north { stamp rim_team_blue_9 { at = (0px, 0px); } } face south { stamp rim_team_blue_9 { at = (0px, 0px); } } face east { stamp rim_team_blue_13 { at = (0px, 0px); } } face west { stamp rim_team_blue_13 { at = (0px, 0px); } } }
chart windshield box { origin = (0px, 47px); fill = glass; }
chart windshield_frame box { origin = (19px, 47px); fill = gun; }
chart driver_head box { origin = (43px, 28px); fill = skin; face north { stamp eyes { at = (0px, 1px); } } }
chart driver_helmet box { origin = (0px, 39px); fill = team_blue; face south { stamp strap5 { at = (0px, 1px); } } face east { stamp strap5 { at = (0px, 1px); } } face west { stamp strap5 { at = (0px, 1px); } } face north { stamp goggles5 { at = (0px, 1px); } } }
chart gun_post box { origin = (34px, 39px); fill = gun; }
chart gun_body box { origin = (39px, 39px); fill = gun; }
chart gun box { origin = (21px, 39px); fill = gun; }
grain clustered { seed = 2013; }
tone voxel;
}
}
component Body {
requires rig skeleton: ModelRig;
requires surface skin: Skin;
bind bone hull to skeleton.hull;
bind bone wheels_front to skeleton.wheels_front;
bind bone wheels_back to skeleton.wheels_back;
bind bone turret to skeleton.turret;
bind bone barrel to skeleton.barrel;
geometry {
bone hull {
cube body { origin = (-4.5u, 3u, -7u); size = (9u, 3u, 13u); surface = skin.body; }
cube windshield { origin = (-4u, 6u, -3u); size = (8u, 2u, 1u); surface = skin.windshield; }
cube windshield_frame { origin = (-4.5u, 8u, -3u); size = (9u, 1u, 1u); surface = skin.windshield_frame; }
cube driver_head { origin = (-3.5u, 6u, -1u); size = (4u, 4u, 4u); surface = skin.driver_head; }
cube driver_helmet { origin = (-4u, 9u, -1.5u); size = (5u, 2u, 5u); surface = skin.driver_helmet; }
bone turret {
cube gun_post { origin = (1.5u, 6u, 3u); size = (1u, 4u, 1u); surface = skin.gun_post; }
bone barrel {
cube gun_body { origin = (1u, 9.5u, 0u); size = (2u, 2u, 3u); surface = skin.gun_body; }
cube gun { origin = (1.5u, 10u, -5u); size = (1u, 1u, 5u); surface = skin.gun; }
}
}
}
bone wheels_front {
cube wheel_front_left { origin = (-6u, 0u, -7u); size = (2u, 6u, 4u); surface = skin.wheel_front_left; }
cube wheel_front_left_round { origin = (-5.5u, 1u, -8u); size = (1u, 4u, 6u); surface = skin.wheel_front_left_round; }
cube wheel_front_right { origin = (4u, 0u, -7u); size = (2u, 6u, 4u); surface = skin.wheel_front_right; }
cube wheel_front_right_round { origin = (4.5u, 1u, -8u); size = (1u, 4u, 6u); surface = skin.wheel_front_right_round; }
}
bone wheels_back {
cube wheel_back_left { origin = (-6u, 0u, 3u); size = (2u, 6u, 4u); surface = skin.wheel_back_left; }
cube wheel_back_left_round { origin = (-5.5u, 1u, 2u); size = (1u, 4u, 6u); surface = skin.wheel_back_left_round; }
cube wheel_back_right { origin = (4u, 0u, 3u); size = (2u, 6u, 4u); surface = skin.wheel_back_right; }
cube wheel_back_right_round { origin = (4.5u, 1u, 2u); size = (1u, 4u, 6u); surface = skin.wheel_back_right_round; }
}
}
}
export asset car_blue {
settings { density = 16; forward = north; }
skeleton = ModelSkeleton;
motion = idle;
motion = drive;
motion = fire;
use Body as model { bind skeleton = ModelRig; bind skin = paint; };
}
}
