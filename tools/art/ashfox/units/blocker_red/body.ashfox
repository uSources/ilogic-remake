ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone chassis to skeleton.chassis;
    bind bone hull to skeleton.hull;
    bind bone turret to skeleton.turret;
    bind bone barrel to skeleton.barrel;
    geometry {
      bone chassis {
        cube track0 { origin = (-7u, 0u, -6.5u); size = (4u, 4u, 13u); surface = skin.track0; }
        cube track1 { origin = (3u, 0u, -6.5u); size = (4u, 4u, 13u); surface = skin.track1; }
      }
      bone hull {
        cube box { origin = (-6u, 3u, -6u); size = (12u, 10u, 12u); surface = skin.box; }
        cube roof { origin = (-5u, 13u, -5u); size = (10u, 1u, 10u); surface = skin.roof; }
        bone turret {
          bone barrel {
          }
        }
      }
    }
  }
}
