ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (128px, 256px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        big_wheels_l = #3a4050;
        big_wheels_t = #141824;
        big_wheels_w = #4a5262;
        big_wheels_h = #8a93a6;
        track_end_links_l = #3a4050;
        track_end_links_t = #141824;
        team_red = (#b02824, #c8302a, #d84038);
        rim_team_red_26_r = #f2786c;
        box_seams_d = #80181a;
        box_seams_r = #80181a;
        rim_team_red_24_r = #f2786c;
        rim_team_red_2_r = #f2786c;
        front_seam_d = #80181a;
        front_seam_r = #80181a;
        dark_red = (#80181a, #962220, #a82c28);
        hatch_handle_h = #8a93a6;
        gun = (#2a2e38, #343a46, #3e4554);
        periscope_glass_g = #9fe3ff;
        rim_dark_red_10_r = #c04a40;
        rim_dark_red_1_r = #c04a40;
        door_handle_h = #8a93a6;
      }
      stamp big_wheels { pixels = "ltltltltltltltltltltltltltlt/............................/...ww...ww...ww...ww...ww.../..wwww.wwww.wwww.wwww.wwww../..whhw.whhw.whhw.whhw.whhw../..whhw.whhw.whhw.whhw.whhw../..wwww.wwww.wwww.wwww.wwww../ltltltltltltltltltltltltltlt"; l = big_wheels_l; t = big_wheels_t; w = big_wheels_w; h = big_wheels_h; }
      stamp track_end_links { pixels = "lllllll/ttttttt/lllllll/ttttttt/lllllll/ttttttt/lllllll/ttttttt"; l = track_end_links_l; t = track_end_links_t; }
      stamp rim_team_red_26 { pixels = "rrrrrrrrrrrrrrrrrrrrrrrrrr"; r = rim_team_red_26_r; }
      stamp box_seams { pixels = "..r...r...r...r...r...r.../............d............./............d............./............d............./............d............./............d............./............d............./............d............./............d............./............d............./............d............./............d............./............d............./............d............./............d............./..r...r...r...r...r...r..."; d = box_seams_d; r = box_seams_r; }
      stamp rim_team_red_24 { pixels = "rrrrrrrrrrrrrrrrrrrrrrrr"; r = rim_team_red_24_r; }
      stamp rim_team_red_2 { pixels = "rr"; r = rim_team_red_2_r; }
      stamp front_seam { pixels = "..r...r...r...r...r...r./...........d............/...........d............/...........d............/...........d............/...........d............/...........d............/...........d............/...........d............/...........d............/...........d............/...........d............/..r...r...r...r...r...r."; d = front_seam_d; r = front_seam_r; }
      stamp hatch_handle { pixels = "hhhh"; h = hatch_handle_h; }
      stamp periscope_glass { pixels = "ggg"; g = periscope_glass_g; }
      stamp rim_dark_red_10 { pixels = "rrrrrrrrrr"; r = rim_dark_red_10_r; }
      stamp rim_dark_red_1 { pixels = "r"; r = rim_dark_red_1_r; }
      stamp door_handle { pixels = "hh"; h = door_handle_h; }
      chart track0 box { origin = (0px, 43px); fill = tread; face west { stamp big_wheels { at = (0px, 0px); } } face north { stamp track_end_links { at = (0px, 0px); } } face south { stamp track_end_links { at = (0px, 0px); } } }
      chart track1 box { origin = (0px, 80px); fill = tread; face east { stamp big_wheels { at = (0px, 0px); } } face north { stamp track_end_links { at = (0px, 0px); } } face south { stamp track_end_links { at = (0px, 0px); } } }
      chart box box { origin = (0px, 0px); fill = team_red; face north { stamp rim_team_red_26 { at = (0px, 0px); } } face south { stamp rim_team_red_26 { at = (0px, 0px); } stamp box_seams { at = (0px, 0px); } } face east { stamp rim_team_red_26 { at = (0px, 0px); } stamp box_seams { at = (0px, 0px); } } face west { stamp rim_team_red_26 { at = (0px, 0px); } stamp box_seams { at = (0px, 0px); } } }
      chart front_plate box { origin = (0px, 140px); fill = team_red; face north { stamp rim_team_red_24 { at = (0px, 0px); } stamp front_seam { at = (0px, 0px); } } face south { stamp rim_team_red_24 { at = (0px, 0px); } } face east { stamp rim_team_red_2 { at = (0px, 0px); } } face west { stamp rim_team_red_2 { at = (0px, 0px); } } }
      chart brow box { origin = (0px, 156px); fill = dark_red; }
      chart vision_slit box { origin = (51px, 156px); fill = tread; }
      chart roof box { origin = (0px, 117px); fill = dark_red; }
      chart hatch box { origin = (76px, 140px); fill = team_red; face up { stamp hatch_handle { at = (2px, 3px); } } }
      chart periscope box { origin = (109px, 140px); fill = gun; face north { stamp periscope_glass { at = (0px, 0px); } } }
      chart back_door box { origin = (53px, 140px); fill = dark_red; face north { stamp rim_dark_red_10 { at = (0px, 0px); } } face south { stamp rim_dark_red_10 { at = (0px, 0px); } stamp door_handle { at = (7px, 5px); } } face east { stamp rim_dark_red_1 { at = (0px, 0px); } } face west { stamp rim_dark_red_1 { at = (0px, 0px); } } }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
