ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 128px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        wheels13_s = #5a6272;
        wheels13_t = #363d4c;
        sprocket_s = #6a7282;
        team_red = (#b02824, #c8302a, #d84038);
        rim_team_red_12_r = #f2786c;
        slot_k = #141824;
        seam_d = #80181a;
        rivets_r = #80181a;
        dark_red = (#80181a, #962220, #a82c28);
      }
      stamp wheels13 { pixels = "ttttttttttttt/.ss.ss.ss.ss./.ss.ss.ss.ss./ttttttttttttt"; s = wheels13_s; t = wheels13_t; }
      stamp sprocket { pixels = "ss/ss"; s = sprocket_s; }
      stamp rim_team_red_12 { pixels = "rrrrrrrrrrrr"; r = rim_team_red_12_r; }
      stamp slot { pixels = "kkkkk"; k = slot_k; }
      stamp seam { pixels = "d/d/d/d/d/d/d/d"; d = seam_d; }
      stamp rivets { pixels = ".r..r..r..r."; r = rivets_r; }
      chart track0 box { origin = (0px, 23px); fill = tread; face west { stamp wheels13 { at = (0px, 0px); } } face north { stamp sprocket { at = (1px, 1px); } } face south { stamp sprocket { at = (1px, 1px); } } }
      chart track1 box { origin = (0px, 41px); fill = tread; face east { stamp wheels13 { at = (0px, 0px); } } face north { stamp sprocket { at = (1px, 1px); } } face south { stamp sprocket { at = (1px, 1px); } } }
      chart box box { origin = (0px, 0px); fill = team_red; face north { stamp rim_team_red_12 { at = (0px, 0px); } stamp slot { at = (5px, 2px); } stamp seam { at = (3px, 1px); } } face south { stamp rim_team_red_12 { at = (0px, 0px); } stamp rivets { at = (0px, 2px); } } face east { stamp rim_team_red_12 { at = (0px, 0px); } stamp rivets { at = (0px, 2px); } } face west { stamp rim_team_red_12 { at = (0px, 0px); } stamp rivets { at = (0px, 2px); } } }
      chart roof box { origin = (0px, 59px); fill = dark_red; }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
