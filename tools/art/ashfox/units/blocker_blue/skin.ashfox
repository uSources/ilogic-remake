    chart roof box { width = 88px; height = 21px; coverage = opaque; }
    chart hatch box { width = 32px; height = 9px; coverage = opaque; }
    chart periscope box { width = 10px; height = 4px; coverage = opaque; }
    chart searchlight box { width = 10px; height = 5px; coverage = opaque; }
    chart plow box { width = 64px; height = 9px; coverage = opaque; }
    chart lower_hull box { width = 76px; height = 30px; coverage = opaque; }
    chart plow_arm_left box { width = 10px; height = 5px; coverage = opaque; }
    chart plow_arm_right box { width = 10px; height = 5px; coverage = opaque; }
    chart headlight_left box { width = 8px; height = 3px; coverage = opaque; }
    chart headlight_right box { width = 8px; height = 3px; coverage = opaque; }
    chart back_door box { width = 22px; height = 16px; coverage = opaque; }
