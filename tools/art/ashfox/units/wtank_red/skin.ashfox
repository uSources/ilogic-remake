ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 128px; height = 256px; }
    chart skirt box { width = 116px; height = 32px; coverage = opaque; }
    chart skirt_top box { width = 108px; height = 27px; coverage = opaque; }
    chart hull box { width = 96px; height = 29px; coverage = opaque; }
    chart headlight_left box { width = 8px; height = 3px; coverage = opaque; }
    chart headlight_right box { width = 8px; height = 3px; coverage = opaque; }
    chart turret box { width = 46px; height = 18px; coverage = opaque; }
    chart turret_top box { width = 38px; height = 10px; coverage = opaque; }
    chart hatch box { width = 20px; height = 6px; coverage = opaque; }
    chart mantlet box { width = 16px; height = 7px; coverage = opaque; }
    chart antenna box { width = 4px; height = 9px; coverage = opaque; }
    chart barrel box { width = 28px; height = 14px; coverage = opaque; }
    chart muzzle box { width = 12px; height = 6px; coverage = opaque; }
    chart fan_housing_top box { width = 44px; height = 6px; coverage = opaque; }
    chart fan_housing_bottom box { width = 44px; height = 6px; coverage = opaque; }
    chart fan_housing_left box { width = 14px; height = 14px; coverage = opaque; }
    chart fan_housing_right box { width = 14px; height = 14px; coverage = opaque; }
    chart fan_corner_top_left box { width = 12px; height = 6px; coverage = opaque; }
    chart fan_corner_top_right box { width = 12px; height = 6px; coverage = opaque; }
    chart fan_corner_bottom_left box { width = 12px; height = 6px; coverage = opaque; }
    chart fan_corner_bottom_right box { width = 12px; height = 6px; coverage = opaque; }
    chart rudder_left box { width = 8px; height = 13px; coverage = opaque; }
    chart rudder_right box { width = 8px; height = 13px; coverage = opaque; }
    chart fan_blade_a box { width = 22px; height = 3px; coverage = opaque; }
    chart fan_blade_b box { width = 6px; height = 11px; coverage = opaque; }
    chart fan_hub box { width = 10px; height = 5px; coverage = opaque; }
    material = opaque;
  }
}
