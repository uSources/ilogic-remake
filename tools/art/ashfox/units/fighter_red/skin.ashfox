ashfox-model 1
module skin {
  export surface contract Skin {
    atlas { width = 128px; height = 64px; }
    chart fuselage box { width = 64px; height = 32px; coverage = opaque; }
    chart nose box { width = 20px; height = 10px; coverage = opaque; }
    chart nose_tip box { width = 10px; height = 5px; coverage = opaque; }
    chart canopy box { width = 26px; height = 11px; coverage = opaque; }
    chart intake_left box { width = 18px; height = 11px; coverage = opaque; }
    chart intake_right box { width = 18px; height = 11px; coverage = opaque; }
    chart wing box { width = 76px; height = 12px; coverage = opaque; }
    chart wingtip_missile_left box { width = 24px; height = 12px; coverage = opaque; }
    chart wingtip_missile_tip_left box { width = 8px; height = 4px; coverage = opaque; }
    chart wingtip_missile_right box { width = 24px; height = 12px; coverage = opaque; }
    chart wingtip_missile_tip_right box { width = 8px; height = 4px; coverage = opaque; }
    chart tailplane box { width = 44px; height = 5px; coverage = opaque; }
    chart fin_left box { width = 12px; height = 12px; coverage = opaque; }
    chart fin_right box { width = 12px; height = 12px; coverage = opaque; }
    chart nozzle box { width = 16px; height = 8px; coverage = opaque; }
    material = opaque;
  }
}
