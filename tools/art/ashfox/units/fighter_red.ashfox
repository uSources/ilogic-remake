ashfox-model 1
asset fighter_red {
  import "./fighter_red/rig.ashfox" as rig;
  import "./fighter_red/paint.ashfox" as paint;
  import "./fighter_red/body.ashfox" as body;
  export asset fighter_red {
    settings { density = 16; forward = north; }
    skeleton = rig.ModelSkeleton;
    motion = rig.idle;
    motion = rig.drive;
    motion = rig.fire;
    use body.Body as model { bind skeleton = rig.ModelRig; bind skin = paint.look; };
  }
}
