ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (128px, 128px); background = team_blue; background-alpha = 255;
      palette {
        team_blue = (#2766c4, #2f74d6, #3d84e2);
        rim_team_blue_12_r = #6fb0f2;
        rim_team_blue_28_r = #6fb0f2;
        bomb_bay_k = #1a468e;
        glass = (#8ad4f4, #9fe3ff, #b8ecff);
        nose_shine_w = #ffffff;
        nose_tip_shine_w = #ffffff;
        gun = (#2a2e38, #343a46, #3e4554);
        dark_blue = (#1a468e, #1f56a8, #2a64b8);
        wing_roundel_left_t = #6fb0f2;
        wing_roundel_left_w = #f2f2ea;
        wing_roundel_left_k = #1a468e;
        wing_roundel_right_t = #6fb0f2;
        wing_roundel_right_w = #f2f2ea;
        wing_roundel_right_k = #1a468e;
        engine_vents_k = #141824;
        warhead = (#c02830, #d8323a, #e8484e);
        steel = (#7a8394, #8a93a6, #9aa3b6);
        rim_dark_blue_1_r = #3f7ccc;
        rim_dark_blue_5_r = #3f7ccc;
      }
      stamp rim_team_blue_12 { pixels = "rrrrrrrrrrrr"; r = rim_team_blue_12_r; }
      stamp rim_team_blue_28 { pixels = "rrrrrrrrrrrrrrrrrrrrrrrrrrrr"; r = rim_team_blue_28_r; }
      stamp bomb_bay { pixels = "kkkkkkkkkk/kkkkkkkkkk/kkkkkkkkkk/kkkkkkkkkk/kkkkkkkkkk/kkkkkkkkkk/kkkkkkkkkk/kkkkkkkkkk/kkkkkkkkkk/kkkkkkkkkk"; k = bomb_bay_k; }
      stamp nose_shine { pixels = "ww../w..."; w = nose_shine_w; }
      stamp nose_tip_shine { pixels = "w."; w = nose_tip_shine_w; }
      stamp wing_roundel_left { pixels = ".ttt./twwwt/twkwt/twwwt/.ttt."; t = wing_roundel_left_t; w = wing_roundel_left_w; k = wing_roundel_left_k; }
      stamp wing_roundel_right { pixels = ".ttt./twwwt/twkwt/twwwt/.ttt."; t = wing_roundel_right_t; w = wing_roundel_right_w; k = wing_roundel_right_k; }
      stamp engine_vents { pixels = "k.k.k.k"; k = engine_vents_k; }
      stamp rim_dark_blue_1 { pixels = "r"; r = rim_dark_blue_1_r; }
      stamp rim_dark_blue_5 { pixels = "rrrrr"; r = rim_dark_blue_5_r; }
      chart fuselage box { origin = (0px, 0px); fill = team_blue; face north { stamp rim_team_blue_12 { at = (0px, 0px); } } face south { stamp rim_team_blue_12 { at = (0px, 0px); } } face east { stamp rim_team_blue_28 { at = (0px, 0px); } } face west { stamp rim_team_blue_28 { at = (0px, 0px); } } face down { stamp bomb_bay { at = (1px, 9px); } } }
      chart glass_nose box { origin = (13px, 72px); fill = glass; face north { stamp nose_shine { at = (1px, 1px); } } }
      chart glass_nose_mid box { origin = (48px, 72px); fill = glass; }
      chart glass_nose_tip box { origin = (44px, 85px); fill = glass; face north { stamp nose_tip_shine { at = (1px, 1px); } } }
      chart cockpit box { origin = (0px, 85px); fill = glass; }
      chart dorsal_turret box { origin = (27px, 85px); fill = glass; }
      chart dorsal_guns box { origin = (114px, 85px); fill = gun; }
      chart wing box { origin = (0px, 57px); fill = dark_blue; face up { stamp wing_roundel_left { at = (2px, 4px); } stamp wing_roundel_right { at = (37px, 4px); } } }
      chart engine_left box { origin = (81px, 0px); fill = gun; face east { stamp engine_vents { at = (1px, 2px); } } face west { stamp engine_vents { at = (1px, 2px); } } }
      chart bomb_left box { origin = (69px, 72px); fill = gun; }
      chart bomb_tip_left box { origin = (0px, 93px); fill = warhead; }
      chart engine_right box { origin = (0px, 40px); fill = gun; face east { stamp engine_vents { at = (1px, 2px); } } face west { stamp engine_vents { at = (1px, 2px); } } }
      chart bomb_right box { origin = (86px, 72px); fill = gun; }
      chart bomb_tip_right box { origin = (9px, 93px); fill = warhead; }
      chart prop_left_a box { origin = (40px, 93px); fill = steel; }
      chart prop_left_b box { origin = (38px, 72px); fill = steel; }
      chart prop_left_spinner box { origin = (18px, 93px); fill = warhead; }
      chart prop_right_a box { origin = (63px, 93px); fill = steel; }
      chart prop_right_b box { origin = (43px, 72px); fill = steel; }
      chart prop_right_spinner box { origin = (29px, 93px); fill = warhead; }
      chart tailplane box { origin = (59px, 85px); fill = dark_blue; }
      chart fin_left box { origin = (113px, 57px); fill = dark_blue; face north { stamp rim_dark_blue_1 { at = (0px, 0px); } } face south { stamp rim_dark_blue_1 { at = (0px, 0px); } } face east { stamp rim_dark_blue_5 { at = (0px, 0px); } } face west { stamp rim_dark_blue_5 { at = (0px, 0px); } } }
      chart fin_right box { origin = (0px, 72px); fill = dark_blue; face north { stamp rim_dark_blue_1 { at = (0px, 0px); } } face south { stamp rim_dark_blue_1 { at = (0px, 0px); } } face east { stamp rim_dark_blue_5 { at = (0px, 0px); } } face west { stamp rim_dark_blue_5 { at = (0px, 0px); } } }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
