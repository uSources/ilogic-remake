ashfox-model 1
module paint {
  import "./skin.ashfox" as skin;
  export surface look: skin.Skin {
    material = opaque;
    texture atlas {
      atlas = (128px, 256px); background = tread; background-alpha = 255;
      palette {
        tread = (#1a1e28, #232836, #2c3242);
        big_wheels_l = #3a4050;
        big_wheels_t = #141824;
        big_wheels_w = #4a5262;
        big_wheels_h = #8a93a6;
        track_end_links_l = #3a4050;
        track_end_links_t = #141824;
        dark_red = (#80181a, #962220, #a82c28);
        rim_dark_red_14_r = #c04a40;
        rim_dark_red_24_r = #c04a40;
        team_red = (#b02824, #c8302a, #d84038);
        fender_edge28_r = #f2786c;
        fender_edge28_d = #80181a;
        fender_edge30_r = #f2786c;
        fender_edge30_d = #80181a;
        lamp = (#e8c020, #f8d838, #fff070);
        grille_g = #141824;
        pack = (#6a462a, #7e5432, #8e6040);
        toolbox_latch_y = #e8c040;
        rim_team_red_16_r = #f2786c;
        antiair_seams_d = #80181a;
        antiair_seams_r = #80181a;
        rim_team_red_14_r = #f2786c;
        rim_team_red_2_r = #f2786c;
        hatch_handle_h = #8a93a6;
        gun = (#2a2e38, #343a46, #3e4554);
        steel = (#7a8394, #8a93a6, #9aa3b6);
        tracking_dish_k = #6a7282;
        tracking_dish_h = #141824;
        radar_grid_k = #6a7282;
        rim_dark_red_5_r = #c04a40;
        rim_dark_red_10_r = #c04a40;
        brake_hole_k = #141824;
      }
      stamp big_wheels { pixels = "ltltltltltltltltltltltltltlt/............................/...ww...ww...ww...ww...ww.../..wwww.wwww.wwww.wwww.wwww../..whhw.whhw.whhw.whhw.whhw../..whhw.whhw.whhw.whhw.whhw../..wwww.wwww.wwww.wwww.wwww../ltltltltltltltltltltltltltlt"; l = big_wheels_l; t = big_wheels_t; w = big_wheels_w; h = big_wheels_h; }
      stamp track_end_links { pixels = "lllllll/ttttttt/lllllll/ttttttt/lllllll/ttttttt/lllllll/ttttttt"; l = track_end_links_l; t = track_end_links_t; }
      stamp rim_dark_red_14 { pixels = "rrrrrrrrrrrrrr"; r = rim_dark_red_14_r; }
      stamp rim_dark_red_24 { pixels = "rrrrrrrrrrrrrrrrrrrrrrrr"; r = rim_dark_red_24_r; }
      stamp fender_edge28 { pixels = "rrrrrrrrrrrrrrrrrrrrrrrrrrrr/............................/dddddddddddddddddddddddddddd"; r = fender_edge28_r; d = fender_edge28_d; }
      stamp fender_edge30 { pixels = "rrrrrrrrrrrrrrrrrrrrrrrrrrrrrr/............................../dddddddddddddddddddddddddddddd"; r = fender_edge30_r; d = fender_edge30_d; }
      stamp grille { pixels = "gggggggggggggggg/................/gggggggggggggggg/................/gggggggggggggggg"; g = grille_g; }
      stamp toolbox_latch { pixels = "yy"; y = toolbox_latch_y; }
      stamp rim_team_red_16 { pixels = "rrrrrrrrrrrrrrrr"; r = rim_team_red_16_r; }
      stamp antiair_seams { pixels = "..r...r...r...r./.......d......../.......d......../.......d......../.......d......../.......d......../.......d......../..r...r...r...r."; d = antiair_seams_d; r = antiair_seams_r; }
      stamp rim_team_red_14 { pixels = "rrrrrrrrrrrrrr"; r = rim_team_red_14_r; }
      stamp rim_team_red_2 { pixels = "rr"; r = rim_team_red_2_r; }
      stamp hatch_handle { pixels = "hhh"; h = hatch_handle_h; }
      stamp tracking_dish { pixels = ".kkkk./kk..kk/k.hh.k/kk..kk/.kkkk."; k = tracking_dish_k; h = tracking_dish_h; }
      stamp radar_grid { pixels = "k.k.k.k./.k.k.k.k/k.k.k.k./.k.k.k.k"; k = radar_grid_k; }
      stamp rim_dark_red_5 { pixels = "rrrrr"; r = rim_dark_red_5_r; }
      stamp rim_dark_red_10 { pixels = "rrrrrrrrrr"; r = rim_dark_red_10_r; }
      stamp brake_hole { pixels = ".k./kkk/.k."; k = brake_hole_k; }
      chart track0 box { origin = (0px, 0px); fill = tread; face west { stamp big_wheels { at = (0px, 0px); } } face north { stamp track_end_links { at = (0px, 0px); } } face south { stamp track_end_links { at = (0px, 0px); } } }
      chart track1 box { origin = (0px, 37px); fill = tread; face east { stamp big_wheels { at = (0px, 0px); } } face north { stamp track_end_links { at = (0px, 0px); } } face south { stamp track_end_links { at = (0px, 0px); } } }
      chart lower_hull box { origin = (0px, 107px); fill = dark_red; face north { stamp rim_dark_red_14 { at = (0px, 0px); } } face south { stamp rim_dark_red_14 { at = (0px, 0px); } } face east { stamp rim_dark_red_24 { at = (0px, 0px); } } face west { stamp rim_dark_red_24 { at = (0px, 0px); } } }
      chart hull box { origin = (0px, 74px); fill = team_red; face east { stamp fender_edge28 { at = (0px, 0px); } } face west { stamp fender_edge28 { at = (0px, 0px); } } face north { stamp fender_edge30 { at = (0px, 0px); } } face south { stamp fender_edge30 { at = (0px, 0px); } } }
      chart front_plate box { origin = (41px, 210px); fill = dark_red; }
      chart headlight_left box { origin = (100px, 210px); fill = lamp; }
      chart headlight_right box { origin = (109px, 210px); fill = lamp; }
      chart engine_deck box { origin = (34px, 201px); fill = dark_red; face up { stamp grille { at = (0px, 0px); } } }
      chart toolbox box { origin = (57px, 185px); fill = pack; face east { stamp toolbox_latch { at = (2px, 1px); } } }
      chart turret box { origin = (0px, 138px); fill = team_red; face north { stamp rim_team_red_16 { at = (0px, 0px); } } face south { stamp rim_team_red_16 { at = (0px, 0px); } } face east { stamp rim_team_red_16 { at = (0px, 0px); } stamp antiair_seams { at = (0px, 0px); } } face west { stamp rim_team_red_16 { at = (0px, 0px); } stamp antiair_seams { at = (0px, 0px); } } }
      chart turret_front box { origin = (82px, 185px); fill = team_red; face north { stamp rim_team_red_14 { at = (0px, 0px); } } face south { stamp rim_team_red_14 { at = (0px, 0px); } } face east { stamp rim_team_red_2 { at = (0px, 0px); } } face west { stamp rim_team_red_2 { at = (0px, 0px); } } }
      chart turret_roof box { origin = (0px, 185px); fill = dark_red; }
      chart turret_hatch box { origin = (77px, 201px); fill = team_red; face up { stamp hatch_handle { at = (1px, 2px); } } }
      chart radar_mast box { origin = (113px, 201px); fill = gun; }
      chart tracking_radar box { origin = (98px, 201px); fill = steel; face north { stamp tracking_dish { at = (0px, 0px); } } }
      chart radar_dish box { origin = (0px, 210px); fill = steel; face north { stamp radar_grid { at = (0px, 0px); } } face south { stamp radar_grid { at = (0px, 0px); } } }
      chart gun_mount_left box { origin = (41px, 164px); fill = dark_red; face north { stamp rim_dark_red_5 { at = (0px, 0px); } } face south { stamp rim_dark_red_5 { at = (0px, 0px); } } face east { stamp rim_dark_red_10 { at = (0px, 0px); } } face west { stamp rim_dark_red_10 { at = (0px, 0px); } } }
      chart gun_left box { origin = (65px, 138px); fill = gun; }
      chart gun_jacket_left box { origin = (0px, 201px); fill = steel; }
      chart gun_brake_left box { origin = (19px, 210px); fill = dark_red; face north { stamp brake_hole { at = (0px, 0px); } } }
      chart gun_mount_right box { origin = (72px, 164px); fill = dark_red; face north { stamp rim_dark_red_5 { at = (0px, 0px); } } face south { stamp rim_dark_red_5 { at = (0px, 0px); } } face east { stamp rim_dark_red_10 { at = (0px, 0px); } } face west { stamp rim_dark_red_10 { at = (0px, 0px); } } }
      chart gun_right box { origin = (0px, 164px); fill = gun; }
      chart gun_jacket_right box { origin = (17px, 201px); fill = steel; }
      chart gun_brake_right box { origin = (30px, 210px); fill = dark_red; face north { stamp brake_hole { at = (0px, 0px); } } }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
}
