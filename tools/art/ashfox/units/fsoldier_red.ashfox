ashfox-model 1
asset fsoldier_red {
  rig contract ModelRig {
    handedness = right;
    frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); }
    joint root { parent = none; role = root; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint hull { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint wheels_front { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint wheels_back { parent = root; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
    joint rider { parent = hull; role = body; frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } channels = (rotation, scale); mirror = none; }
  }
  skeleton ModelSkeleton implements ModelRig {
    bind root { parent-origin = (0u, 0u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind hull { parent-origin = (0u, 3u, 0u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind wheels_front { parent-origin = (0u, 2u, -5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind wheels_back { parent-origin = (0u, 2u, 5u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
    bind rider { parent-origin = (0u, 3u, 1u); frame { x = (1, 0, 0); y = (0, 1, 0); z = (0, 0, 1); } }
  }
  motion idle for ModelRig {
    duration = 1.2s; fps = 20; loop = loop; rest-relative = true;
    track rider.rotation {
      key 0s = (0deg, 0deg, 0deg) catmullrom;
      key 0.3s = (2deg, 0deg, 1deg) catmullrom;
      key 0.6s = (0deg, 0deg, 0deg) catmullrom;
      key 0.9s = (-2deg, 0deg, -1deg) catmullrom;
      key 1.2s = (0deg, 0deg, 0deg) catmullrom;
    }
  }
  motion drive for ModelRig {
    duration = 0.4s; fps = 20; loop = loop; rest-relative = true;
    track wheels_front.rotation {
      key 0s = (0deg, 0deg, 0deg) step;
      key 0.1s = (-22.5deg, 0deg, 0deg) step;
      key 0.2s = (-45deg, 0deg, 0deg) step;
      key 0.3s = (-67.5deg, 0deg, 0deg) step;
      key 0.4s = (0deg, 0deg, 0deg) step;
    }
    track wheels_back.rotation {
      key 0s = (0deg, 0deg, 0deg) step;
      key 0.1s = (-22.5deg, 0deg, 0deg) step;
      key 0.2s = (-45deg, 0deg, 0deg) step;
      key 0.3s = (-67.5deg, 0deg, 0deg) step;
      key 0.4s = (0deg, 0deg, 0deg) step;
    }
    track hull.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.1s = (0deg, 0deg, 3deg) linear;
      key 0.2s = (0deg, 0deg, 0deg) linear;
      key 0.3s = (0deg, 0deg, -3deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  motion fire for ModelRig {
    duration = 0.4s; fps = 30; loop = once; rest-relative = true;
    track rider.rotation {
      key 0s = (0deg, 0deg, 0deg) linear;
      key 0.06s = (8deg, 0deg, 0deg) linear;
      key 0.4s = (0deg, 0deg, 0deg) linear;
    }
  }
  surface contract Skin {
    atlas { width = 64px; height = 32px; }
    chart wheel_front box { width = 12px; height = 8px; coverage = opaque; }
    chart wheel_back box { width = 12px; height = 8px; coverage = opaque; }
    chart frame box { width = 26px; height = 12px; coverage = opaque; }
    chart handlebar box { width = 14px; height = 2px; coverage = opaque; }
    chart rider_body box { width = 16px; height = 7px; coverage = opaque; }
    chart rider_head box { width = 20px; height = 9px; coverage = opaque; }
    chart rider_helmet box { width = 24px; height = 8px; coverage = opaque; }
    chart scarf box { width = 14px; height = 4px; coverage = opaque; }
    material = opaque;
  }
  surface paint: Skin {
    material = opaque;
    texture atlas {
      atlas = (64px, 32px); background = tire; background-alpha = 255;
      palette {
        tire = (#101318, #1e222c, #333a48);
        team_red = (#8a1a1a, #c8302a, #f0605a);
        steel = (#4e5666, #8a93a6, #c3cbd9);
        skin = (#c8946a, #f1c79b, #ffe2c4);
        eyes_k = #141824;
        goggles_g = #9fe3ff;
        scarf = (#c8a010, #f2c81e, #ffe866);
      }
      stamp eyes { pixels = "k..k"; k = eyes_k; }
      stamp goggles { pixels = "gg.gg"; g = goggles_g; }
      chart wheel_front box {
        origin = (48px, 0px); fill = tire;
      }
      chart wheel_back box {
        origin = (0px, 13px); fill = tire;
      }
      chart frame box {
        origin = (0px, 0px); fill = team_red;
      }
      chart handlebar box {
        origin = (15px, 22px); fill = steel;
      }
      chart rider_body box {
        origin = (38px, 13px); fill = team_red;
      }
      chart rider_head box {
        origin = (27px, 0px); fill = skin;
        face north { stamp eyes { at = (1px, 2px); } }
      }
      chart rider_helmet box {
        origin = (13px, 13px); fill = team_red;
        face north { stamp goggles { at = (1px, 0px); } }
      }
      chart scarf box {
        origin = (0px, 22px); fill = scarf;
      }
      grain clustered { seed = 2013; }
      tone voxel;
    }
  }
  component Body {
    requires rig skeleton: ModelRig;
    requires surface skin: Skin;
    bind bone hull to skeleton.hull;
    bind bone wheels_front to skeleton.wheels_front;
    bind bone wheels_back to skeleton.wheels_back;
    bind bone rider to skeleton.rider;
    geometry {
      bone hull {
        cube frame { origin = (-1.5u, 3u, -5u); size = (3u, 2u, 10u); surface = skin.frame; }
        cube handlebar { origin = (-3u, 6u, -5u); size = (6u, 1u, 1u); surface = skin.handlebar; }
        bone rider {
          cube rider_body { origin = (-2.5u, 5u, -1u); size = (5u, 4u, 3u); surface = skin.rider_body; }
          cube rider_head { origin = (-2.5u, 9u, -2u); size = (5u, 4u, 5u); surface = skin.rider_head; }
          cube rider_helmet { origin = (-3u, 12u, -2.5u); size = (6u, 2u, 6u); surface = skin.rider_helmet; }
          cube scarf { origin = (-2u, 8u, 2u); size = (4u, 1u, 3u); surface = skin.scarf; }
        }
      }
      bone wheels_front {
        cube wheel_front { origin = (-1u, 0u, -7u); size = (2u, 4u, 4u); surface = skin.wheel_front; }
      }
      bone wheels_back {
        cube wheel_back { origin = (-1u, 0u, 3u); size = (2u, 4u, 4u); surface = skin.wheel_back; }
      }
    }
  }
  export asset fsoldier_red {
    settings { density = 16; forward = north; }
    skeleton = ModelSkeleton;
    motion = idle;
    motion = drive;
    motion = fire;
    use Body as model { bind skeleton = ModelRig; bind skin = paint; };
  }
}
