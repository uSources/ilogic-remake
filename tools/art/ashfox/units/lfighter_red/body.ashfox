ashfox-model 1
module body {
  import "./rig.ashfox" as rig;
  import "./skin.ashfox" as surfaces;
  export component Body {
    requires rig skeleton: rig.ModelRig;
    requires surface skin: surfaces.Skin;
    bind bone body to skeleton.body;
    bind bone prop to skeleton.prop;
    geometry {
      bone body {
        cube fuselage { origin = (-4u, 20u, -12u); size = (8u, 7u, 22u); surface = skin.fuselage; }
        cube cowl { origin = (-4.5u, 19.5u, -14u); size = (9u, 8u, 2u); surface = skin.cowl; }
        cube tail_cone { origin = (-2.5u, 21u, 10u); size = (5u, 5u, 6u); surface = skin.tail_cone; }
        cube fin { origin = (-0.5u, 26u, 12u); size = (1u, 7u, 5u); surface = skin.fin; }
        cube tailplane { origin = (-7u, 22u, 13u); size = (14u, 1u, 4u); surface = skin.tailplane; }
        cube wing { origin = (-15u, 20u, -7u); size = (30u, 2u, 9u); surface = skin.wing; }
        cube windscreen { origin = (-3u, 27u, -6u); size = (6u, 3u, 1u); surface = skin.windscreen; }
        cube cockpit_rim { origin = (-3.5u, 27u, -5u); size = (7u, 1u, 7u); surface = skin.cockpit_rim; }
        cube pilot_head { origin = (-2.5u, 28u, -4u); size = (5u, 4u, 5u); surface = skin.pilot_head; }
        cube pilot_cap { origin = (-3u, 31u, -4.5u); size = (6u, 2u, 6u); surface = skin.pilot_cap; }
        cube pilot_goggles { origin = (-2.5u, 31u, -5.5u); size = (5u, 1u, 1u); surface = skin.pilot_goggles; }
        cube gear_strut_left { origin = (-6u, 16u, -6u); size = (1u, 4u, 1u); surface = skin.gear_strut_left; }
        cube gear_wheel_left { origin = (-7u, 13u, -7.5u); size = (2u, 4u, 4u); surface = skin.gear_wheel_left; }
        cube gear_strut_right { origin = (5u, 16u, -6u); size = (1u, 4u, 1u); surface = skin.gear_strut_right; }
        cube gear_wheel_right { origin = (5u, 13u, -7.5u); size = (2u, 4u, 4u); surface = skin.gear_wheel_right; }
        bone prop {
          cube prop_hub { origin = (-1.5u, 22u, -15u); size = (3u, 3u, 1u); surface = skin.prop_hub; }
          cube prop_a { origin = (-7u, 23u, -16.5u); size = (14u, 1u, 1u); surface = skin.prop_a; }
          cube prop_b { origin = (-0.5u, 16.5u, -16.5u); size = (1u, 14u, 1u); surface = skin.prop_b; }
          cube prop_spinner { origin = (-1.5u, 22u, -17.5u); size = (3u, 3u, 2u); surface = skin.prop_spinner; }
        }
      }
    }
  }
}
